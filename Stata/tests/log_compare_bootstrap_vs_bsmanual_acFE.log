668. sum L_g_placebo_XX if S_g_XX==0
669. scalar L_placebo_a_XX=r(max)
670. if "`trends_lin'"!=""{
671.         scalar L_placebo_a_XX=L_placebo_a_XX-1
672. }
673. if L_placebo_a_XX==. {
674.     scalar L_placebo_a_XX = 0
675. }
676. }
677. }
