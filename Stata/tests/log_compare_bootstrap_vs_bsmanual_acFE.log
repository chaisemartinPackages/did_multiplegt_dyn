1237.                 local coefs = "`coefs' e(Placebo_`i')"
1238.         }
1239.         }
1240.         
.         if "`trends_lin'"==""{
1241.         local coefs "`coefs' e(Av_tot_effect)"
1242.         }
1243.         
.         xtset, clear // need this to ensure bootstrap is running correctly
1244.         
.         // Save pre-bootstraped coefficients matrix for residualization (controls) and matrix for the actual coefficient matrix to be used
>  in the ereturn post 
.         foreach u of local levels_d_sq_XX {
1245.                 matrix coefs_sq_bs_`u'_XX = coefs_sq_`u'_XX
1246.         }
1247.         matrix didmgt_bs_results_no_avg_XX=didmgt_results_no_avg_XX // Modif Felix
1248.         
.         // Modif Felix: Ensure that we do not add missings in this process
.         gen existing_pre_XX=1
1249.         
.         // Save pre-bootstraped scalars 
.         mata: scalars_XX = st_dir("global", "numscalar", "*_XX")        
1250.         getmata (scalars_XX*) = scalars_XX, force                                       
1251.         // Fix this by counting the number of observations before and after we add all the scalars in and then delete the additional c
> ells we might add!!!                              
.         
.         levelsof(scalars_XX), local(scalars_save)
1252.         foreach w of local scalars_save {
1253.                 local k = subinstr("`w'","_XX","_XY",.)
1254.                 scalar `k' = `w'
1255.         }
1256.         capture drop scalars_XX* 
1257.         
.                 
.         // Modif Felix: Ensure that we do not add missings in this process
.         drop if existing_pre_XX==.
1258.         drop existing_pre_XX
1259.         
.         global bootstrap_on_XX "yes"
1260.         
.         // bootstrap the whole command
.         if "`cluster'"==""{
1261.                 bootstrap "`coefs'", reps(`bootstrap_XX') cluster(`2') `seed_XX': did_multiplegt_dyn `1' `2' `3' `4', effects(`=l_XY')
>  placebo(`=l_placebo_XY') `same_switchers' switchers(`switchers') `only_never_switchers' controls(`controls_bs_orig_XX') trends_nonparam(`
> trends_nonparam') weight(`weight') `dont_drop_larger_lower' `drop_if_d_miss_before_first_switch' `normalized' `same_switchers_pl' `trends_
> lin' continuous(`continuous') graph_off
1262.         }
1263.         else if "`cluster'"!=""{
1264.                 bootstrap "`coefs'", reps(`bootstrap_XX') cluster(`cluster') `seed_XX': did_multiplegt_dyn `1' `2' `3' `4', effects(`=
> l_XY') placebo(`=l_placebo_XY') `same_switchers' switchers(`switchers') `only_never_switchers' controls(`controls_bs_orig_XX') trends_nonp
> aram(`trends_nonparam') weight(`weight') `dont_drop_larger_lower' `normalized' `same_switchers_pl' `drop_if_d_miss_before_first_switch' `t
> rends_lin' continuous(`continuous') graph_off
1265.         }
1266.         
.         //global bootstrap_on_XX ""
.         
.         // store bootstrap results matrix
.         matrix bs_out_XX=r(table)
1267.         matrix bs_var_cov_XX=e(V) // Modif Felix: also fetch var/cov Matrix
1268.         
.         
.         // Restore residualization matrix 
.         foreach u of local levels_d_sq_XX {
1269.                 matrix coefs_sq_`u'_XX = coefs_sq_bs_`u'_XX
1270.         }
1271.         matrix didmgt_results_no_avg_XX=didmgt_bs_results_no_avg_XX // Modif Felix
1272.         
.         // Restore scalars
.         mata: scalars_XY = st_dir("global", "numscalar", "*_XY")
1273.         getmata (scalars_XY*) = scalars_XY, force
1274.         levelsof(scalars_XY), local(scalars_save)
1275.         foreach w of local scalars_save {
1276.                 local k = subinstr("`w'","_XY","_XX",.)
1277.                 scalar `k' = `w'
1278.         }
1279.         capture drop scalars_XY*
1280.         
.         // row 1 to l_XX are the effects 
.         mat se_eff_bs_XX=J(`=l_XX',1,.)
1281.         local j=1 // local to find the correct row in the bootstrap output matrix
1282.         foreach k of numlist `num_eff_XX'{
1283.                 mat se_eff_bs_XX[`k',1]=bs_out_XX[2,`j']
1284.                 local j=`j'+1
1285.         }
1286.         
.         // row l_XX+1 to l_XX+l_placebo_XX are the placebos
.         if l_placebo_XX!=0{
1287.                 mat se_pl_bs_XX=J(`=l_placebo_XX',1,.)
1288.                 local for_count_2_XX=`=l_XX'+`=l_placebo_XX' // Felix: obsolete
1289.                 local for_count_3_XX=`=l_XX'+1 // Felix: obsolete
1290.                 foreach k of numlist `num_pl_XX'{
1291.                         mat se_pl_bs_XX[`k',1]=bs_out_XX[2,`j']
1292.                         local j=`j'+1
1293.                 }
1294.         }
1295.         
.         if "`trends_lin'"==""{
1296.         // row l_XX+l_placebo_XX+1 isvaverage cummulative (total) effect
.         mat se_avg_eff_bs_XX=bs_out_XX[2,`j']
1297.         }
1298.         
.         // Reload results matrix 
.         matrix mat_res_XX=mat_res_bs_XX
1299.         
.         // Reload the "pre-bootstrap" data 
.         use "`data_pre_bootstrap_XX'.dta", clear
1300. }
1301. global bootstrap_on_XX "" // Modif Felix
1302. 
. /////  Computing the variance of DID_\ell
> 
. // Loop over the number of effects to be estimated
. 
. forvalue i=1/`=l_XX'{
1303. 
. // Check that the effect can be estimated       
. 
. if ("`switchers'"==""&(N1_`i'_XX_new!=0|N0_`i'_XX_new!=0))|("`switchers'"=="out"&N0_`i'_XX_new!=0)|("`switchers'"=="in"&N1_`i'_XX_new!=0){
1304. 
. // Aggregating the U_Gg_var_\ell for switchers in and out
. 
. gen U_Gg_var_glob_`i'_XX = U_Gg_var_`i'_in_XX * (scalar(N1_`i'_XX_new)/(scalar(N1_`i'_XX_new)+scalar(N0_`i'_XX_new))) + U_Gg_var_`i'_out_X
> X* (scalar(N0_`i'_XX_new)/(scalar(N1_`i'_XX_new)+scalar(N0_`i'_XX_new)))
1305. 
. // Compute sigma_hat_2_l without clustering
. 
. if "`cluster'"==""{
1306.         gen U_Gg_var_glob_eff`i'_sqrd_XX = U_Gg_var_glob_`i'_XX^2*first_obs_by_gp_XX
1307. 
.         sum U_Gg_var_glob_eff`i'_sqrd_XX
1308.         scalar sum_for_var_`i'_XX=r(sum)/G_XX^2
1309. }
1310. 
. // Compute sigma_hat_2_l with clustering: sum U_Gg_var_l within a cluster, and then take average of square. 
. 
. if "`cluster'"!=""{
1311.         
.         capture drop clust_U_Gg_var_glob_`i'_XX
1312.         capture drop clust_U_Gg_var_glob_`i'_2_XX
1313.         
.         replace U_Gg_var_glob_`i'_XX = U_Gg_var_glob_`i'_XX*first_obs_by_gp_XX
1314.         
.         * Sum within cluster
.         bys `cluster' : gegen clust_U_Gg_var_glob_`i'_XX = total(U_Gg_var_glob_`i'_XX)
1315.         
.         * Compute average of square
.         gen clust_U_Gg_var_glob_`i'_2_XX=clust_U_Gg_var_glob_`i'_XX^2*first_obs_by_clust_XX
1316.         
.         sum clust_U_Gg_var_glob_`i'_2_XX
1317.         scalar sum_for_var_`i'_XX=r(sum)/G_XX^2
1318.         
.         replace U_Gg_var_glob_`i'_XX = clust_U_Gg_var_glob_`i'_XX
1319.         
. }
1320. 
. // Compute SE
. scalar se_`i'_XX = sqrt(sum_for_var_`i'_XX)
1321. 
. // Normalize SE if normalized option was specified
. if "`normalized'"!=""{
1322.         scalar se_`i'_XX = scalar(se_`i'_XX)/scalar(delta_D_`i'_global_XX)
1323. }
1324. 
. // Adapting the se scalars with the bootstrap
. if `bootstrap_XX'!=0{
1325.         scalar se_`i'_XX=se_eff_bs_XX[`i',1]
1326. }
1327. 
. // Storing the results
. 
. * SE
. matrix mat_res_XX[`i',2]=scalar(se_`i'_XX)
1328. ereturn scalar se_effect_`i'=scalar(se_`i'_XX)
1329. 
. * ci_level
. scalar ci_level = `ci_level'/100
1330. scalar z_level = invnormal(scalar(ci_level) + (1-scalar(ci_level))/2)
1331.         
. * Lower bound of the confidence interval
. scalar LB_CI_`i'_XX = scalar(DID_`i'_XX) - scalar(z_level)*scalar(se_`i'_XX)
1332. matrix mat_res_XX[`i',3]= scalar(LB_CI_`i'_XX)
1333. 
. * Upper bound of the confidence interval
. scalar UB_CI_`i'_XX = scalar(DID_`i'_XX) + scalar(z_level)*scalar(se_`i'_XX)
1334. matrix mat_res_XX[`i',4]=scalar(UB_CI_`i'_XX)
1335. 
. }
1336. }
1337. 
. 
. /////  Computing the variances of the placebo estimators (same steps as for the DID_\ell, not commented)
> 
. if l_placebo_XX!=0{
1338. 
. forvalue i=1/`=l_placebo_XX'{
1339. if ("`switchers'"==""&(N1_placebo_`i'_XX_new!=0|N0_placebo_`i'_XX_new!=0))|("`switchers'"=="out"&N0_placebo_`i'_XX_new!=0)|("`switcher
> s'"=="in"&N1_placebo_`i'_XX_new!=0){ 
1340. 
. gen U_Gg_var_glob_pl_`i'_XX = U_Gg_var_pl_`i'_in_XX * (N1_placebo_`i'_XX_new/(N1_placebo_`i'_XX_new+N0_placebo_`i'_XX_new)) + U_Gg_var_pl_
> `i'_out_XX* (N0_placebo_`i'_XX_new/(N1_placebo_`i'_XX_new+N0_placebo_`i'_XX_new))
1341. 
. if "`cluster'"==""{
1342. 
. gen U_Gg_var_glob_pl_`i'_2_XX = U_Gg_var_glob_pl_`i'_XX^2*first_obs_by_gp_XX
1343. 
. sum U_Gg_var_glob_pl_`i'_2_XX
1344. scalar sum_for_var_placebo_`i'_XX=r(sum)/G_XX^2
1345. }
1346. 
. if "`cluster'"!=""{
1347.         capture drop clust_U_Gg_var_glob_pl_`i'_XX
1348.         capture drop clust_U_Gg_var_glob_pl_`i'_2_XX
1349.         
.         replace U_Gg_var_glob_pl_`i'_XX = U_Gg_var_glob_pl_`i'_XX*first_obs_by_gp_XX
1350. 
.         bys `cluster' : gegen clust_U_Gg_var_glob_pl_`i'_XX= total(U_Gg_var_glob_pl_`i'_XX)
1351. 
.         gen clust_U_Gg_var_glob_pl_`i'_2_XX=clust_U_Gg_var_glob_pl_`i'_XX^2*first_obs_by_clust_XX
1352.         
.         sum clust_U_Gg_var_glob_pl_`i'_2_XX
1353.         scalar sum_for_var_placebo_`i'_XX=r(sum)/G_XX^2
1354.         
.         replace U_Gg_var_glob_pl_`i'_XX = clust_U_Gg_var_glob_pl_`i'_XX  
1355. }
1356. 
. scalar se_placebo_`i'_XX = sqrt(sum_for_var_placebo_`i'_XX)
1357. 
. if "`normalized'"!=""{
1358.         scalar se_placebo_`i'_XX = scalar(se_placebo_`i'_XX)/scalar(delta_D_pl_`i'_global_XX)
1359. }
1360. 
. // Adapting the se scalars with the bootstrap
. if `bootstrap_XX'!=0{
1361.         scalar se_placebo_`i'_XX=se_pl_bs_XX[`i',1]
1362. }
1363. 
. matrix mat_res_XX[`=l_XX' + 1 + `i',2]=scalar(se_placebo_`i'_XX)
1364. ereturn scalar se_placebo_`i'=scalar(se_placebo_`i'_XX)
1365.         
. scalar LB_CI_placebo_`i'_XX = scalar(DID_placebo_`i'_XX) - scalar(z_level)*scalar(se_placebo_`i'_XX)
1366. matrix mat_res_XX[`=l_XX'+ 1 + `i', 3]= scalar(LB_CI_placebo_`i'_XX)
1367. 
. scalar UB_CI_placebo_`i'_XX = scalar(DID_placebo_`i'_XX) + scalar(z_level)*scalar(se_placebo_`i'_XX)
1368. matrix mat_res_XX[`=l_XX'+ 1 + `i',4]=scalar(UB_CI_placebo_`i'_XX)
1369. 
. }
1370. }
1371. }
1372. 
. /////  Computing the variance of the average total effect (same steps as for the DID_\ell, not commented)
> 
. if "`trends_lin'"==""{
1373. 
. if ("`switchers'"==""&(sum_N1_l_XX!=0|sum_N0_l_XX!=0))|("`switchers'"=="out"&sum_N0_l_XX!=0)|("`switchers'"=="in"&sum_N1_l_XX!=0){
1374. 
. gen U_Gg_var_global_XX = w_plus_XX * U_Gg_var_plus_XX + (1 - w_plus_XX) * U_Gg_var_minus_XX
1375. 
. if "`cluster'"==""{
1376. capture drop U_Gg_var_global_2_XX
1377. gen U_Gg_var_global_2_XX = U_Gg_var_global_XX^2*first_obs_by_gp_XX
1378. 
. sum U_Gg_var_global_2_XX
1379. scalar sum_for_var_XX=r(sum)/G_XX^2
1380. }
1381. 
. if "`cluster'"!=""{
1382.         capture drop clust_U_Gg_var_global_XX
1383.         
.         replace U_Gg_var_global_XX=U_Gg_var_global_XX*first_obs_by_gp_XX
1384.         
.         bys `cluster' : gegen clust_U_Gg_var_global_XX= total(U_Gg_var_global_XX)
1385.         
.         replace clust_U_Gg_var_global_XX=clust_U_Gg_var_global_XX^2*first_obs_by_clust_XX
1386.         
.         sum clust_U_Gg_var_global_XX
1387.         scalar sum_for_var_XX=r(sum)/G_XX^2
1388. }
1389. 
. scalar se_XX = sqrt(sum_for_var_XX)
1390. 
. // Adapting the se scalars with the bootstrap
. if `bootstrap_XX'!=0{
1391.         scalar se_XX=se_avg_eff_bs_XX[1,1]
1392. }
1393. 
. matrix mat_res_XX[l_XX+1,2]=se_XX
1394. ereturn scalar se_avg_total_effect = se_XX
1395. 
. scalar LB_CI_XX = delta_XX - scalar(z_level)*se_XX
1396. matrix mat_res_XX[l_XX+1,3]= LB_CI_XX
1397. 
. scalar UB_CI_XX = delta_XX + scalar(z_level)*se_XX
1398. matrix mat_res_XX[l_XX+1,4]= UB_CI_XX
1399. 
. }
1400. }
1401. 
. ///// Storing results in a way ensuring that command compatible with "event_plot" command 
> 
. // Extract Estimates
. 
. matrix didmgt_b2=mat_res_XX[1...,1..1]
1402. 
. // Extract Variances
. 
. matrix didmgt_var2=J(`=l_placebo_XX'+`=l_XX'+1,1,0)
1403. forvalue i=1/`=`=l_placebo_XX'+`=l_XX'+1'{
1404. matrix didmgt_var2[`i',1]=mat_res_XX[`i',2]^2
1405. }
1406. 
. // Add reference period
. 
. local rownames2 "`rownames' Effect_0"
1407. matrix zero=J(1,1,0)
1408. matrix didmgt_b2=didmgt_b2\zero
1409. matrix didmgt_var2=didmgt_var2\zero
1410. 
. // Add correct names
. 
. matrix rownames didmgt_var2= `rownames2'
1411. matrix rownames didmgt_b2 = `rownames2'
1412. 
. // For compatibility with old do files:
. 
. matrix compatibility_variances = didmgt_var2
1413. 
. // Set up the output to match event_plot
. /*
> ereturn matrix estimates=didmgt_b2 
> ereturn matrix didmgt_variances=didmgt_var2
> ereturn matrix variances= compatibility_variances
> ereturn local cmd "did_multiplegt_dyn"
> */
. 
. 
. ////////// 6. Computing p-values from the tests 
> 
. //// Generate combined Variance-Covariance Matrix for honestdid
> // Note: Check if all of them are defined!
. // If test is feasible, initalize scalar at 0
.                 scalar all_Ns_pl_not_zero=0
1414.                 scalar all_delta_pl_not_zero=0
1415.                 
.                 // Count the number of placebos that can be estimated
.                 forvalue i=1/`=l_placebo_XX'{
1416.                 if ("`switchers'"==""&(N1_placebo_`i'_XX_new!=0|N0_placebo_`i'_XX_new!=0))|("`switchers'"=="out"&N0_placebo_`i'_XX_new
> !=0)|("`switchers'"=="in"&N1_placebo_`i'_XX_new!=0){
1417.                         scalar all_Ns_pl_not_zero=all_Ns_pl_not_zero+1
1418.                         
.                 }
1419.                 // Count the number of normalized placebos that can be estimated
.                 if "`normalized'"!=""{
1420.                 if (delta_D_pl_`i'_global_XX!=0 & delta_D_pl_`i'_global_XX!=.){
1421.                         scalar all_delta_pl_not_zero=all_delta_pl_not_zero+1
1422.                 }
1423.                 }
1424.                 }
1425.                 
.                 scalar all_Ns_not_zero=0
1426.         
.                 forvalue i=1/`=l_XX'{
1427.                 if ("`switchers'"==""&(N1_`i'_XX_new!=0|N0_`i'_XX_new!=0))|("`switchers'"=="out"&N0_`i'_XX_new!=0)|("`switchers'"=="in
> "&N1_`i'_XX_new!=0){
1428.                         scalar all_Ns_not_zero=all_Ns_not_zero+1
1429.                         }
1430.         }
1431.                 
. if ((all_Ns_pl_not_zero==l_placebo_XX & "`normalized'"=="")|(all_Ns_pl_not_zero==l_placebo_XX & "`normalized'"!="" & all_delta_pl_not_zero
> ==l_placebo_XX))&all_Ns_not_zero==l_XX{               
1432. 
. // Creating a matrix where the variances and the covariances will be stored.
. matrix didmgt_Var_all_XX=J(`=l_XX'+`=l_placebo_XX',`=l_XX'+`=l_placebo_XX',0)
1433. 
. local total_num_estimates_XX=`=l_XX'+`=l_placebo_XX'
1434. 
. // combine effects and placebos in "one" variable with running index (similarly for scalars storing the se's)
. capture drop U_Gg_var_comb_*_XX
1435. forvalue i=1/`=l_XX'{
1436.         gen U_Gg_var_comb_`i'_XX=U_Gg_var_glob_`i'_XX
1437.         scalar se_all_`i'_XX=se_`i'_XX
1438.         if "`normalized'"!=""{
1439.                 scalar delta_D_all_`i'_XX=delta_D_`i'_global_XX
1440.         }
1441. }
1442. forvalue i=`=l_XX+1'/`total_num_estimates_XX'{
1443.         local j=`i'-`=l_XX'
1444.         gen U_Gg_var_comb_`i'_XX=U_Gg_var_glob_pl_`j'_XX
1445.         scalar se_all_`i'_XX=se_placebo_`j'_XX
1446.         if "`normalized'"!=""{
1447.                 scalar delta_D_all_`i'_XX=delta_D_pl_`j'_global_XX
1448.         }
1449. }
1450. 
. 
. // If the option cluster is specified, we have previously replaced U_Gg_var_glob_pl_`i'_XX by clust_U_Gg_var_glob_pl_`i'_XX, and U_Gg_var_
> glob_`i'_XX by clust_U_Gg_var_glob_`i'_XX. 
. // Now, we must also replace first_obs_by_gp_XX by first_obs_by_clust_XX
. if "`cluster'"!=""{
1451. replace first_obs_by_gp_XX=first_obs_by_clust_XX
1452. }
1453. 
. forvalue i=1/`total_num_estimates_XX'{
1454.                 
.                 // Fill the diagonal with the Variances
.                 matrix didmgt_Var_all_XX[`i',`i']= scalar(se_all_`i'_XX)^2
1455.         
.                 // Fill off diagonal with covariances
.                 if `i'<`total_num_estimates_XX'{
1456.                 forvalue j=`=`i'+1'/`total_num_estimates_XX'{
1457.                         
.                         * Create variables necessary to compute the covariances
.                         capture drop U_Gg_var_comb_`i'_`j'_XX
1458.                         capture drop U_Gg_var_comb_`i'_`j'_2_XX
1459.                                         
.                         if ("`normalized'"==""){
1460.                         gen U_Gg_var_comb_`i'_`j'_XX = U_Gg_var_comb_`i'_XX + U_Gg_var_comb_`j'_XX
1461.                 }
1462.                         
.                         // Also need adjusted delta_D for all effects!!!
.                         if "`normalized'"!=""{
1463.                         gen U_Gg_var_comb_`i'_`j'_XX = U_Gg_var_comb_`i'_XX/scalar(delta_D_all_`i'_XX) + U_Gg_var_comb_`j'_XX/scalar(d
> elta_D_all_`j'_XX)
1464.                 }
1465. 
.                         * Estimate the covariances
.                         gen U_Gg_var_comb_`i'_`j'_2_XX = U_Gg_var_comb_`i'_`j'_XX^2*first_obs_by_gp_XX
1466.                         
.                         
.                         sum U_Gg_var_comb_`i'_`j'_2_XX
1467.                         scalar var_sum_comb_`i'_`j'_XX=r(sum)/G_XX^2
1468.                         
.                         scalar cov_comb_`i'_`j'_XX = (scalar(var_sum_comb_`i'_`j'_XX) - scalar(se_all_`i'_XX)^2 - scalar(se_all_`j'_XX)^2)
> /2
1469.         
.                         * Store the results
.                         matrix didmgt_Var_all_XX[`i',`j']= scalar(cov_comb_`i'_`j'_XX)
1470.                         matrix didmgt_Var_all_XX[`j',`i']= scalar(cov_comb_`i'_`j'_XX)
1471. 
.                 }
1472.         }
1473.         
. }
1474. 
. *** Modif Felix: replace by bootstrap var/cov matrix
. if `bootstrap_XX'!=0{
1475.         matrix didmgt_Var_all_XX=bs_var_cov_XX
1476. }
1477. 
. }
1478.         // Error message if not all of the specified effects/placebos could be estimated 
.         else{
1479.                 di as error ""
1480.                 di as error "Some placebos/effects could not be estimated. Therefore, the command will not be compatible with the hone
> stdid command."
1481.                 di as input _continue ""
1482.         }
1483. 
. ///// Performing a test that all placebo are jointly equal to 0.
> 
. // initalize scalar
. scalar all_Ns_pl_not_zero=.
1484. scalar all_delta_pl_not_zero=.
1485. 
. // Test can only be run when at least two placebos requested:
. if (l_placebo_XX!=0)&l_placebo_XX>1{
1486. 
.                 // If test is feasible, initalize scalar at 0
.                 scalar all_Ns_pl_not_zero=0
1487.                 scalar all_delta_pl_not_zero=0
1488.                 
.                 // Count the number of placebos that can be estimated
.                 forvalue i=1/`=l_placebo_XX'{
1489.                 if ("`switchers'"==""&(N1_placebo_`i'_XX_new!=0|N0_placebo_`i'_XX_new!=0))|("`switchers'"=="out"&N0_placebo_`i'_XX_new
> !=0)|("`switchers'"=="in"&N1_placebo_`i'_XX_new!=0){
1490.                         scalar all_Ns_pl_not_zero=all_Ns_pl_not_zero+1
1491.                         
.                 }
1492.                 // Count the number of normalized placebos that can be estimated
.                 if "`normalized'"!=""{
1493.                 if (delta_D_pl_`i'_global_XX!=0 & delta_D_pl_`i'_global_XX!=.){
