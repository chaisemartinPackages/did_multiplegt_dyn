. ///// save_sample option that allows to see which groups were included in the estimation and if they were switcher in/out ot control
> 
. if "`save_sample'" != "" {
2502.         qui {
2503.                 // keeping only group, time and switcher status (if not missing)
.                 keep if !missing(`2') & !missing(`3') 
2504.                 keep `2' `3' S_g_XX switcher_tag_XX
2505.                 
.                 if "`by'"==""{
2506.                         
.                 // redefine S_g_XX to show if group is switcher in/out or control       
.                 rename S_g_XX _did_sample
2507.                 rename switcher_tag_XX _effect
2508.                 replace _did_sample = -1 if _did_sample == 0
2509.                 replace _did_sample = 0 if _did_sample == .
2510.                 cap label drop switch_lab_XX 
2511.                 label define switch_lab_XX 0 "Never-switcher" 1 "Switcher-in" -1 "Switcher-out"
2512.                 label values _did_sample switch_lab_XX
2513.                 
.                 // Save dataset to be in the memory at the end
.                 tempfile did_sample
2514.                 save `did_sample', replace
2515.                 }
2516.                 
.                 // Same procedure, but with by we get multiple samples
.                 else if "`by'"!=""{
2517.                         
.                 // redefine S_g_XX to show if group is switcher in/out or control       
.                 rename S_g_XX _did_sample_`l_by'
2518.                 rename switcher_tag_XX _effect_`l_by'
2519.                 replace _did_sample_`l_by' = -1 if _did_sample_`l_by' == 0
2520.                 replace _did_sample_`l_by' = 0 if _did_sample_`l_by' == .
2521.                 cap label drop switch_lab_XX 
2522.                 label define switch_lab_XX 0 "Never-switcher" 1 "Switcher-in" -1 "Switcher-out"
2523.                 label values _did_sample_`l_by' switch_lab_XX
2524.                 
.                 // Save dataset to be in the memory at the end
.                 tempfile did_sample_`l_by'
2525.                 save `did_sample_`l_by'', replace
2526.                 }
2527.         }
2528. }
2529. 
. ///// design option which shows the different treatment paths that switcher groups follow
> 
. if "`design'" != "" {   
2530.         qui {
2531.         
.         // Releaod the data before it was changed in save_sample
.         use `data_predesign', clear
2532.         
.         // Error message if the arguments in the option were specified wrong
.         if strpos("`design'", ",") == 0 {
2533.                 di as error ""
2534.                 di as error "Syntax error in design option"
2535.                 di as error "Comma required"
2536.                 di as input _continue ""
2537.                 
.                 exit
2538.         }
2539.         
.         // Fetch the arguments 
.         local des_p = strtrim(substr("`design'", 1, strpos("`design'", ",") - 1))
2540.         local des_path = strtrim(substr("`design'", strpos("`design'", ",") + 1, .))
2541.         local des_n = l_XX 
2542.         
.         // When no percentage value is specified (for how many paths should be shown) it is set to a default of 100%
.         if missing("`des_p'") {
2543.                 local des_p = 1
2544.         }
2545.         local des_per = `des_p' * 100
2546.         local des_per : di %9.2fc `des_per'
2547.         
.         // keep periods up to ℓ periods after the first switch
.         gen F_g_plus_n_XX = F_g_XX + `des_n' - 1
2548.         keep if time_XX >= F_g_XX - 1 & time_XX <= F_g_plus_n_XX
2549.         sort group_XX time_XX
2550.         bys group_XX : gen time_l_XX = _n
2551. 
.         // Aggregate weights by group 
.         keep group_XX time_l_XX weight_XX treatment_XX F_g_XX
2552.         {
2553.                 if "`weight'" != "" {
2554.                         gegen g_weight_XX = sum(weight_XX), by(group_XX)
2555.                 }
2556.                 else {
2557.                         gen g_weight_XX = 1
2558.                 }
2559.         }
2560.         drop weight_XX
2561.         // Reshape wide to represent the treatment path by time
.         greshape wide treatment_XX, i(group_XX g_weight_XX F_g_XX) j(time_l_XX)
2562.         
.         // Drop missing treatments 
.         foreach v of varlist treatment_XX* {
2563.                 drop if `v' == .
2564.         }
2565.         
.         // Remove non switchers 
.         count if F_g_XX > T_max_XX
2566.         local non_switchers = r(N)
2567.         drop if F_g_XX > T_max_XX
2568.         
.         // Creating varibale to store number of groups per treatment path and collapsing
.         gen N_XX = 1
2569.         sum g_weight_XX
2570.         gen N_w_XX =  (g_weight_XX * N_XX) / r(sum)
2571.         drop group_XX g_weight_XX
2572.         gcollapse (sum) N_XX N_w_XX, by(treatment_XX*)
2573.         order N* treat* 
2574.         sum N_XX
2575.         local tot_switch = r(sum)
2576.         
.         // Keep the observations amounting to p% of the detected treatment paths 
.         gen neg_N_XX = -N_XX
2577.         sort neg_N_XX treatment_XX*
2578.         gen cum_sum_XX = sum(N_w_XX)
2579.         gen in_table_XX = (cum_sum_XX <= `des_p')
2580.         sort in_table_XX cum_sum_XX
2581.         bys in_table_XX: gen id_XX = _n
2582.         
.         // Keep all observations up to the first exceeding the p%       
.         keep if (in_table_XX == 1) | (in_table_XX == 0 & id_XX == 1)    
2583.         // Store the final % of groups included by the design option
.         {
2584.                 if `des_p' < 1 {
2585.                         sum cum_sum_XX if in_table == 0
2586.                         local last_p : di %9.2fc 100 * r(min)
2587.                 }
2588.                 else {
2589.                         local last_p : di %9.2fc 100
2590.                 }
2591.         }
2592.         
.         sort neg_N_XX treatment_XX*
2593.         drop neg_N_XX in_table_XX id_XX cum_sum_XX
2594.         
.         // Prepare matrix for the output table
.         mat define desmat = J(`=_N', `= 2 + 1 + `des_n'', .)
2595.         local colnames
2596.         label var N_XX "#Groups"
2597.         label var N_w_XX "%Groups"
2598.         replace N_w_XX=100*N_w_XX
2599.         * display in % terms
.         
.         // Generate the column/row names and fill treatment path
.         local j = 1
2600.         foreach v of varlist _all {
2601.                 local m : var label `v'
2602.                 if strpos("`v'", "treatment_XX") > 0 {
2603.                         local k = substr("`v'", length("treatment_XX") + 1, .)
2604.                         local m = "ℓ=`=`k'-1'"
2605.                 }
2606.                 local colnames `colnames' `m'   
2607.                 
.                 // Fill treatement path
.                 forv i = 1/`=_N' {
2608.                         matrix desmat[`i', `j'] = `v'[`i']
2609.                 }
2610.                 local j = `j' + 1
2611.                 
.         }
2612.         local rownames
2613.         forv i = 1/`=_N' {
2614.                 local rownames `rownames' "TreatPath`i'"
2615.         }
2616.         foreach v in col row {
2617.                 mat `v'n desmat = ``v'names'
2618.         }
2619.         }
2620. 
.         // output in console
.         if "`des_path'" == "console" {          
2621.                 display _newline
2622.                 di "{hline 80}"
2623.                 di _skip(10) "{bf:Detection of treatment paths - `des_n' periods after first switch}"
2624.                 if "`by'" !=""{ 
2625.                         * Add description with the by variable level if by is specified 
.                         di _skip(35) "{bf:By: `by' = `val_lab_int_XX'}"
2626.                 }       
2627.                 di "{hline 80}"
2628.                 matlist desmat, format(%9.4gc)
2629.                 di "{hline 80}"
2630.                 di "{it: Treatment paths detected in at least `=strtrim("`des_per'")'% of the switching groups `tot_switch' for which 
> `effects' effects could be estimated.}"
2631.                 di "{it: Total % = `=strtrim("`last_p'")' %}"
2632.                 
.                 // Get values for the reference line that explains how to read the table 
.                 qui {
2633.                         local n_groups = N_XX[1]
2634.                         local d_start = treatment_XX1[1]
2635.                         if `des_n' == 1 {
2636.                                 local d_vec : di %9.2gc treatment_XX2[1]
2637.                                 local d_vec = strtrim("`d_vec'")
2638.                         }
2639.                         else {
2640.                                 local d_vec = "vector ("
2641.                                 forv j = 1/`des_n' {
2642.                                         local k : di %9.2gc treatment_XX`=`j' + 1'[1]
2643.                                         local k = strtrim("`k'")
2644.                                         local d_vec = "`d_vec'`k', "
2645.                                 }
2646.                                 local d_vec = substr("`d_vec'", 1, length("`d_vec'")-2) + ")"
2647.                         }
2648.                 }
2649.                 di as text "{it: Design interpretation (first row):}"
2650.                 di as text "{it: `n_groups' groups started with treatment `d_start' and then experienced treatment `d_vec'.}"         
>   
2651.         }
2652.         
.         // output as excel
.         else if "`des_path'" != "console" & "`des_path'" !=  "" {
2653.                 if "`by'"==""{
2654.                 qui {
2655.                         putexcel set "`des_path'", replace sheet("Design", replace)
2656.                         putexcel A1 = matrix(desmat, names)
2657.                 }
2658.                  di "{bf:Design exported to `des_path'}"
2659.                 }
2660.                 else if "`by'"!=""{
2661.                         qui {
2662.                         * Create new sheet for each by level when by is specified       
.                         putexcel set "`des_path'", modify sheet("Design `by' = `val_lab_int_XX'", replace)
2663.                         putexcel A1 = matrix(desmat, names)
2664.                         }
2665.                  di "{bf:Design exported to `des_path'}"
2666.         }  
2667.         }
2668. }
2669. 
. 
. ///// Date first switch option: produces a table showing the number of groups switching for the first time by period
> 
. if "`date_first_switch'" != "" {
2670.         qui {
2671. 
.         // Reload the data before it was changed in save_sample
.         use `data_predesign', clear
2672.         
.         // Fetch the arguments 
.         local dfs_opt = strtrim(substr("`date_first_switch'", 1, strpos("`date_first_switch'", ",") - 1))
2673.         local dfs_path = strtrim(substr("`date_first_switch'", strpos("`date_first_switch'", ",") + 1, .))
2674.         
.         // Error message if the arguments in the option were specified wrong
.         if "`dfs_opt'" != "" & "`dfs_opt'" != "by_baseline_treat" {
2675.                 di as error ""
2676.                 di as error "Only option {bf:by_baseline_treat} allowed"
2677.                 di as input _continue ""
2678.                 exit
2679.         }
2680.         
.         // Drop non switchers
.         drop if F_g_XX == T_max_XX+1 | F_g_XX == .
2681.         keep if time_XX == F_g_XX 
2682.         *Keep just 1 observation per group
.         keep `2' `3' F_g_XX d_sq_XX
2683.         }
2684.         
.         // When by_baseline_treat is not specified
.         if missing("`dfs_opt'") {
2685.                 qui {
2686.                 // collapse the number of groups by time
.                 gcollapse (count) `2', by(`3')
2687.                 tostring `3', replace
2688.                 // generate the share of each group
.                 sum `2'
2689.                 local tot_s = r(sum)
2690.                 gen share_XX = `2'/`tot_s' * 100
2691.                 
.                 // make matrix with the number and share of groups by time
.                 mkmat `2' share_XX, matrix(dfs) rownames(`3')
2692.                 mat colnames dfs = #Groups %Groups
2693.                 }
2694. 
.                 // output in console
.                 if "`dfs_path'" == "console" {          
2695.                         display _newline
2696.                         di "{hline 48}"
2697.                         di  _skip(10) "{bf:Switching dates}"
2698.                         if "`by'" !=""{ 
2699.                                 * Add description with the by variable level if by is specified
.                                 di _skip(10) "{bf:By: `by' = `val_lab_int_XX'}"
2700.                         }       
2701.                         di "{hline 48}"
2702.                         matlist dfs, format(%9.4gc) rowtitle("Any status quo treat.") twidth(25) // New text
2703.                         di "{hline 48}"         
2704. 
.                         ereturn scalar switch_dates = `=_N'
2705.                 }
2706.                 // output as excel
.                 else if "`dfs_path'" != "console" & "`dfs_path'" !=  "" {
2707.                         if "`by'"==""{
2708.                                 qui putexcel set "`dfs_path'", replace sheet("Switching dates", replace)
2709.                                 qui putexcel A1 = matrix(dfs, names)
2710.                                 di "{bf:Switching dates exported to `dfs_path'}"
2711.                         }
2712.                         else if "`by'"!=""{
2713.                                 * Create new sheet for each by level when by is specified       
.                                 qui putexcel set "`dfs_path'", modify sheet("Switching dates `by' = `val_lab_int_XX'", replace)
2714.                                 qui putexcel A1 = matrix(dfs, names)
2715.                                 di "{bf:Switching dates exported to `dfs_path'}"
2716.                         }
2717.                 }               
2718.         }
2719.         
.         // When by_baseline_treat is specified
.         else {
2720.                 // collapse, but this time by time and status quo treatment
.                 qui {
2721.                 gcollapse (count) `2', by(`3' d_sq_XX)
2722.                 tostring `3', replace
2723.                 gegen tot_share_XX = sum(`2'), by(d_sq_XX)
2724.                 gen share_XX = `2'/tot_share_XX * 100
2725.                 sort d_sq_XX `3'
2726.                 }
2727.                 
.                 display _newline
2728.                 if "`dfs_path'" == "console" {
2729.                         di "{hline 48}"
2730.                         di _skip(10) "{bf:Switching dates}"
2731.                         di "{hline 48}"
2732.                 }
2733.                 
.                 // make matrix with the number and share of groups by time, one for each level of status quo treatment
.                 qui {
2734.                         tostring d_sq_XX, replace
2735.                         levelsof d_sq_XX, local(levels_d_sq_XX)
2736.                         local i = 1
2737.                 }
2738.                 foreach m of local levels_d_sq_XX {
2739.                         qui {
2740.                                 mkmat `2' share_XX if d_sq_XX == "`m'", matrix(dfs`i') rownames(`3')
2741.                                 mat colnames dfs`i' = #Groups %Groups
2742.                                 sum `2'
2743.                                 local tot_s = r(sum)
2744.                         }                       
2745.                         // output in console
.                         if "`dfs_path'" == "console" {          
2746.                                 matlist dfs`i', format(%9.4gc) rowtitle("Status quo treat. = `m'") twidth(25) // New
2747.                                 di "{hline 48}"
2748.                                 qui {
2749.                                         sum `2' if d_sq_XX == "`m'"
2750.                                         local tot_s = r(sum)
2751.                                         count if d_sq_XX == "`m'"
2752.                                         ereturn scalar switch_dates_Dsq_`l_by' = `r(N)' // New
2753.                                 }
2754.                         }
2755.                         // output as excel
.                         else if "`dfs_path'" != "console" & "`dfs_path'" !=  "" {
2756.                                 qui {
2757.                                 if `i' == 1 {
2758.                                         local rep_opt "replace"
2759.                                 }
2760.                                 else {
2761.                                         local rep_opt "modify"
2762.                                 }
2763.                                 
.                                 if "`by'"==""{
2764.                                         putexcel set "`dfs_path'", `rep_opt' sheet("Switch. Dates Base treat `m'", replace)
2765.                                         putexcel A1 = matrix(dfs`i', names)
2766.                                         noi di _newline
2767.                                 }
2768.                                 else if "`by'"!=""{
2769.                                         * Create new sheet for each by level when by is specified
.                                         putexcel set "`dfs_path'", modify sheet("Dates Base treat=`m' & `by' = `val_lab_int_XX'", replace)
>  //`by' = `val_lab_int_XX'
2770.                                         putexcel A1 = matrix(dfs`i', names)
2771.                                         noi di _newline
2772.                                 }       
2773.                         }
2774.                 }
2775.                 local i = `i' + 1                       
2776.                 }
2777.                 // consol message if output is written to excel
.                 if "`dfs_path'" != "console" & "`dfs_path'" != "" {
2778.                         di "Switching dates exported to `dfs_path'"
2779.                 }
2780.         }
2781. }
