. if "`trends_lin'"!=""{
657.         scalar L_placebo_u_XX=L_placebo_u_XX-1
658. }
659. if L_placebo_u_XX==. {
660.     scalar L_placebo_u_XX = 0
661. }
662. }
663. }
664. 
. // For switchers out
. if "`switchers'"==""|"`switchers'"=="out"{
665. sum L_g_XX if S_g_XX==0
666. scalar L_a_XX=r(max)
667. *For placebos
