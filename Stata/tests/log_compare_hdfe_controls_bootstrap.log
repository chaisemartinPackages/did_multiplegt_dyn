. *Attributing the right number of groups depending on which cohort will be used in demeaning:
. gen dof_cohort_`i'_s_t_XX=dof_cohort_`i'_s2_t_XX if dof_cohort_`i'_s2_t_XX>=2
306. replace dof_cohort_`i'_s_t_XX=dof_cohort_`i'_s1_t_XX if dof_cohort_`i'_s2_t_XX<2&dof_cohort_`i'_s1_t_XX>=2 
307. replace dof_cohort_`i'_s_t_XX=dof_cohort_`i'_s0_t_XX if dof_cohort_`i'_s2_t_XX<2&dof_cohort_`i'_s1_t_XX<2 
308. 
. * Mean
. gen mean_cohort_`i'_s_t_XX=total_cohort_`i'_s2_t_XX/count_cohort_`i'_s2_t_XX if dof_cohort_`i'_s2_t_XX>=2
309. replace mean_cohort_`i'_s_t_XX=total_cohort_`i'_s1_t_XX/count_cohort_`i'_s1_t_XX if dof_cohort_`i'_s2_t_XX<2&dof_cohort_`i'_s1_t_XX>=2 
310. replace mean_cohort_`i'_s_t_XX=total_cohort_`i'_s0_t_XX/count_cohort_`i'_s0_t_XX if dof_cohort_`i'_s2_t_XX<2&dof_cohort_`i'_s1_t_XX<2
311. 
. }
312. 
. // Modif Clément 30/6/2025:
. // If a switcher is the only one in their cohort or if a not-yet-switcher is the only one in their cohort, we demean wrt union of switcher
> s and not-yet switchers, provided switchers and not-yet-switchers do not all come from the same cluster.
. 
. cap drop dof_ns_s_`i'_XX
313. cap drop count_cohort_`i'_ns_s_t_XX
314. cap drop total_cohort_`i'_ns_s_t_XX
315. cap drop mean_cohort_`i'_ns_s_t_XX
316. cap drop dof_cohort_`i'_ns_s_t_XX
317. 
. gen dof_ns_s_`i'_XX=(dof_s_`i'_XX==1|dof_ns_`i'_XX ==1)
318. 
. * Mean's denominator
. bys d_sq_XX `trends_nonparam' time_XX : gegen count_cohort_`i'_ns_s_t_XX=total(N_gt_XX) if dof_ns_s_`i'_XX==1
319. 
. * Mean's numerator
. bys d_sq_XX `trends_nonparam' time_XX: gegen total_cohort_`i'_ns_s_t_XX=total(diff_y_`i'_N_gt_XX) if dof_ns_s_`i'_XX==1
320. 
. * Mean 
. gen mean_cohort_`i'_ns_s_t_XX=total_cohort_`i'_ns_s_t_XX/count_cohort_`i'_ns_s_t_XX
321. 
. * Counting number of groups for DOF adjustment
. {
322.         if "`cluster'" == "" {
323.                 bys d_sq_XX `trends_nonparam' time_XX: gegen dof_cohort_`i'_ns_s_t_XX=total(dof_ns_s_`i'_XX) if dof_ns_s_`i'_XX==1
324.         }
325.         else {
326.                 cap drop cluster_dof_`i'_ns_s_XX
327.                 gen cluster_dof_`i'_ns_s_XX = `cluster' if dof_ns_s_`i'_XX==1
328.                 bys d_sq_XX `trends_nonparam' time_XX: gegen dof_cohort_`i'_ns_s_t_XX = nunique(cluster_dof_`i'_ns_s_XX) if !missing(cl
> uster_dof_`i'_ns_s_XX)
329.         }
330. }       
331. 
. ///// From those parts, generate variables for the demeaning and the DOF adjustment 
> // E_hat_(g,t), defined from parts depending on the cohort definition
. gen E_hat_gt_`i'_XX=0 if (time_XX<F_g_XX|F_g_XX-1+`i'==time_XX) 
332. replace E_hat_gt_`i'_XX=mean_cohort_`i'_ns_t_XX if (time_XX<F_g_XX&dof_cohort_`i'_ns_t_XX>=2)
333. replace E_hat_gt_`i'_XX=mean_cohort_`i'_s_t_XX if (F_g_XX-1+`i'==time_XX&dof_cohort_`i'_s_t_XX>=2)
334. replace E_hat_gt_`i'_XX=mean_cohort_`i'_ns_s_t_XX if dof_cohort_`i'_ns_s_t_XX>=2&((F_g_XX-1+`i'==time_XX&dof_cohort_`i'_s_t_XX==1)|(tim
> e_XX<F_g_XX&dof_cohort_`i'_ns_t_XX==1))
335. 
. // DOF_(g,t) for DOF adjustement, defined from parts depending on the cohort definition 
. // Diego - 02-03-25: when there is only 1 switcher, dof_cohort_`i'_s_t_XX = 1, hence the denominator in the expression below is 0
. // The fraction is undefined and Stata puts it to missing
. gen DOF_gt_`i'_XX=1 if (time_XX<F_g_XX|F_g_XX-1+`i'==time_XX)
336. replace DOF_gt_`i'_XX= sqrt(dof_cohort_`i'_s_t_XX/(dof_cohort_`i'_s_t_XX-1)) if (F_g_XX-1+`i'==time_XX & dof_cohort_`i'_s_t_XX > 1)
337. replace DOF_gt_`i'_XX=  sqrt(dof_cohort_`i'_ns_t_XX/(dof_cohort_`i'_ns_t_XX-1)) if (time_XX<F_g_XX & dof_cohort_`i'_ns_t_XX > 1)
338. replace DOF_gt_`i'_XX=  sqrt(dof_cohort_`i'_ns_s_t_XX/(dof_cohort_`i'_ns_s_t_XX-1)) if dof_cohort_`i'_ns_s_t_XX>=2&((F_g_XX-1+`i'==time
> _XX&dof_cohort_`i'_s_t_XX==1)|(time_XX<F_g_XX&dof_cohort_`i'_ns_t_XX==1))
339. 
. // End modif Clément 30/6/2025.
. 
. ////////// 3. Computing U_Gg_\ell variables
> 
. ///// If the dynamic effect can be estimated (as there are switchers), we compute the U_Gg_\ell variables etc.
> 
. if (N`=increase_XX'_`i'_XX!=0){
340. 
. // Creating a dummy variable indicating whether l<=T_g_XX-1
. 
. gen dummy_U_Gg`i'_XX = (`i'<=T_g_XX-1) 
341. 
. // Computing U_+_(G,g,l)
. 
. gen U_Gg`i'_temp_XX = dummy_U_Gg`i'_XX*(G_XX / N`=increase_XX'_`i'_XX) * (time_XX>=`=`i'+1'&time_XX<=T_g_XX) * N_gt_XX* [distance_to_switc
> h_`i'_XX - (N`=increase_XX'_t_`i'_g_XX/N_gt_control_`i'_XX) * never_change_d_`i'_XX] 
342. 
. replace U_Gg`i'_temp_XX = U_Gg`i'_temp_XX* diff_y_`i'_XX 
343. 
. bysort group_XX : gegen U_Gg`i'_XX=total(U_Gg`i'_temp_XX)
344. 
. replace U_Gg`i'_XX = U_Gg`i'_XX*first_obs_by_gp_XX
345. 
. // Counting the number of cells for which we can estimate U_Gg`i'_temp_XX, 
. // to compute the "N" displayed by command
. 
. gen count`i'_core_XX=0
346. replace count`i'_core_XX=N_gt_XX if (U_Gg`i'_temp_XX!=.&U_Gg`i'_temp_XX!=0|(U_Gg`i'_temp_XX==0&diff_y_`i'_XX==0&(distance_to_switch_`i'
> _XX!=0|(N`=increase_XX'_t_`i'_g_XX!=0&never_change_d_`i'_XX!=0))))
347.  
. // Computing U_(+,var)_(G,g,l)
. 
. gen U_Gg`i'_temp_var_XX = 0
348. 
. // Final computation 
. 
. replace U_Gg`i'_temp_var_XX= dummy_U_Gg`i'_XX*(G_XX / N`=increase_XX'_`i'_XX) * [distance_to_switch_`i'_XX - (N`=increase_XX'_t_`i'_g_XX/N
> _gt_control_`i'_XX) * never_change_d_`i'_XX] * (time_XX>=`=`i'+1'&time_XX<=T_g_XX) * N_gt_XX * DOF_gt_`i'_XX *(diff_y_`i'_XX-E_hat_gt_`i'_
> XX)
349. 
. ///// Adding the additional part of U^(+,var,X)_{G,g,l}/U^(-,var,X)_{G,g,l} when controls are included:
> ///// sum across values of baseline treatment d of M^+_(d,l)* a term in brackets in companion paper. 
> 
. if "`controls'"!=""{
350. 
. // Loop over values of d_sq_int_XX:sum across values of baseline treatment  
. levelsof d_sq_int_XX, local(levels_d_sq_XX)
351. 
. foreach l of local levels_d_sq_XX {     
352.         // FELIX: Add this condition here, same for the placebo case!   
.         if (scalar(useful_res_`l'_XX)>1){
353.         
. capture drop combined`=increase_XX'_temp_`l'_`i'_XX     
354. gen combined`=increase_XX'_temp_`l'_`i'_XX=0
355.                 
. // Loop over controls: inner product of M^+_(d,l)* term in brackets in companion paper.
. forvalues j=1/`count_controls'{
356. 
. // Loop over k: computation of term in brackets in companion paper.
. forvalues k=1/`count_controls'{         
357.         
. // Computation of all cross products between elements of jth line of Den^{-1}_d and term multiplying it
. capture drop in_brackets_`l'_`j'_`k'_temp_XX
358. //// CHANGE BELOW - tks + Changes Diego 27-03-25: remove N_c_`l'_XX from formula below, since we have adjusted inv_Denom above
> gen in_brackets_`l'_`j'_`k'_temp_XX = inv_Denom_`l'_XX[`j',`k'] * in_sum_`k'_`l'_XX * (d_sq_int_XX == `l' & F_g_XX>=3) 
359. ////
> 
. // Summing over k, to have jth coordinate of vector Den^{-1}_d*...
. 
. replace in_brackets_`l'_`j'_XX=in_brackets_`l'_`j'_XX+in_brackets_`l'_`j'_`k'_temp_XX
360. } // end loop over k
361. 
. // Withdrawing theta_d
. replace in_brackets_`l'_`j'_XX=in_brackets_`l'_`j'_XX - coefs_sq_`l'_XX[`j',1]
362. 
. // Computation of all cross products between coordinates of M^+_(d,l) and those of term in brackets
. capture drop combined`=increase_XX'_temp_`l'_`j'_`i'_XX
363. gen combined`=increase_XX'_temp_`l'_`j'_`i'_XX=M`=increase_XX'_`l'_`j'_`i'_XX*in_brackets_`l'_`j'_XX
364. 
. // Summing over j
. replace combined`=increase_XX'_temp_`l'_`i'_XX=combined`=increase_XX'_temp_`l'_`i'_XX+combined`=increase_XX'_temp_`l'_`j'_`i'_XX
365. } // end loop over j
366. 
. // Final sum over the status quo treatment (outer sum over d in the formula)
. // Modif. Diego: dropped  if d_sq_int_XX==`l'
. replace part2_switch`=increase_XX'_`i'_XX=part2_switch`=increase_XX'_`i'_XX+combined`=increase_XX'_temp_`l'_`i'_XX
367. } // Modif FELIX: condition "useful residual" 
368. } // end loop over l
369. 
. }       
370. 
. // Summing the U^(var)_{G,g,l}s over time periods for each group
. bys group_XX: gegen U_Gg`i'_var_XX=total(U_Gg`i'_temp_var_XX)
371. 
. // Modeif Felix 21.03.2025 (adjust order of adding additional term and summing across t)
. if "`controls'" != "" {
372.         // Making the adjustement to U^(+,var)_{G,g,l} when controls are included
.         if `=increase_XX'==1{
373.         replace U_Gg`i'_var_XX=U_Gg`i'_var_XX - part2_switch1_`i'_XX 
374.         }
375. 
.         if `=increase_XX'==0{
376.         //// CHANGE BELOW - tks (switching plus to minus in the sum since the final sign flip won't be until later)
>         replace U_Gg`i'_var_XX=U_Gg`i'_var_XX - part2_switch0_`i'_XX 
377.         }
378. }
379. 
. }
380. 
. ////////// 4. Computing adjustements for the normalized and trends_lin options 
> 
. ///// Compute \delta^D for normalized option
> 
. if "`normalized'"!=""{
381.         
.         capture drop sum_treat_until_`i'_XX
382.         capture drop delta_D_`i'_cum_temp_XX
383.         
.         if `continuous'==0{
384.                 bys group_XX : gegen sum_treat_until_`i'_XX = total(treatment_XX - d_sq_XX) if time_XX>=F_g_XX&time_XX<=F_g_XX-1+`i'&S_
> g_XX==increase_XX
385.         }
386.         // Redefine this with original treatment if continuous is defined (treatment was binarized and staggerized)
.         else if `continuous'>0{
387.                 bys group_XX : gegen sum_treat_until_`i'_XX = total(treatment_XX_orig - d_sq_XX_orig) if time_XX>=F_g_XX&time_XX<=F_g_X
> X-1+`i'&S_g_XX==increase_XX
388.         }
389. gen delta_D_`i'_cum_temp_XX = N_gt_XX/N`=increase_XX'_`i'_XX*[sum_treat_until_`i'_XX* S_g_XX + (1-S_g_XX)*(-sum_treat_until_`i'_XX)] if
>  distance_to_switch_`i'_XX==1 
390. 
.         sum  delta_D_`i'_cum_temp_XX
391.         scalar delta_norm_`i'_XX = r(sum) 
392. 
. }
393. 
. } // End of the loop over l_u_a_XX.
394. // At this point we have all the U_Gg_`i'_XX we need. Thus, we can sum them now for the trends_lin option.
. 
. ///// trends_lin option
> 
. // As trends_lin relies on summing up the l effects we can only estimate effect l when we can estimate all prior l-1 effects, we verify if
>  this condition is met.
. 
. scalar Ntrendslin=1
395. forvalue i=1/`=l_u_a_XX' {
396. scalar Ntrendslin=min(Ntrendslin , N`=increase_XX'_`i'_XX )
397. }
398. 
. // Compute the U_Gg_\ell for trends_lin
. 
. if "`trends_lin'"!="" & Ntrendslin != 0  {
399.         
.         capture drop U_Gg`=l_u_a_XX'_TL
400.         capture drop U_Gg`=l_u_a_XX'_var_TL
401.         
.         // Initializing at 0
.         gen U_Gg`=l_u_a_XX'_TL = 0
402.         gen U_Gg`=l_u_a_XX'_var_TL = 0
403. 
.         // summing up the U_Gg's up to the l-th (current) effect
.         forvalue i=1/`=l_u_a_XX'{
404.                 replace U_Gg`=l_u_a_XX'_TL = U_Gg`=l_u_a_XX'_TL + U_Gg`i'_XX            
405.                 replace U_Gg`=l_u_a_XX'_var_TL =  U_Gg`=l_u_a_XX'_var_TL + U_Gg`i'_var_XX 
406.         }
407.         
.         // replacing the U_Gg's with the one adjusted for group specific linear trends
.         replace U_Gg`=l_u_a_XX'_XX = U_Gg`=l_u_a_XX'_TL
408.         replace U_Gg`=l_u_a_XX'_var_XX = U_Gg`=l_u_a_XX'_var_TL
409.                 
. }
410. 
. ////////// 5. Data preparation steps to generate variables necessary for computation of placebo effects 
> 
. if `placebo'!=0{
411.         if `=l_placebo_u_a_XX'>=1{
412.         
. forvalue i=1/`=l_placebo_u_a_XX'{
413. 
. ///// Capture drop of variables created below
> capture drop diff_y_pl_`i'_XX
414. capture drop U_Gg_pl_`i'_temp_XX
415. capture drop U_Gg_placebo_`i'_XX
416. capture drop U_Gg_pl_`i'_temp_var_XX
417. capture drop U_Gg_pl_`i'_var_XX
418. capture drop dist_to_switch_pl_`i'_XX
419. capture drop never_change_d_pl_`i'_XX
420. capture drop N`=increase_XX'_t_placebo_`i'_XX
421. capture drop N`=increase_XX'_t_pl_`i'_XX_w
422. capture drop N`=increase_XX'_t_placebo_`i'_g_XX
423. capture drop N_gt_control_placebo_`i'_XX
424. capture drop dummy_U_Gg_pl_`i'_XX 
425. capture drop never_change_d_pl_`i'_wXX
426. capture drop dist_to_switch_pl_`i'_wXX
427. 
. capture drop dof_cohort_pl_`i'_s_t_XX
428. capture drop dof_cohort_pl_`i'_ns_t_XX
429. capture drop dof_cohort_pl_`i'_s0_t_XX
430. capture drop dof_cohort_pl_`i'_s1_t_XX
431. capture drop dof_cohort_pl_`i'_s2_t_XX
432. capture drop count_cohort_pl_`i'_s_t_XX
433. capture drop count_cohort_pl_`i'_ns_t_XX
434. capture drop count_cohort_pl_`i'_s0_t_XX
435. capture drop count_cohort_pl_`i'_s1_t_XX
436. capture drop count_cohort_pl_`i'_s2_t_XX
437. capture drop total_cohort_pl_`i'_s_t_XX
438. capture drop total_cohort_pl_`i'_ns_t_XX
439. capture drop total_cohort_pl_`i'_s0_t_XX
440. capture drop total_cohort_pl_`i'_s1_t_XX
441. capture drop total_cohort_pl_`i'_s2_t_XX
442. capture drop mean_cohort_pl_`i'_s_t_XX
443. capture drop mean_cohort_pl_`i'_ns_t_XX
444. capture drop mean_cohort_pl_`i'_s0_t_XX
445. capture drop mean_cohort_pl_`i'_s1_t_XX
446. capture drop mean_cohort_pl_`i'_s2_t_XX
447. 
. capture drop E_hat_gt_pl_`i'_XX
448. capture drop DOF_gt_pl_`i'_XX
449. 
. //The steps to compute the placebos are:
. // 1. to place the corresponding outcome (y_{F_g-1} - y_{F_g - l - 1})) values in the same row of that (y_{F_g + l -1} - y_{F_g - 1}) of t
> he symmetric DID_l. 
. // 2. The other variables, such as N_gt, N0_l or N1_l, remain unchanged, except that we have to check if diff_y_placebo ( = y_{F_g - 2l -2
> }- y_{F_g - l -1}) exists. 
. 
. ///// Computing the long differences for the placebos
> xtset group_XX time_XX
450. bys group_XX : gen diff_y_pl_`i'_XX = L`=2*`i''.outcome_XX - L`i'.outcome_XX
451. 
. ///// Identifying the control (g,t)s in the estimation of placebo i 
> bys group_XX: gen never_change_d_pl_`i'_XX=never_change_d_`i'_XX*(diff_y_pl_`i'_XX!=.) 
452. gen never_change_d_pl_`i'_wXX=never_change_d_pl_`i'_XX*N_gt_XX
453. 
. ///// number of control groups for g at t
> bys time_XX d_sq_XX `trends_nonparam': gegen N_gt_control_placebo_`i'_XX=total(never_change_d_pl_`i'_wXX) 
454. 
. ///// Creating binary variable indicating whether g is \ell periods away from switch & (diff_y_pl_`i'_XX!=.) is well defined -> based on t
> he already defined distance_to_switch_`i'_XX variable 
> *Modif Clément 26/09/2025:
. *gen dist_to_switch_pl_`i'_XX=distance_to_switch_`i'_XX*(diff_y_pl_`i'_XX!=.)
. gen dist_to_switch_pl_`i'_XX=distance_to_switch_`i'_XX*(diff_y_pl_`i'_XX!=.)*(N_gt_control_placebo_`i'_XX>0&N_gt_control_placebo_`i'_XX!=.
> )
455.  
. if "`same_switchers_pl'"!=""{
456.         replace dist_to_switch_pl_`i'_XX=dist_to_switch_pl_`i'_XX*fillin_g_pl_XX
457. }
458. 
. ///// Creating a variable counting the number of groups \ell periods away from switch at t
> gen dist_to_switch_pl_`i'_wXX= dist_to_switch_pl_`i'_XX*N_gt_XX
459. bys time_XX: gegen N`=increase_XX'_t_placebo_`i'_XX=total(dist_to_switch_pl_`i'_wXX)
460. 
. ///// Computing N^1_\ell/N^0_\ell. for the placebos
> 
. // Initializing the N1_`i'_XX/N0_`i'_XX scalar at 0. 
. scalar N`=increase_XX'_placebo_`i'_XX=0
461. 
. // Loop over t incrementing the scalar
. forvalue t=`=t_min_XX'/`=T_max_XX'{
462.         sum N`=increase_XX'_t_placebo_`i'_XX if time_XX==`t'
463.         if !missing(r(mean)) scalar N`=increase_XX'_placebo_`i'_XX = N`=increase_XX'_placebo_`i'_XX + r(mean) // Modif Diego
464. }
465. 
. // Modif Felix weight
. if "`weight'"!=""{
466. 
.         bys time_XX: gegen N`=increase_XX'_t_pl_`i'_XX_w=total(dist_to_switch_pl_`i'_XX)
467.         
.         scalar N`=increase_XX'_`i'_pl_XX_weight=0
468. 
. // Loop over t incrementing the scalar
. forvalue t=`=t_min_XX'/`=T_max_XX'{
469.         sum N`=increase_XX'_t_pl_`i'_XX_w if time_XX==`t'
470.         if !missing(r(mean)) scalar N`=increase_XX'_`i'_pl_XX_weight = N`=increase_XX'_`i'_pl_XX_weight + r(mean) // Modif Diego
471. }
472. }
473. 
. ///// Creating N^1_{t,\ell,g}/N^0_{t,\ell,g} for the placebos: 
> ///// Variable counting number of groups \ell periods away from switch at t, 
> ///// and with same D_{g,1} and trends_nonparam.
> 
. bys time_XX d_sq_XX `trends_nonparam': gegen N`=increase_XX'_t_placebo_`i'_g_XX=total(dist_to_switch_pl_`i'_wXX)
474. 
. ///// Creating all the adjustment terms to compute estimators with controls, and their variances 
> if "`controls'" != ""{
475. 
. // Initialize intermediate Variable needed later
. capture drop part2_pl_switch`=increase_XX'_`i'_XX
476. gen part2_pl_switch`=increase_XX'_`i'_XX=0
477. 
. local count_controls=0
478. 
. // Computing the long differences of the control variables (X_g_t - X_g_t-l)
. 
. foreach var of varlist `controls'{
479. 
.         local count_controls=`count_controls'+1
480. 
.         capture drop diff_X_`count_controls'_placebo_`i'_XX
481. 
.         xtset group_XX time_XX
482.         gen diff_X_`count_controls'_placebo_`i'_XX = L`=2*`i''.`var' - L`i'.`var'
483. 
.         // Computing N_g_t * (X_g_t - X_g_t-l)
. 
.         capture drop diff_X`count_controls'_pl_`i'_N_XX
484.         gen diff_X`count_controls'_pl_`i'_N_XX = N_gt_XX * diff_X_`count_controls'_placebo_`i'_XX 
485. 
.         foreach l of local levels_d_sq_XX { // index l corresponds to d in the paper 
486. 
.                 capture drop m`=increase_XX'_pl_g_`count_controls'_`l'_`i'_XX 
487.                 gen m`=increase_XX'_pl_g_`count_controls'_`l'_`i'_XX = (`i' <= T_g_XX-2 & d_sq_int_XX == `l')* (G_XX / N`=increase_XX'_
> placebo_`i'_XX) * ([dist_to_switch_pl_`i'_XX - (N`=increase_XX'_t_placebo_`i'_g_XX/N_gt_control_placebo_`i'_XX) * never_change_d_pl_`i'_XX
> ] * (time_XX>=`=`i'+1'&time_XX<=T_g_XX) * diff_X`count_controls'_pl_`i'_N_XX)
488.                 capture drop m_pl`=increase_XX'_`l'_`count_controls'_`i'_XX
489.                 bys group_XX: gegen m_pl`=increase_XX'_`l'_`count_controls'_`i'_XX=total(m`=increase_XX'_pl_g_`count_controls'_`l'_`i'_
> XX)
490.                 bys group_XX: replace m_pl`=increase_XX'_`l'_`count_controls'_`i'_XX = . if _n != 1
491.                 capture drop M_pl`=increase_XX'_`l'_`count_controls'_`i'_XX 
492.                 egen M_pl`=increase_XX'_`l'_`count_controls'_`i'_XX = total(m_pl`=increase_XX'_`l'_`count_controls'_`i'_XX)
493.                 replace M_pl`=increase_XX'_`l'_`count_controls'_`i'_XX = (1/G_XX)*M_pl`=increase_XX'_`l'_`count_controls'_`i'_XX
494.         }
495. 
.         foreach l of local levels_d_sq_XX {
496.                 if (scalar(useful_res_`l'_XX)>1){ 
497.                         replace diff_y_pl_`i'_XX = diff_y_pl_`i'_XX - coefs_sq_`l'_XX[`=`count_controls'',1]*diff_X_`count_controls'_pl
> acebo_`i'_XX if d_sq_int_XX==`l' 
498. 
.                         capture drop in_brackets_pl_`l'_`count_controls'_XX     
499.                         gen in_brackets_pl_`l'_`count_controls'_XX=0
500.                                                         
.                 }               
501.         }
502. }
503. }
504. 
. 
. ///// Computing the variables used for the demeaning of outcome's placebo long difference diff_y_`i',
> ///// which we will use to create the U_g^{var} variables, which are used to compute 
> ///// the placebos' variances. 
> 
. // Generate placebo long-differences of outcomes time N_{g,t}, and dummy for (g,t) such that
. // diff_y_`i' non missing and N_gt non missing.
. 
. capture drop diff_y_pl_`i'_N_gt_XX
505. gen diff_y_pl_`i'_N_gt_XX=N_gt_XX*diff_y_pl_`i'_XX
506. capture drop dof_ns_pl_`i'_XX
507. gen dof_ns_pl_`i'_XX = N_gt_XX!=0&diff_y_pl_`i'_XX!=.&never_change_d_pl_`i'_XX==1&N`=increase_XX'_t_placebo_`i'_XX>0&N`=increase_XX'_t_
> placebo_`i'_XX!=.
508. capture drop dof_s_pl_`i'_XX
509. gen dof_s_pl_`i'_XX = N_gt_XX!=0&dist_to_switch_pl_`i'_XX==1
510. 
. // For never switchers, demeaning wrt to cohorts defined by D_{g,1}, `trends_nonparam' 
. //(\mathcal{D}_k in companion paper)
. 
. // Modif Clément: we need to add by time
. * Mean's denominator
. bys d_sq_XX `trends_nonparam' time_XX : gegen count_cohort_pl_`i'_ns_t_XX=total(N_gt_XX) if dof_ns_pl_`i'_XX == 1
511. 
. * Mean's numerator
. bys d_sq_XX `trends_nonparam' time_XX : gegen total_cohort_pl_`i'_ns_t_XX=total(diff_y_pl_`i'_N_gt_XX) if dof_ns_pl_`i'_XX == 1
512. 
. * Mean 
. gen mean_cohort_pl_`i'_ns_t_XX=total_cohort_pl_`i'_ns_t_XX/count_cohort_pl_`i'_ns_t_XX
513. 
. * Counting number of groups for DOF adjustment
. {
514.         if "`cluster'" == "" {
515.                 bys d_sq_XX `trends_nonparam' time_XX : gegen dof_cohort_pl_`i'_ns_t_XX=total(dof_ns_pl_`i'_XX) if dof_ns_pl_`i'_XX == 
> 1
516.         }
517.         else {
518.                 cap drop cluster_dof_pl_`i'_ns_XX
519.                 gen cluster_dof_pl_`i'_ns_XX = `cluster' if dof_ns_pl_`i'_XX == 1
520.                 bys d_sq_XX `trends_nonparam' time_XX: gegen dof_cohort_pl_`i'_ns_t_XX = nunique(cluster_dof_pl_`i'_ns_XX) if !missing(
> cluster_dof_pl_`i'_ns_XX)
521.         }
522. }
523. // End modif Clément
. 
. // For switchers, for placebos we no longer need to distinguish depending on whether the option
. // less_conservative_se specified or not, we always demean wrt to 
. // cohorts defined by D_{g,1}, F_g, D_{g,F_g}, `trends_nonparam' (\mathcal{C}_k in companion paper).
. 
. * Mean's denominator
. bys d_sq_XX F_g_XX d_fg_XX `trends_nonparam' : gegen count_cohort_pl_`i'_s_t_XX=total(N_gt_XX) if dof_s_pl_`i'_XX==1
524. 
. * Mean's numerator
. bys d_sq_XX F_g_XX d_fg_XX `trends_nonparam' : gegen total_cohort_pl_`i'_s_t_XX=total(diff_y_pl_`i'_N_gt_XX) if dof_s_pl_`i'_XX==1 
525. 
. * Mean 
. gen mean_cohort_pl_`i'_s_t_XX=total_cohort_pl_`i'_s_t_XX/count_cohort_pl_`i'_s_t_XX     
526.                 
. * Counting number of groups for DOF adjustment
. {
527.         if "`cluster'" == "" {
528.                 bys d_sq_XX F_g_XX d_fg_XX `trends_nonparam' : gegen dof_cohort_pl_`i'_s_t_XX=total(dof_s_pl_`i'_XX) if dof_s_pl_`i'_XX
> ==1
529.         }
530.         else {
531.                 cap drop cluster_dof_pl_`i'_s_XX
532.                 gen cluster_dof_pl_`i'_s_XX = `cluster' if dof_s_pl_`i'_XX == 1
533.                 bys d_sq_XX F_g_XX d_fg_XX `trends_nonparam': gegen dof_cohort_pl_`i'_s_t_XX = nunique(cluster_dof_pl_`i'_s_XX) if !mis
> sing(cluster_dof_pl_`i'_s_XX)
534.         }
535. }
536. 
. // Modif Clément 19/6/2025:
. // If a switcher is the only one in their cohort or if a not-yet-switcher is the only one in their cohort, we demean wrt union of switcher
> s and not-yet switchers.
. 
. cap drop dof_ns_s_pl_`i'_XX
537. cap drop count_cohort_pl_`i'_ns_s_t_XX
538. cap drop total_cohort_pl_`i'_ns_s_t_XX
539. cap drop mean_cohort_pl_`i'_ns_s_t_XX
540. cap drop dof_cohort_pl_`i'_ns_s_t_XX
541. 
. gen dof_ns_s_pl_`i'_XX=(dof_s_pl_`i'_XX==1|dof_ns_pl_`i'_XX ==1)
542. 
. * Mean's denominator
. bys d_sq_XX `trends_nonparam' time_XX : gegen count_cohort_pl_`i'_ns_s_t_XX=total(N_gt_XX) if dof_ns_s_pl_`i'_XX==1
543. 
. * Mean's numerator
. bys d_sq_XX `trends_nonparam' time_XX: gegen total_cohort_pl_`i'_ns_s_t_XX=total(diff_y_pl_`i'_N_gt_XX) if dof_ns_s_pl_`i'_XX==1
544. 
. * Mean 
. gen mean_cohort_pl_`i'_ns_s_t_XX=total_cohort_pl_`i'_ns_s_t_XX/count_cohort_pl_`i'_ns_s_t_XX
545. 
. * Counting number of groups for DOF adjustment
. {
546.         if "`cluster'" == "" {
547.                 bys d_sq_XX `trends_nonparam' time_XX: gegen dof_cohort_pl_`i'_ns_s_t_XX=total(dof_ns_s_pl_`i'_XX) if dof_ns_s_pl_`i'_X
> X==1
548.         }
549.         else {
550.                 cap drop cluster_dof_pl_`i'_ns_s_XX
551.                 gen cluster_dof_pl_`i'_ns_s_XX = `cluster' if dof_ns_s_pl_`i'_XX==1
552.                 bys d_sq_XX `trends_nonparam' time_XX: gegen dof_cohort_pl_`i'_ns_s_t_XX = nunique(cluster_dof_pl_`i'_ns_s_XX) if !miss
> ing(cluster_dof_pl_`i'_ns_s_XX)
553.         }
554. }       
555. 
. ///// From those parts, generate variables for the demeaning and the DOF adjustment 
> // E_hat_(g,t), defined from parts depending on the cohort definition 
. gen E_hat_gt_pl_`i'_XX=0 if (time_XX<F_g_XX|F_g_XX-1+`i'==time_XX)
556. replace E_hat_gt_pl_`i'_XX=mean_cohort_pl_`i'_ns_t_XX if (dof_cohort_pl_`i'_ns_t_XX>=2&time_XX<F_g_XX)
557. replace E_hat_gt_pl_`i'_XX=mean_cohort_pl_`i'_s_t_XX if (dof_cohort_pl_`i'_s_t_XX>=2&F_g_XX-1+`i'==time_XX)
558. replace E_hat_gt_pl_`i'_XX=mean_cohort_pl_`i'_ns_s_t_XX if dof_cohort_pl_`i'_ns_s_t_XX>=2&(F_g_XX-1+`i'==time_XX&dof_cohort_pl_`i'_s_t_
> XX==1)|(time_XX<F_g_XX&dof_cohort_pl_`i'_ns_t_XX==1)
559. 
. // DOF_(g,t) for DOF adjustement, defined from parts depending on the cohort definition 
. // Diego - 02-03-25: when there is only 1 switcher, dof_cohort_`i'_s_t_XX = 1, hence the denominator in the expression below is 0
. // The fraction is undefined and Stata puts it to missing
. gen DOF_gt_pl_`i'_XX=1 if (time_XX<F_g_XX|F_g_XX-1+`i'==time_XX)
560. replace DOF_gt_pl_`i'_XX=  sqrt(dof_cohort_pl_`i'_s_t_XX/(dof_cohort_pl_`i'_s_t_XX-1)) if (F_g_XX-1+`i'==time_XX & dof_cohort_pl_`i'_s_
> t_XX > 1)
561. replace DOF_gt_pl_`i'_XX=  sqrt(dof_cohort_pl_`i'_ns_t_XX/(dof_cohort_pl_`i'_ns_t_XX-1)) if (time_XX<F_g_XX & dof_cohort_pl_`i'_ns_t_XX
>  > 1)
562. replace DOF_gt_pl_`i'_XX=  sqrt(dof_cohort_pl_`i'_ns_s_t_XX/(dof_cohort_pl_`i'_ns_s_t_XX-1)) if dof_cohort_pl_`i'_ns_s_t_XX>=2&(F_g_XX-
> 1+`i'==time_XX&dof_cohort_pl_`i'_s_t_XX==1)|(time_XX<F_g_XX&dof_cohort_pl_`i'_ns_t_XX==1)
563. 
. // End modif Clément 19/6/2025.
. 
. ////////// 6. Computing U_Gg_\ell variables for the placebos (similar to part 4, less commented)
> 
. gen dummy_U_Gg_pl_`i'_XX = (`i'<=T_g_XX-1)
564. 
. if (N`=increase_XX'_placebo_`i'_XX!=0){
565. 
. gen U_Gg_pl_`i'_temp_XX = dummy_U_Gg_pl_`i'_XX*(G_XX / N`=increase_XX'_placebo_`i'_XX) * (time_XX>=`=`i'+1'&time_XX<=T_g_XX)* N_gt_XX * [d
> ist_to_switch_pl_`i'_XX - (N`=increase_XX'_t_placebo_`i'_g_XX/N_gt_control_placebo_`i'_XX) * never_change_d_pl_`i'_XX] *diff_y_pl_`i'_XX 
566. 
. bysort group_XX : gegen U_Gg_placebo_`i'_XX=total(U_Gg_pl_`i'_temp_XX)
567. 
. replace U_Gg_placebo_`i'_XX= U_Gg_placebo_`i'_XX*first_obs_by_gp_XX
568. 
. capture drop count`i'_pl_core_XX
569. gen count`i'_pl_core_XX=0
570. replace count`i'_pl_core_XX= N_gt_XX if (U_Gg_pl_`i'_temp_XX!=.&U_Gg_pl_`i'_temp_XX!=0|(U_Gg_pl_`i'_temp_XX==0&diff_y_pl_`i'_XX==0&(dis
> t_to_switch_pl_`i'_XX!=0|(N`=increase_XX'_t_placebo_`i'_g_XX!=0&never_change_d_pl_`i'_XX!=0))))
571. 
. gen U_Gg_pl_`i'_temp_var_XX =0
572. 
. replace U_Gg_pl_`i'_temp_var_XX= dummy_U_Gg_pl_`i'_XX*(G_XX / N`=increase_XX'_placebo_`i'_XX) * [dist_to_switch_pl_`i'_XX - (N`=increase_X
> X'_t_placebo_`i'_g_XX/N_gt_control_placebo_`i'_XX) * never_change_d_pl_`i'_XX] * (time_XX>=`=`i'+1'&time_XX<=T_g_XX) * N_gt_XX * DOF_gt_pl
> _`i'_XX *(diff_y_pl_`i'_XX-E_hat_gt_pl_`i'_XX)
573. 
. if "`controls'"!=""{
574. 
. levelsof d_sq_int_XX, local(levels_d_sq_XX)
575. foreach l of local levels_d_sq_XX {     
576. if (scalar(useful_res_`l'_XX)>1){ // MODIF FELIX
577.         
. capture drop combined_pl`=increase_XX'_temp_`l'_`i'_XX  
578. gen combined_pl`=increase_XX'_temp_`l'_`i'_XX=0
579.                 
. forvalues j=1/`count_controls'{
580. forvalues k=1/`count_controls'{         
581.         
. capture drop in_brackets_pl_`l'_`j'_`k'_temp_XX
582. //// CHANGE BELOW - tks + Changes Diego 27-03-25: remove N_c_`l'_XX from formula below, since we have adjusted inv_Denom above
> gen in_brackets_pl_`l'_`j'_`k'_temp_XX = inv_Denom_`l'_XX[`j',`k'] * in_sum_`k'_`l'_XX * (d_sq_int_XX == `l' & F_g_XX>=3)
583. ////
> replace in_brackets_pl_`l'_`j'_XX=in_brackets_pl_`l'_`j'_XX+in_brackets_pl_`l'_`j'_`k'_temp_XX
584. }
585. 
. replace in_brackets_pl_`l'_`j'_XX=in_brackets_pl_`l'_`j'_XX - coefs_sq_`l'_XX[`j',1]
586. 
. capture drop combined_pl`=increase_XX'_temp_`l'_`j'_`i'_XX 
587. gen combined_pl`=increase_XX'_temp_`l'_`j'_`i'_XX=M_pl`=increase_XX'_`l'_`j'_`i'_XX*in_brackets_pl_`l'_`j'_XX
588. 
. replace combined_pl`=increase_XX'_temp_`l'_`i'_XX=combined_pl`=increase_XX'_temp_`l'_`i'_XX+combined_pl`=increase_XX'_temp_`l'_`j'_`i'_XX
589. } 
590. 
. replace part2_pl_switch`=increase_XX'_`i'_XX=part2_pl_switch`=increase_XX'_`i'_XX+combined_pl`=increase_XX'_temp_`l'_`i'_XX
591. } // MODIF FELIX
592. } // end loop oveer l
593. 
. }       
594. 
. bys group_XX: gegen U_Gg_pl_`i'_var_XX=total(U_Gg_pl_`i'_temp_var_XX)
595. 
. // Modeif Felix 21.03.2025 (adjust order of adding additional term and summing across t)
. if "`controls'"!=""{
596.         if `=increase_XX'==1{
597.         replace U_Gg_pl_`i'_var_XX=U_Gg_pl_`i'_var_XX - part2_pl_switch1_`i'_XX 
598.         }
599. 
.         if `=increase_XX'==0{
600.         //// CHANGE BELOW - tks (change plus to minus since final sign flip won't be until later)
>         replace U_Gg_pl_`i'_var_XX=U_Gg_pl_`i'_var_XX - part2_pl_switch0_`i'_XX         
601.         }
602. }
603. 
. }
604. 
. ////////// 7. Computing adjustements for the normalized and trends_lin options for placebos
> ////////// (similar to part 4, not commented) 
> 
. if "`normalized'"!=""{
605.         
.         capture drop sum_treat_until_`i'_pl_XX
606.         capture drop delta_D_pl_`i'_cum_temp_XX
607. 
.         if `continuous'==0{
608.         bys group_XX : gegen sum_treat_until_`i'_pl_XX = total(treatment_XX - d_sq_XX) if time_XX>=F_g_XX&time_XX<=F_g_XX-1+`i'& S_g_XX
> ==increase_XX
609.         } // FELIX 18.03.2025 (delete the diff_y_pl_`i'_XX!=. condition)
610. 
.         else if `continuous'>0{
611.                 bys group_XX : gegen sum_treat_until_`i'_pl_XX = total(treatment_XX_orig - d_sq_XX_orig) if time_XX>=F_g_XX&time_XX<=F_
> g_XX-1+`i'&S_g_XX==increase_XX
612.         } // FELIX 18.03.2025 (delete the diff_y_pl_`i'_XX!=. condition)
613. 
. gen delta_D_pl_`i'_cum_temp_XX = N_gt_XX/N`=increase_XX'_placebo_`i'_XX*[sum_treat_until_`i'_pl_XX* S_g_XX + (1-S_g_XX)*(-sum_treat_until_
> `i'_pl_XX)] if dist_to_switch_pl_`i'_XX==1
614. 
.         sum  delta_D_pl_`i'_cum_temp_XX
615.         scalar delta_norm_pl_`i'_XX = r(sum)
616. }
617. 
. 
. 
. } // End of the loop over l_placebo_u_a_XX.
618. }
619. 
. scalar Ntrendslin_pl=1
620. forvalue i=1/`=l_placebo_u_a_XX' {
621. scalar Ntrendslin_pl=min(Ntrendslin_pl , N`=increase_XX'_placebo_`i'_XX )
622. }
623. 
. 
. if "`trends_lin'"!="" & Ntrendslin_pl != 0 {
624.         
.         capture drop U_Gg_pl_`=l_placebo_u_a_XX'_TL
625.         capture drop U_Gg_pl_`=l_placebo_u_a_XX'_var_TL
626.         
.         gen U_Gg_pl_`=l_placebo_u_a_XX'_TL = 0
627.         gen U_Gg_pl_`=l_placebo_u_a_XX'_var_TL = 0
628. 
.         forvalue i=1/`=l_placebo_u_a_XX'{
629.                 replace U_Gg_pl_`=l_placebo_u_a_XX'_TL = U_Gg_pl_`=l_placebo_u_a_XX'_TL + U_Gg_placebo_`i'_XX
630.                 replace U_Gg_pl_`=l_placebo_u_a_XX'_var_TL = U_Gg_pl_`=l_placebo_u_a_XX'_var_TL + U_Gg_pl_`i'_var_XX
631.         
.         }
632.         
.         replace U_Gg_placebo_`=l_placebo_u_a_XX'_XX = U_Gg_pl_`=l_placebo_u_a_XX'_TL
633.         replace U_Gg_pl_`=l_placebo_u_a_XX'_var_XX =U_Gg_pl_`=l_placebo_u_a_XX'_var_TL
634. 
. }
635. } //End of condition checking if at least one placebo requested.
636. 
. 
. ////////// 8. Computing Average Total Effect estimator
> 
. ///// Average total effect not estimated if trends_lin option requested:
> if "`trends_lin'"==""{
637. 
. ///// Computing the sum of the N1_`i'_XX for the weights w. 
> scalar sum_N`=increase_XX'_l_XX = 0
638. forvalue i=1/`=l_u_a_XX'{
639.         scalar sum_N`=increase_XX'_l_XX = sum_N`=increase_XX'_l_XX + N`=increase_XX'_`i'_XX
640. }       
641. 
. ///// Dropping/Initializing needed variables
> capture drop U_Gg_XX
642. capture drop U_Gg_num_XX
643. capture drop U_Gg_den_XX
644. capture drop U_Gg_num_var_XX
645. capture drop  U_Gg_var_XX
646. gen U_Gg_num_XX=0
647. gen U_Gg_den_XX=0
648. gen U_Gg_num_var_XX=0
649. 
. 
. forvalue i=1/`=l_u_a_XX'{
650.         
. if (N`=increase_XX'_`i'_XX!=0){
651. capture drop delta_D_`i'_temp_XX
652. capture drop delta_D_`i'_XX
653.                  
. ///// Computing the weights w_+,l
> scalar w_`i'_XX = N`=increase_XX'_`i'_XX / sum_N`=increase_XX'_l_XX
654.                 
. ///// Computing the delta_D_+,l", which enter in the denominator of \hat{\delta}_+/\hat{\delta}_-.
> 
. if `continuous'==0{
655. gen delta_D_`i'_temp_XX = N_gt_XX/N`=increase_XX'_`i'_XX*[(treatment_XX-d_sq_XX)* S_g_XX + (1-S_g_XX)*(d_sq_XX-treatment_XX)] if distan
> ce_to_switch_`i'_XX==1
656. }
657. // Redefine this with original treatment if continuous option specified (treatment was binarized and staggerized)
. else if `continuous'>0{
658. gen delta_D_`i'_temp_XX = N_gt_XX/N`=increase_XX'_`i'_XX*[(treatment_XX_orig-d_sq_XX_orig)* S_g_XX + (1-S_g_XX)*(d_sq_XX_orig-treatment
> _XX_orig)] if distance_to_switch_`i'_XX==1       
659. }       
660. 
. // For the average cumulative effect we want to keep delta_D_`i'_temp_XX and rescale it by N`=increase_XX'_`i'_XX/N_gt_XX to get an unweig
> htened version of [D_{g,Fg-1+l} - D_{g,1}]    
. // Maybe call it delta_D_g_`i'_XX instead of delta_D_`i'_temp_XX and then keep it?      
. capture drop delta_D_g_`i'_XX
661. replace delta_D_`i'_temp_XX=0 if delta_D_`i'_temp_XX==.
662. gegen delta_D_`i'_XX = total(delta_D_`i'_temp_XX)
663. gen delta_D_g_`i'_XX=delta_D_`i'_temp_XX * (N`=increase_XX'_`i'_XX/N_gt_XX)
664. drop delta_D_`i'_temp_XX        
665.         
. ///// Computing the numerator of U^+_{G,g}: summing up the U_{G,g,l}s, after weighting them
> bys group_XX : replace U_Gg_num_XX = U_Gg_num_XX + w_`i'_XX * U_Gg`i'_XX
666. 
. ///// Computing the numerator of the "alternative" U_{G,g}s for the variance : summing up the U_{G,g,l}_vars, after weighting them
> bys group_XX : replace U_Gg_num_var_XX = U_Gg_num_var_XX + w_`i'_XX * U_Gg`i'_var_XX
667. 
. ///// Computing the denominator of U^+_{G,g}: summing up the delta^D_{+,l}s, after weighting them
> bys group_XX : replace U_Gg_den_XX = U_Gg_den_XX + w_`i'_XX * delta_D_`i'_XX
668. 
. }
669. 
. }
670.                 
. ///// Computing the U_+_(G,g)s".
> bys group_XX : gen U_Gg_XX = U_Gg_num_XX/U_Gg_den_XX
671. 
. ///// Computing the U^+_{G,g}_vars.
> bys group_XX : gen U_Gg_var_XX = U_Gg_num_var_XX/U_Gg_den_XX 
672. 
. }
673. }
674.  // end of the quietly condition
.         
. end

