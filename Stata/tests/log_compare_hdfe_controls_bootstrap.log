.         foreach v in `rownames_het' {
2126.                 local het_rown "`het_rown' `1':`v'"
2127.         }
2128.         
.         foreach i in `all_effects_XX_e'{ // Modif Felix (delta_XX error)
2129.                 local nc = rowsof(effect_het_`i'_XX)
2130.                 local nv = rowsof(V)
2131.                 mat V`i' = J(`nc', `nc', 0)
2132.                 forv j = 1/`nc' {
