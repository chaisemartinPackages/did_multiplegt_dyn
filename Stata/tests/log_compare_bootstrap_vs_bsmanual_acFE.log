  6. if "`trends_lin'" != ""{
  7.         replace prod_het_pl_`i'_XX=prod_het_pl_`i'_XX-`i'*(Yg_Fg_min_1_XX-Yg_Fg_min_2_XX)
  8. }
  9. replace prod_het_pl_`i'_XX=S_g_het_XX*prod_het_pl_`i'_XX
 10. 
. * keep one observation by group to not artificially increase sample
. bys group_XX: replace prod_het_pl_`i'_XX = . if switcher_tag_XX != `i' // Change by DAC to fix issue with the
>  number of units
 11. 
. // Run regression of interest
. local reg_pl_failed_XX = 1
 12. if "`trends_nonparam'" == "" {
 13. capture reg prod_het_pl_`i'_XX `predict_het_good' F_g_XX#d_sq_group_XX#S_g_XX [aw=N_gt_XX] if F_g_XX-1+`i'
> <=T_g_XX, level(`ci_level') vce(`ses') // leave the F_g_XX-1+`i'<=T_g_XX condition as it is to ensure that we
>  only use treated groups or is this already taken into account by the S_g_XX?
 14. local reg_pl_failed_XX = _rc
 15. }
 16. if "`trends_nonparam'" != "" {
 17. gegen trends_nonparam_temp_XX=group(`trends_nonparam')
 18. capture reg prod_het_pl_`i'_XX `predict_het_good' F_g_XX#d_sq_group_XX#S_g_XX#trends_nonparam_temp_XX [aw=
> N_gt_XX] if F_g_XX-1+`i'<=T_g_XX, level(`ci_level') vce(`ses')
 19. local reg_pl_failed_XX = _rc
 20. capture drop trends_nonparam_temp_XX
 21. }
 22. 
. // Retrieve the results from the regression only if it succeeded
. if `reg_pl_failed_XX' == 0 {
 23. forvalues j=1/`:word count `predict_het_good''{
 24.         scalar beta_het_`j'_pl`i'_hat_XX=_b["`: word `j' of `predict_het_good''"]
 25.         scalar se_het_`j'_pl`i'_hat_XX=_se["`: word `j' of `predict_het_good''"]
 26.         scalar lb_het_`j'_pl`i'_hat_XX=_b["`: word `j' of `predict_het_good''"]+invt(e(N)-e(df_m)-1,0.025)
> *_se["`: word `j' of `predict_het_good''"]
 27.         scalar ub_het_`j'_pl`i'_hat_XX=_b["`: word `j' of `predict_het_good''"]+invt(e(N)-e(df_m)-1,0.975)
> *_se["`: word `j' of `predict_het_good''"]
 28.         scalar t_het_`j'_pl`i'_hat_XX=scalar(beta_het_`j'_pl`i'_hat_XX)/scalar(se_het_`j'_pl`i'_hat_XX)
 29. }
 30. scalar N_het_pl_`i'_hat_XX=e(N)
 31. 
. // Add F-test on joint significance
. test `predict_het_good'
 32. scalar p_het_pl_`i'_hat_XX=r(p)
 33. scalar F_het_pl_`i'_hat_XX=r(F)
 34. }
 35. }
. }
. 
. // Generate results matrix
. foreach i in `all_effects_XX'{
  2. matrix effect_het_pl_`i'_XX=J(`:word count `predict_het_good'',6,.)
  3. 
. local effect_het_pl_rownames_`i'_XX ""
  4. 
. forvalue j=1/`:word count `predict_het_good''{
  5. matrix effect_het_pl_`i'_XX[`j',1]=scalar(beta_het_`j'_pl`i'_hat_XX)
  6. matrix effect_het_pl_`i'_XX[`j',2]=scalar(se_het_`j'_pl`i'_hat_XX)
  7. matrix effect_het_pl_`i'_XX[`j',3]=scalar(t_het_`j'_pl`i'_hat_XX)
  8. matrix effect_het_pl_`i'_XX[`j',4]=scalar(lb_het_`j'_pl`i'_hat_XX)
  9. matrix effect_het_pl_`i'_XX[`j',5]=scalar(ub_het_`j'_pl`i'_hat_XX)
 10. matrix effect_het_pl_`i'_XX[`j',6]=scalar(N_het_pl_`i'_hat_XX)
 11. 
. // Generate local with rownames
. local pl_het_rownames_`i'_XX "`pl_het_rownames_`i'_XX' "`: word `j' of `predict_het_good''""
 12. }
 13. 
. // Assign names
. matrix colnames effect_het_pl_`i'_XX= "Estimate" "SE" "t" "LB CI" "UB CI" "N"
 14. matrix rownames effect_het_pl_`i'_XX=`pl_het_rownames_`i'_XX'
 15. 
. }
. 
. // Output the table
. display _newline
. di "{hline 80}"
. di _skip(18) "{bf:Predicting effect heterogeneity - Placebos}"
. if "`by'" !=""{
. * Add description with the by variable level if by is specified         
. di _skip(35) "{bf:By: `by' = `val_lab_int_XX'}"
. }       
. di "{hline 80}"
. 
. // output only the specified effects
. foreach i in `all_effects_XX'{
  2. display _newline
  3. di "{hline 80}" 
  4. di _skip(37) "{bf:Placebo_`i'}"
  5. di "{hline 80}"
  6. matlist effect_het_pl_`i'_XX
  7. di "{hline 80}"
  8. di as text "{it:Test of joint nullity of the estimates : p-value =} " p_het_pl_`i'_hat_XX
  9. }
