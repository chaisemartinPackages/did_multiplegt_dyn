. if `=l_placebo_XX'>0{
1305. matrix didmgt_results_no_avg2_XX=J(`=l_placebo_XX',1,.)
1306. matrix didmgt_results_no_avg2_XX=mat_res_XX[`=l_XX'+2 .. `=l_XX'+`=l_placebo_XX'+1,1]
1307. matrix didmgt_results_no_avg_XX = didmgt_results_no_avg1_XX \ didmgt_results_no_avg2_XX
1308. }
1309. 
. matrix didmgt_results_no_avg_XX=didmgt_results_no_avg_XX'
1310. 
. capture matrix drop didmgt_results_no_avg1_XX didmgt_results_no_avg2_XX
1311. 
. //// Manual cluster bootstrap (temporary option). When bootstrap_manual is set,
> //// we do our own bootstrap loop: sample clusters with replacement, reweight
> //// N_gt_XX by the per-rep cluster count, and re-run the estimation via a
> //// recursive did_multiplegt_dyn call. This reweighting approach gives
> //// well-defined bootstrap variance on the hdfe_controls path (the standard
> //// physical-duplication bootstrap is degenerate there because reghdfe + unit
> //// FE absorbs cluster-level resampling variation).
> if `bootstrap_manual_B_XX' != 0 {
1312. 
.         * === Resolve the cluster variable for the resample ===
.         local _bm_cluster_XX ""
1313.         if "`cluster'" != "" {
1314.                 local _bm_cluster_XX "`cluster'"
1315.         }
1316.         else {
1317.                 local _bm_cluster_XX "`2'"
1318.         }
1319. 
.         * === Save state we'll need to restore between reps ===
.         matrix mat_res_bs_XX = mat_res_XX
1320.         qui tempfile data_pre_bootstrap_XX
1321.         qui save "`data_pre_bootstrap_XX'.dta", replace
1322. 
.         * === Get the cluster-resample CSV from the standalone sampler ===
.         qui tempfile _bm_csv_XX
1323.         local _bm_csv_path_XX "`_bm_csv_XX'.csv"
1324.         did_multiplegt_dyn_bootsample, cluster(`_bm_cluster_XX') reps(`bootstrap_manual_B_XX') seed(`bootstrap_manual_seed_XX') saving
> ("`_bm_csv_path_XX'")
1325. 
.         * === Build storage for per-rep estimates ===
.         * Each row = one parameter, each column = one rep
.         local _bm_neff_XX = l_XX
1326.         local _bm_npl_XX  = l_placebo_XX
1327.         local _bm_nparam_XX = `_bm_neff_XX' + `_bm_npl_XX' + 1
1328.         matrix _bm_reps_XX = J(`bootstrap_manual_B_XX', `_bm_nparam_XX', .)
1329.         local _bm_failed_XX = 0
1330. 
.         * === Save the user's original weight macro for restoration ===
.         local _bm_user_weight_XX "`weight'"
1331.         local _bm_user_weight_var_XX ""
1332.         if "`weight'" != "" {
1333.                 local _bm_user_weight_var_XX "`weight'"
1334.         }
1335. 
.         * === Bootstrap rep loop ===
.         forvalues _bm_rep_XX = 1/`bootstrap_manual_B_XX' {
1336. 
.                 * (i) Import this rep's column from the CSV into a tempfile.
.                 *     We avoid `preserve` here because the main program already has
.                 *     an active preserve from earlier; nested preserves are illegal.
.                 qui import delimited using "`_bm_csv_path_XX'", clear
1337.                 qui keep cluster_id rep_`_bm_rep_XX'
1338.                 qui rename cluster_id `_bm_cluster_XX'
1339.                 qui rename rep_`_bm_rep_XX' _bm_count_XX
1340.                 tempfile _bm_rep_data_XX
1341.                 qui save "`_bm_rep_data_XX'", replace
1342. 
.                 * (ii) Load fresh original data and merge in this rep's per-cluster counts.
.                 qui use "`data_bootstrap_XX'.dta", clear
1343.                 qui merge m:1 `_bm_cluster_XX' using "`_bm_rep_data_XX'", nogen keep(match master)
1344.                 qui replace _bm_count_XX = 0 if missing(_bm_count_XX)
1345. 
.                 * (iii) build the single bootstrap weight = original_weight * count
.                 capture drop _bm_weight_XX
1346.                 if "`_bm_user_weight_var_XX'" == "" {
1347.                         gen double _bm_weight_XX = _bm_count_XX
1348.                 }
1349.                 else {
1350.                         gen double _bm_weight_XX = `_bm_user_weight_var_XX' * _bm_count_XX
1351.                 }
1352. 
.                 * (iv) recursive did_multiplegt_dyn call with the reweighted weight.
.                 * Use cap to tolerate reps that fail (e.g., reghdfe singularity).
.                 capture qui did_multiplegt_dyn `1' `2' `3' `4', ///
>                         effects(`effects') placebo(`placebo')                                ///
>                         `same_switchers' switchers(`switchers') `only_never_switchers'       ///
>                         controls(`controls') trends_nonparam(`trends_nonparam')              ///
>                         weight(_bm_weight_XX)                                                ///
>                         `dont_drop_larger_lower' `drop_if_d_miss_before_first_switch'        ///
>                         `normalized' `same_switchers_pl' `trends_lin'                        ///
>                         continuous(`continuous') hdfe_controls(`hdfe_controls')              ///
>                         cluster(`cluster') graph_off _no_updates
1353. 
.                 if _rc != 0 {
1354.                         local _bm_failed_XX = `_bm_failed_XX' + 1
1355.                         drop _bm_count_XX
1356.                         continue
1357.                 }
1358. 
.                 * (v) capture this rep's estimates into the storage matrix
.                 forvalues _bm_i_XX = 1/`_bm_neff_XX' {
1359.                         capture local _bm_val_XX = e(Effect_`_bm_i_XX')
1360.                         if _rc == 0 {
1361.                                 matrix _bm_reps_XX[`_bm_rep_XX', `_bm_i_XX'] = `_bm_val_XX'
1362.                         }
1363.                 }
1364.                 forvalues _bm_i_XX = 1/`_bm_npl_XX' {
1365.                         capture local _bm_val_XX = e(Placebo_`_bm_i_XX')
1366.                         if _rc == 0 {
1367.                                 matrix _bm_reps_XX[`_bm_rep_XX', `_bm_neff_XX' + `_bm_i_XX'] = `_bm_val_XX'
1368.                         }
1369.                 }
1370.                 capture local _bm_val_XX = e(Av_tot_effect)
1371.                 if _rc == 0 {
1372.                         matrix _bm_reps_XX[`_bm_rep_XX', `_bm_nparam_XX'] = `_bm_val_XX'
1373.                 }
1374. 
.                 drop _bm_count_XX
1375.         }
1376. 
.         * === Report failed reps ===
.         if `_bm_failed_XX' > 0 {
1377.                 di as text ""
1378.                 di as text "bootstrap_manual: `_bm_failed_XX' of `bootstrap_manual_B_XX' reps failed and were skipped."
1379.         }
1380. 
.         * === Compute bootstrap SE + covariance from per-rep matrix ===
.         * Drop rows that are all missing (failed reps)
.         mata: _bm_reps = st_matrix("_bm_reps_XX")
1381.         mata: _bm_keep = !rowmissing(_bm_reps)
1382.         mata: _bm_reps = select(_bm_reps, _bm_keep)
1383.         mata: st_local("_bm_B_eff_XX", strofreal(rows(_bm_reps)))
1384.         mata: _bm_mean = mean(_bm_reps)
1385.         mata: _bm_dev  = _bm_reps :- _bm_mean
1386.         mata: _bm_cov  = (_bm_dev' * _bm_dev) / (rows(_bm_reps) - 1)
1387.         mata: _bm_se   = sqrt(diagonal(_bm_cov))
1388.         mata: st_matrix("bs_var_cov_XX", _bm_cov)
1389.         mata: st_matrix("_bm_se_XX",    _bm_se)
1390. 
.         * === Populate the bootstrap SE matrices the downstream code reads ===
.         matrix se_eff_bs_XX = J(`_bm_neff_XX', 1, .)
1391.         forvalues _bm_i_XX = 1/`_bm_neff_XX' {
1392.                 matrix se_eff_bs_XX[`_bm_i_XX', 1] = _bm_se_XX[`_bm_i_XX', 1]
1393.         }
1394.         if `_bm_npl_XX' > 0 {
1395.                 matrix se_pl_bs_XX = J(`_bm_npl_XX', 1, .)
1396.                 forvalues _bm_i_XX = 1/`_bm_npl_XX' {
1397.                         matrix se_pl_bs_XX[`_bm_i_XX', 1] = _bm_se_XX[`_bm_neff_XX' + `_bm_i_XX', 1]
1398.                 }
1399.         }
1400.         matrix se_avg_eff_bs_XX = _bm_se_XX[`_bm_nparam_XX', 1]
1401. 
.         * === Make bs_var_cov_XX look like the e(V) layout Stata's bootstrap produces ===
.         * Stata's bootstrap names rows/cols _bs_1, _bs_2, ... Downstream code at
.         * lines 2611 and 2744 selects submatrices via those names.
.         local _bm_rcnames_XX ""
1402.         forvalues _bm_i_XX = 1/`_bm_nparam_XX' {
1403.                 local _bm_rcnames_XX "`_bm_rcnames_XX' _bs_`_bm_i_XX'"
1404.         }
1405.         matrix rownames bs_var_cov_XX = `_bm_rcnames_XX'
1406.         matrix colnames bs_var_cov_XX = `_bm_rcnames_XX'
1407. 
.         * === Set bootstrap_XX so the existing SE override / joint test code fires ===
.         local bootstrap_XX = `bootstrap_manual_B_XX' - `_bm_failed_XX'
1408. 
.         * === Restore pre-bootstrap data so the rest of the program continues ===
.         use "`data_pre_bootstrap_XX'.dta", clear
1409.         matrix mat_res_XX = mat_res_bs_XX
1410. }
1411. 
. //// Add bootstrap
> if `bootstrap_XX'!=0 & `bootstrap_manual_B_XX' == 0 {
1412. 
.         // Save "pre-bootstraped" results matrix so it does not get overwritten
.         matrix mat_res_bs_XX=mat_res_XX
1413.         
.         // Save "pre-bootstrap" data 
.         qui tempfile data_pre_bootstrap_XX
1414.         qui save "`data_pre_bootstrap_XX'.dta", replace
1415.         
.         // Load original data 
.         use "`data_bootstrap_XX'.dta", clear
1416.         
.         // gen numlists
.         numlist "1/`=l_XX'"
1417.         local num_eff_XX "`r(numlist)'"
1418.         // Adjust for missings
.         local num_eff_XX: list num_eff_XX- missing_eff_XX
1419.         
.         if `=l_placebo_XX'>0{
1420.         numlist "1/`=l_placebo_XX'"
1421.         local num_pl_XX "`r(numlist)'"
1422.         // Adjust for missings
.         local num_pl_XX: list num_pl_XX- missing_pl_XX
1423.         }
1424.         
.         //Store the coefficients to bootstrap
.         local coefs ""
1425.         foreach i of numlist `num_eff_XX'{
1426.                 local coefs = "`coefs' e(Effect_`i')"
1427.         }
1428.         
.         if `=l_placebo_XX'>0{
1429.         foreach i of numlist `num_pl_XX'{
1430.                 local coefs = "`coefs' e(Placebo_`i')"
1431.         }
1432.         }
1433.         
.         if "`trends_lin'"==""{
1434.         local coefs "`coefs' e(Av_tot_effect)"
1435.         }
1436.         
.         xtset, clear // need this to ensure bootstrap is running correctly
1437.         
.         // Save pre-bootstraped coefficients matrix for residualization (controls) and matrix for the actual coefficient matrix to be used
>  in the ereturn post
.         if "`hdfe_controls'" == "" {
1438.         foreach u of local levels_d_sq_XX {
1439.                 matrix coefs_sq_bs_`u'_XX = coefs_sq_`u'_XX
1440.         }
1441.         }
1442.         matrix didmgt_bs_results_no_avg_XX=didmgt_results_no_avg_XX // Modif Felix
1443.         
.         // Modif Felix: Ensure that we do not add missings in this process
.         gen existing_pre_XX=1
1444.         
.         // Save pre-bootstraped scalars 
.         mata: scalars_XX = st_dir("global", "numscalar", "*_XX")        
1445.         getmata (scalars_XX*) = scalars_XX, force                                       
1446.         // Fix this by counting the number of observations before and after we add all the scalars in and then delete the additional c
> ells we might add!!!                              
.         
.         levelsof(scalars_XX), local(scalars_save)
1447.         foreach w of local scalars_save {
1448.                 local k = subinstr("`w'","_XX","_XY",.)
1449.                 scalar `k' = `w'
1450.         }
1451.         capture drop scalars_XX* 
1452.         
.                 
.         // Modif Felix: Ensure that we do not add missings in this process
.         drop if existing_pre_XX==.
1453.         drop existing_pre_XX
1454.         
.         global bootstrap_on_XX "yes"
1455. 
.         * On the hdfe path, add idcluster so each cluster appearance in a
.         * resample gets a fresh ID. The recursive call combines _bs_id_XX
.         * with the user's group var to produce distinct unit IDs per clone,
.         * which keeps xtset / reghdfe well-defined inside reps. OLD path
.         * keeps no idcluster (bit-exact preservation of validated behavior).
