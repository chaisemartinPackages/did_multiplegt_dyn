data <- merge(data, sch.aux, all.x=TRUE, by = c("pc11_s_id", "pc11_d_id", "pc11_sd_id"))
table(data$sch)
data[, prod_tree_am := as.integer(interaction(tree.mcq_am, tot.prod_am, sep = "_", drop = TRUE))]
data[, prod_agri_am := as.integer(interaction(peragri_am, tot.prod_am, sep = "_", drop = TRUE))]
data[, agri_tree_am := as.integer(interaction(peragri_am, tree.mcq_am, sep = "_", drop = TRUE))]
################################################################################
################################################################################
####################### Importing Protected Areas ##############################
pr.area <- fread(file.path( micro, "protected_areas_sd.csv"))
data <- merge(data, pr.area, all.x=TRUE, by = c("pc11_s_id", "pc11_d_id", "pc11_sd_id"))
names(data)
data[is.na(protected_areas_sd), ]$protected_areas_sd <- 0
data[is.na(protected_areas_sd_10km), ]$protected_areas_sd_10km <- 0
data$protected_areas_sd <- data$protected_areas_sd+1
data$protected_areas_sd_10km <- data$protected_areas_sd_10km+1
table(data$protected_areas_sd_10km)
table(data$protected_areas_sd)
borders <- fread(file.path( micro, "sd_in_international_border.csv"))
data <- merge(data, borders, all.x=TRUE, by = c("pc11_s_id", "pc11_d_id", "pc11_sd_id"))
data[is.na(inborder), ]$inborder <- 0
path <- file.path(micro, "_redo_datagen.csv")
fwrite(data, path)
################################################################################
cols_cum_conflicts <- names(data)[startsWith(names(data), "cum_conflicts")]
cols_cum_conflicts
colvars <- c(  "peragri", "tree.mcq" )
# Store plots
all_plots <- list()
# Loop over variables
for (yvar in colvars) {
print(yvar)
plots_yvar <- list()
for (qtype in c( "none", "t", "q", 'd')) {
data.aux <- copy(data)[allobs == 1]
if (qtype %in% c("q", "t", "d")) {
# Quantile-based covariates
qcol <- paste0(yvar, "_", qtype)
cats <- sort(unique(data.aux[[qcol]], na.rm = TRUE))
dummy_names <- paste0(qcol, cats)
data.aux[, (dummy_names) := lapply(cats, function(k) as.integer(get(qcol) == k))]
xformla <- as.formula(
paste0("~ ", paste(dummy_names, collapse = " + "), " -1")
)
label <- paste0("(", toupper(qtype), ")")
} else if (qtype == '2010') {
qcol <- paste0(yvar, qtype)
xformla <- as.formula(
paste0("~ ", qcol, " + 1")
)
label <- paste0("(", toupper(qtype), ")")
} else{
# No covariates (just intercept)
xformla <- ~1
label <- "(No Covariates)"
}
# ATT estimation
out <- att_gt(
yname         = yvar,
gname         = "min_year_post_ror",
idname        = "subdistrict_id",
tname         = "year",
xformla       = xformla,
data          = data.aux,
base_period   = "universal",
est_method    = "dr",
cluster       = "subdistrict_id",
control_group = c('nevertreated',"notyettreated")
)
# Aggregation
es  <- aggte(out, type = "dynamic", min_e = -10, max_e = 10, na.rm = TRUE)
ate <- es$overall.att
se  <- es$overall.se
y0  <- data.aux[year == 2010, mean(get(yvar), na.rm = TRUE)]
ymin <- min(-2, min(es$att.egt - 1.96 * es$se.egt, na.rm = TRUE) - 1)
ymax <- max( 2, max(es$att.egt + 1.96 * es$se.egt, na.rm = TRUE) + 1)
if ( (yvar == "peragri")  & (k==3) & ( filter_var == "agri_tree_am") ){
yvalueax <- 3
} else{
yvalueax <- Inf
}
# plot with extra annotation for nrows
p1 <- ggdid(es, xgap = 2) +
ggtitle("") +
annotate("text", x = -10, y = yvalueax,
label = sprintf("ATE = %.3f (%.3f)", ate, se),
hjust = 0, vjust = 2, size = 7) +
annotate("text", x = -10, y = yvalueax,
label = sprintf("Y0  = %.3f", y0),
hjust = 0, vjust = 4, size = 7) +
coord_cartesian(ylim = c(ymin, ymax)) +   # 🔹 dynamic but bounded range
theme(
axis.title.x = element_text(size = 20),
axis.title.y = element_text(size = 20),
axis.text.x  = element_text(size = 18),
axis.text.y  = element_text(size = 18),
legend.position = "none"
)
# Save plot
ggsave(
filename = file.path(out_dir, sprintf("plot_%s_%s_decom.png", yvar, qtype)),
plot   = p1,
width  = 8,
height = 6,
dpi    = 300
)
}
}
