1125.         }
1126.         
.         sum count_global_XX_w
1127.         scalar N_effect_XX_w=r(sum)
1128.         matrix mat_res_XX[l_XX+1,5]=scalar(N_effect_XX_w)
1129.         ereturn scalar N_avg_total_effect_w = scalar(N_effect_XX_w)
1130. }
1131. 
. // Add time_to_treat to the results matrix even when computation of average total effect skipped with trends_lin, important fot the graph 
