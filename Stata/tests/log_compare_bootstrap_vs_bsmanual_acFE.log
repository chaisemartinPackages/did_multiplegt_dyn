279.                 gen cluster_dof_`i'_s_XX = `cluster' if dof_s_`i'_XX == 1
280.                 bys d_sq_XX F_g_XX d_fg_XX `trends_nonparam': gegen dof_cohort_`i'_s_t_XX = nunique(cluster_dof_`i'_s_XX) if !missing(c
> luster_dof_`i'_s_XX)
281.         }
282. }
283. }
