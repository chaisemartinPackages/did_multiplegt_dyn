. capture drop diff_y_`i'_N_gt_XX
251. gen diff_y_`i'_N_gt_XX=N_gt_XX*diff_y_`i'_XX
252. 
. capture drop dof_ns_`i'_XX
253. gen dof_ns_`i'_XX = (N_gt_XX != 0&diff_y_`i'_XX!=.&never_change_d_`i'_XX==1&N`=increase_XX'_t_`i'_XX>0&N`=increase_XX'_t_`i'_XX!=.)
254. capture drop dof_s_`i'_XX
255. gen dof_s_`i'_XX = (N_gt_XX != 0&distance_to_switch_`i'_XX==1)
