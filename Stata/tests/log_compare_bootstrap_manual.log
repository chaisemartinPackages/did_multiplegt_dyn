. ////////// 9. Event study graph
> 
. ///// Producing a graph
> qui {
2790. 
. // Initialize color pattern for multiple graphs wihen by is specified 
. local col1 "midblue"
2791. local col2 "midblue" 
2792. local col3 "red"  
2793. local col4 "red" 
2794. local col5 "green" 
2795. local col6 "green"    
2796. local col7 "magenta" 
2797. local col8 "magenta"   
2798. local col9 "gold"   
2799. local col10 "gold"    
2800. local col11 "lime" 
2801. local col12 "lime"      
2802. 
. local graph_input ""
2803. local graph_options ""
2804. local graph_options_int ""
2805. 
. if "`by'" ==""|scalar(by_XX)==0{
2806. *Version with only one event study graph        
. // Translate results matrix into data                   
. capture drop mat_res_XX1 mat_res_XX2 mat_res_XX3 mat_res_XX4 mat_res_XX5 mat_res_XX6 mat_res_XX7
2807. svmat mat_res_XX
2808. 
. // artificially replacing the result of average effect by 0
. forvalue index=1/6{
2809. replace mat_res_XX`index'=0 if mat_res_XX7==0 
2810. }
2811. 
. capture drop point_estimate
2812. capture drop se_point_estimate
2813. capture drop lb_CI_95
2814. capture drop up_CI_95
2815. capture drop N
2816. capture drop N_switchers
2817. capture drop time_to_treat
2818. 
. rename mat_res_XX1 point_estimate
2819. rename mat_res_XX2 se_point_estimate
2820. rename mat_res_XX3 lb_CI_95
2821. rename mat_res_XX4 up_CI_95
2822. rename mat_res_XX5 N
2823. rename mat_res_XX6 N_switchers
2824. rename mat_res_XX7 time_to_treat
2825. 
. 
. sort time_to_treat
2826. 
. // Define fixed graph options as they are implemented as flexible locals
. local graph_input "(connected point_estimate time_to_treat, lpattern(solid)) (rcap up_CI_95 lb_CI_95 time_to_treat)"
2827. local graph_options "legend(off)"
2828. 
. }
2829. 
. if "`by'" !=""{
2830.                 
. // Save tempfile because we will do sorting afterwards 
. tempfile before_graph_XX
2831. save "`before_graph_XX'.dta", replace           
2832. 
. // Create datasets from the results matrix for each level of the by variable            
. local cnt_XX=1
2833. local merge_count=1
2834. foreach l of local levels_byvar_XX {
2835. use "`before_graph_XX'.dta", clear              
2836.         
. capture drop mat_res_XX_by_`l'1 mat_res_XX_by_`l'2 mat_res_XX_by_`l'3 mat_res_XX_by_`l'4 mat_res_XX_by_`l'5 mat_res_XX_by_`l'6 mat_res_XX_
> by_`l'7
2837. svmat mat_res_XX_by_`l'
2838. 
. // artificially replacing the result of average effect by 0
. forvalue index=1/6{
2839. replace mat_res_XX_by_`l'`index'=0 if mat_res_XX_by_`l'7==0
2840. }
2841. 
. capture drop point_estimate_`l'
2842. capture drop se_point_estimate_`l'
2843. capture drop lb_CI_95_`l'
2844. capture drop up_CI_95_`l'
2845. capture drop N_`l'
2846. capture drop N_switchers_`l'
2847. capture drop time_to_treat
2848. 
. rename mat_res_XX_by_`l'1 point_estimate_`l'
2849. rename mat_res_XX_by_`l'2 se_point_estimate_`l'
2850. rename mat_res_XX_by_`l'3 lb_CI_95_`l'
2851. rename mat_res_XX_by_`l'4 up_CI_95_`l'
2852. rename mat_res_XX_by_`l'5 N_`l'
2853. rename mat_res_XX_by_`l'6 N_switchers_`l'
2854. rename mat_res_XX_by_`l'7 time_to_treat
2855. 
. 
. // pick CI color matching the line color
. local col_CI=`cnt_XX'+1
2856. 
. // Create a local that adjusts the graph automatically for ll the by levels
. local graph_input "`graph_input' (connected point_estimate_`l' time_to_treat, lpattern(solid) lcolor(`col`cnt_XX'') mcolor(`col`cnt_XX''))
>  (rcap up_CI_95_`l' lb_CI_95_`l' time_to_treat, lcolor(`col`col_CI''))" 
2857. 
. // Store value labels for the legend if they exist, show the level otherwise
. ds `by', has(vallabel)
2858. local `by'_has_vallabel_XX=r(varlist)
2859. if "``by'_has_vallabel_XX'"!="."{
2860.         local val_lab_int_XX "`: label ``by'_lab_XX' `l''"
2861. } 
2862. if "``by'_has_vallabel_XX'"=="."{
2863.         local val_lab_int_XX "`l'"
2864. }
2865. 
. // Automatcially adjust the legend for each additional graph from the by option
. local graph_options_int "`graph_options_int' `cnt_XX' "`by' = `val_lab_int_XX'""
2866. 
. // +2 to skip the CI's to get the correct color for the next event study graph
. local cnt_XX=`cnt_XX'+2
2867. 
. // Save the specific dataset needed for the graphs
. keep point_estimate_`l' se_point_estimate_`l' lb_CI_95_`l' up_CI_95_`l' N_`l' N_switchers_`l' time_to_treat
2868. tempfile graph_`l'_XX
2869. keep if time_to_treat!=. 
2870. *to allow time_to_treat as id of the dataset and use merge 1:1
. save "`graph_`l'_XX'.dta", replace      
2871. 
. // Merge the different datasts if there is more then one event study graph to be shown
. if `merge_count'==1{
2872.         use "`graph_`l'_XX'.dta", clear
2873.         sort time_to_treat
2874.         tempfile graph_merge_XX
2875.         save "`graph_merge_XX'.dta", replace
2876. }
2877. if `merge_count'>1{
2878.         use "`graph_merge_XX'.dta", clear
2879.         merge 1:1 time_to_treat using "`graph_`l'_XX'.dta"
2880.         capture drop _merge
2881.         tempfile graph_merge_XX
2882.         save "`graph_merge_XX'.dta", replace
2883. }       
2884. local merge_count=`merge_count'+1
2885. } // end of the differentlevels_byvar_XX loop
2886. 
. // Add universal graph options
. local graph_options "legend(pos(6) order(`graph_options_int') rows(1))"
2887. }       
2888. 
. }
2889. 
. // Event Study graph without any additional graph options
. if ("`graph_off'"==""){
2890. if "`graphoptions'"==""{
2891. twoway `graph_input', xlabel(`=-l_placebo_XX'[1]`=l_XX') xtitle("Relative time to last period before treatment changes (t=0)", size(la
> rge)) title("DID, from last period before treatment changes (t=0) to t", size(large)) graphregion(color(white)) plotregion(color(white)) `
> graph_options'
2892. }
2893. // Event Study graph with additional graph options
. else{
2894. global options="`graphoptions'"
2895. twoway `graph_input', $options
2896. }
2897. } // end graph_off
2898. 
. 
. ///// Saving the results if requested
> if "`save_results'"!=""{
2899. quietly{
2900. keep if time_to_treat!=.
2901. }
2902. 
. // keep main results
. if "`by'"==""{
2903. keep time_to_treat point_estimate se_point_estimate lb_CI_95 up_CI_95 N N_switchers
2904. }
2905. else if "`by'"!=""{
2906. keep time_to_treat point_estimate* se_point_estimate* lb_CI_95* up_CI_95* N* N_switchers*
2907. }
2908. 
. // Store information about the dataset
. label data "Stores did_multiplegt_dyn estimates' information: Type 'notes' for details." 
2909. local command_options_XX effects(`effects') placebo(`placebo') switchers(`switchers') `only_never_switchers' controls(`controls') tren
> ds_nonparam(`trends_nonparam') weight(`weight') `dont_drop_larger_lower' `normalized' cluster(`cluster') `same_switchers' `trends_lin' by(
> `by') predict_het(`predict_het') ci_level(`ci_level') design(`design') date_first_switch(`date_first_switch') continuous(`continuous') `le
> ss_conservative_se' `normalized_weights'
2910. notes : "{bf:{ul:Date of Run:}} `c(current_date)' at `c(current_time)'"
2911. notes : "{bf:{ul:Command Syntax:}} did_multiplegt `1' `2' `3' `4' `if' `in', `command_options_XX' "
2912. notes : "{bf:{ul:Path of the Used Dataset:}} `dataset_name_XX' "
2913. save "`save_results'", replace
2914. 
. }
2915. 
. display _newline
2916. di as text "The development of this package was funded by the European Union (ERC, REALLYCREDIBLE,GA N°101043899)."
2917. 
. // Restoring data
. restore
2918. 
. ///// When both save_sample and by were specified merge the different datasets for each level of the by variable into one dataset that wil
> l be in memory after the command ran
> if "`save_sample'" != "" { 
2919.         if "`by'"==""{
2920.         qui merge m:1 `2' `3' using `did_sample', gen(_merge_XX)
2921.         qui drop if _merge_XX == 2
2922.         qui drop _merge_XX
2923.         }
2924.         else if "`by'"!=""{
2925.         foreach l of local levels_byvar_XX {    
2926.         qui merge m:1 `2' `3' using `did_sample_`l'', gen(_merge_XX)
2927.         qui drop if _merge_XX == 2
2928.         qui drop _merge_XX      
2929.         }
2930.         }
2931. }
2932. end

