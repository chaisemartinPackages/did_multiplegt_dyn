1107. }
1108. sum count_global_XX
1109. scalar N_effect_XX=r(sum)
1110. matrix mat_res_XX[l_XX+1,5]=scalar(N_effect_XX)
1111. ereturn scalar N_avg_total_effect = scalar(N_effect_XX)
1112. 
. }
1113. 
. // Modif Felix weight
. if "`weight'"!=""{
