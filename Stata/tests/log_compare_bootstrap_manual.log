. ///// Option that shows a table with weights attached to each normalized effect
> if "`normalized_weights'" != "" {
2440.         qui {
2441.                 // Error as normalized_weights only works in combination with normalized
.                 if "`normalized'" == "" {
2442.                         noi di as err "normalized option required to compute normalized_weights"
2443.                         di as input _continue ""
2444.                         exit
2445.                 }
2446. 
.         // Set up the matrix for the output table
.         mat define weight_mat = J(`=l_XX + 1', `=l_XX', .)
2447.         local cols ""
2448. 
.         forv i = 1/`=l_XX'{     
2449.                 local m = "ℓ=`i'"
2450.                 local cols `cols' `m'
2451.                 gen N_gt_`i'_temp_XX = N_gt_XX if time_XX == F_g_XX - 1 + `i' & `i' <= L_g_XX & N_gt_control_`i'_XX > 0 & N_gt_control
> _`i'_XX != . & diff_y_`i'_XX != .
2452.                 gegen N_gt_`i'_XX = mean(N_gt_`i'_temp_XX), by(group_XX)
2453.                 drop N_gt_`i'_temp_XX
2454.                 forv k = 0/`=`i' - 1' {
2455.                         // Visualization by k
.                         local row = `k' + 1
2456.                         
.                         // Compute the delta_ℓ_k, if the continuous option is specified the original treatment values are used
.                         if `continuous'==0{
2457.                         gen delta_`i'_`k' = abs(treatment_XX - d_sq_XX) if time_XX == F_g_XX - 1 + `i' - `k' & F_g_XX - 1 + `i' <= T_g
> _XX
2458.                         }
2459.                         else if `continuous'>0{
2460.                         gen delta_`i'_`k' = abs(treatment_XX_orig - d_sq_XX_orig) if time_XX == F_g_XX - 1 + `i' - `k' & F_g_XX - 1 + 
> `i' <= T_g_XX
2461.                         }
2462.                         replace delta_`i'_`k' = delta_`i'_`k' * N_gt_`i'_XX
2463.                         // Filling the weight matrix 
.                         sum delta_`i'_`k'
2464.                         mat weight_mat[`row', `i'] = (`r(sum)' / scalar(delta_D_`i'_global_XX)) / scalar(N_switchers_effect_`i'_XX)
2465.                         //mat weight_mat[`row', `i'] = (`r(sum)' / `denom_`i'_norm_XX')
.                 }               
2466.                 drop N_gt_`i'_XX
2467.         }
2468.         
.         // Generating the row names 
.         // Visualization by k 
.         local rows ""
2469.         forv j = 1/`=l_XX' {
2470.                         local r = "k=`=`j'-1'"
2471.                         local rows `rows' `r'
2472.         }       
2473. 
.         local rows `rows' "Total"
2474.         
.         // Fill the values for the displayed table
.         matrix define mat_temp = J(`=l_XX', `=l_XX', 0) 
2475.         forv i = 1/`=l_XX' {
2476.                 forv j = 1/`=l_XX' {
2477.                         if weight_mat[`i', `j'] != . {
2478.                                 mat mat_temp[`i', `j'] = weight_mat[`i', `j']
2479.                         }
2480.                 }
2481.         }       
2482.         
.         // Getting the correct order
.         matrix define mat_total = mat_temp' * J(`=l_XX', 1, 1)
2483.         forv i = 1/`=l_XX' {
2484.                 mat weight_mat[`=l_XX+1', `i'] = mat_total[`i', 1]
2485.         }
2486.         
.         // Add row and column names
.         mat rown weight_mat = `rows'
2487.         mat coln weight_mat = `cols'    
2488.         }
2489. 
.         // Output the table
.         display _newline
2490.         di "{hline 70}"
2491.         di _skip(15) "{bf:Weights on treatment lags}"
2492.         if "`by'" !=""{ 
2493.         * Add description with the by variable level if by is specified 
.         di _skip(25) "{bf:By: `by' = `val_lab_int_XX'}"
2494.         }       
2495.         di "{hline 70}"
2496.         matlist weight_mat, format(%9.4fc) lines(rowtotal)
2497.         display _newline                
2498. }
