. if "`trends_lin'"==""{
1078. 
. // Computing the weight w_+.
. 
. if "`switchers'"==""{
1079.         scalar w_plus_XX = U_Gg_den_plus_XX*sum_N1_l_XX/(U_Gg_den_plus_XX*sum_N1_l_XX+U_Gg_den_minus_XX*sum_N0_l_XX)
1080. }
1081. 
. * When the "switchers" option is used, full weight is put to either switchers out or in
