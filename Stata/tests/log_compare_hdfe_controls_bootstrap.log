.         forvalue i=1/`=l_placebo_XX'{
953.                 
.                 if "`trends_lin'"!=""{
954.         did_multiplegt_dyn_core_new outcome_XX group_XX time_XX treatment_XX, effects(`i') placebo(`i') switchers_core(in) `only_never_
> switchers' controls(`controls') trends_nonparam(`trends_nonparam') `normalized' same_switchers same_switchers_pl trends_lin continuous(`co
> ntinuous') `less_conservative_se' weight(weight_XX) cluster(`cluster')
955. }
956.                                 
.                 if N1_placebo_`i'_XX!=0{
957.                                 replace U_Gg_pl_`i'_plus_XX  = U_Gg_placebo_`i'_XX
958.                                 replace count`i'_pl_plus_XX= count`i'_pl_core_XX
959.                                 replace U_Gg_var_pl_`i'_in_XX=U_Gg_pl_`i'_var_XX
960.                                 scalar N1_placebo_`i'_XX_new=N1_placebo_`i'_XX
961.                                 
.                                 if "`normalized'"!=""{
962.                                         scalar delta_D_pl_`i'_in_XX = delta_norm_pl_`i'_XX
963.                                 }
964. 
.                 }
965.                 
.         }       
966. }
967. 
. * Store variables necessary for computation of average effect.
.         if "`trends_lin'"==""{
968.         if sum_N1_l_XX!=0{
969.         replace U_Gg_plus_XX = U_Gg_XX
970.         scalar U_Gg_den_plus_XX=U_Gg_den_XX
971.         replace U_Gg_var_plus_XX = U_Gg_var_XX
972.         }
973.         }
974. 
. }
975.         
. } // end of the condition for switchers in
976. 
. // Same thing as above, for switchers out
. 
. if ("`switchers'"==""|"`switchers'"=="out"){
977. if L_a_XX!=.&L_a_XX!=0{
978.         
. if "`trends_lin'"==""{  
979. did_multiplegt_dyn_core_new outcome_XX group_XX time_XX treatment_XX, effects(`=l_XX') placebo(`=l_placebo_XX') switchers_core(out) `on
> ly_never_switchers' controls(`controls')  trends_nonparam(`trends_nonparam') `normalized' `same_switchers' `same_switchers_pl' continuous(
> `continuous') `less_conservative_se' weight(weight_XX) cluster(`cluster')
980. 
.         // Store the number of the event-study effect for switchers-out
.                 forv k = 1/`=L_a_XX_tag' {
981.                         replace switcher_tag_XX = `k' if distance_to_switch_`k'_XX == 1
982.                 }
983. 
. }
984.         
. forvalue i=1/`=l_XX'{
985.         
. if "`trends_lin'"!=""{  
986.         did_multiplegt_dyn_core_new outcome_XX group_XX time_XX treatment_XX, effects(`i') switchers_core(out) `only_never_switchers' c
> ontrols(`controls') trends_nonparam(`trends_nonparam') `normalized' same_switchers trends_lin continuous(`continuous') `less_conservative_
> se' weight(weight_XX) cluster(`cluster')
987. 
.         // Store the number of the event-study effect for switchers-out
.         replace switcher_tag_XX = `i' if distance_to_switch_`i'_XX == 1
988. }
989.         
. if N0_`i'_XX!=0{
990.                 replace U_Gg`i'_minus_XX = - U_Gg`i'_XX
991.                 replace count`i'_minus_XX= count`i'_core_XX
992.                 //// CHANGE BELOW - tks (add minus sign)
>                 replace U_Gg_var_`i'_out_XX= - U_Gg`i'_var_XX
993.                 scalar N0_`i'_XX_new=N0_`i'_XX
994.                 
.                 if "`normalized'"!=""{
995.                         scalar delta_D_`i'_out_XX = delta_norm_`i'_XX
996.                 }
997.                 
.                 if "`trends_lin'"==""{
998.                 replace delta_D_g_`i'_minus_XX = delta_D_g_`i'_XX
999.                 }
1000.         }
1001.         
. }
1002. 
. 
. if l_placebo_XX!=0{
1003. 
.         forvalue i=1/`=l_placebo_XX'{
1004.                 
. if "`trends_lin'"!=""{  
1005.         did_multiplegt_dyn_core_new outcome_XX group_XX time_XX treatment_XX, effects(`i') placebo(`i') switchers_core(out) `only_neve
> r_switchers' controls(`controls') trends_nonparam(`trends_nonparam') `normalized' same_switchers same_switchers_pl trends_lin continuous(`
> continuous') `less_conservative_se' weight(weight_XX) cluster(`cluster')
1006. }
1007.                 
.         if N0_placebo_`i'_XX!=0{
1008.                         replace U_Gg_pl_`i'_minus_XX  = -U_Gg_placebo_`i'_XX
1009.                         replace count`i'_pl_minus_XX= count`i'_pl_core_XX
1010.                         //// CHANGE BELOW - tks (add minus sign)
>                         replace U_Gg_var_pl_`i'_out_XX= - U_Gg_pl_`i'_var_XX 
1011.                         scalar N0_placebo_`i'_XX_new=N0_placebo_`i'_XX
1012.                         
.                         if "`normalized'"!=""{
1013.                                         scalar delta_D_pl_`i'_out_XX = delta_norm_pl_`i'_XX
1014.         }
1015. 
.         }
1016.         }               
1017. }
1018. 
.         if "`trends_lin'"==""{
1019.         if sum_N0_l_XX!=0{
1020.         replace U_Gg_minus_XX = - U_Gg_XX
1021.         scalar U_Gg_den_minus_XX=U_Gg_den_XX
1022.         replace U_Gg_var_minus_XX = - U_Gg_var_XX
1023.         }
1024.         }
1025. 
. }
1026.         
. } // end of the loop for switchers out 
1027. 
. scalar drop L_u_XX_tag L_a_XX_tag
1028. 
. ////////// 5. Computing the estimators and their variances
> 
. /////  Computing DID_\ell
> 
. // Creation of the matrix which stores all the estimators (DID_l, DID_pl, delta, etc.), their sd and the CIs
. 
. matrix mat_res_XX = J(l_XX+l_placebo_XX+1,7,.) 
1029. 
. // Loop over the number of effects to be estimated
. 
.         // Create a local to store effects we cant estimate 
.         local missing_eff_XX "" 
1030. 
. forvalue i=1/`=l_XX'{
1031. 
. // Aggregating the U_(g,l) for switchers in and out
.         
. gen U_Gg`i'_global_XX = (N1_`i'_XX_new/(N1_`i'_XX_new+N0_`i'_XX_new))*U_Gg`i'_plus_XX +(N0_`i'_XX_new/(N1_`i'_XX_new+N0_`i'_XX_new))*U_Gg`
> i'_minus_XX
1032. replace U_Gg`i'_global_XX=. if first_obs_by_gp_XX==0
1033. 
. gen count`i'_global_XX = max(count`i'_plus_XX, count`i'_minus_XX)
1034. 
. // Computing aggregated delta_D (difference between treatments received wrt status quo, from F_g-1 to F_g-1+\ell), only needed for the nor
> malized estimator 
.         if "`normalized'"!=""{
1035.         scalar delta_D_`i'_global_XX = (N1_`i'_XX_new/(N1_`i'_XX_new+N0_`i'_XX_new))*delta_D_`i'_in_XX+(N0_`i'_XX_new/(N1_`i'_XX_new+N
> 0_`i'_XX_new))*delta_D_`i'_out_XX
1036.         }
1037. 
. // Storing the results and the number of switchers into the matrix mat_res_XX
. local rownames "`rownames' Effect_`i'"
1038. 
. // Counting number of switchers DID_\ell applies to
. 
. scalar N_switchers_effect_`i'_XX=N1_`i'_XX_new+N0_`i'_XX_new
1039. matrix mat_res_XX[`i',6]=N_switchers_effect_`i'_XX
1040. matrix mat_res_XX[`i',7]=`i'
1041. ereturn scalar N_switchers_effect_`i' = N_switchers_effect_`i'_XX
1042. 
. // Counting number of observations used in the computation of DID_\ell
. 
. gegen N_effect_`i'_XX = total(count`i'_global_XX) 
1043. scalar N_effect_`i'_XX = N_effect_`i'_XX
1044. ereturn scalar N_effect_`i' = N_effect_`i'_XX
1045. matrix mat_res_XX[`i',5]=N_effect_`i'_XX
1046. 
. // Modif Felix weight -> Display correct N with weights
. if "`weight'"!=""{
1047.         matrix mat_res_XX[`i',6]=N1_`i'_XX_weight+N0_`i'_XX_weight
1048.         ereturn scalar N_switchers_effect_`i'_w= N1_`i'_XX_weight+N0_`i'_XX_weight
1049. 
.         capture drop count`i'_global_XX_w
1050.         capture drop N_effect_`i'_XX_w
1051.         
.         gen count`i'_global_XX_w=count`i'_global_XX/weight_XX
1052.         gegen N_effect_`i'_XX_w = total(count`i'_global_XX_w) 
1053.         scalar N_effect_`i'_XX_w = N_effect_`i'_XX_w
1054.         ereturn scalar N_effect_`i'_w = N_effect_`i'_XX_w
1055.         matrix mat_res_XX[`i',5]=N_effect_`i'_XX_w
1056. }
1057. 
. // Error message if DID_\ell cannot be estimated
. 
. if N_switchers_effect_`i'_XX==0|N_effect_`i'_XX==0{
