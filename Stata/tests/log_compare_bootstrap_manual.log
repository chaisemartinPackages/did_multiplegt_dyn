2409. capture ereturn scalar se_placebo_`i'=scalar(se_placebo_`i'_XX)
2410. }
2411. if (l_placebo_XX>1&all_Ns_pl_not_zero==l_placebo_XX&all_delta_pl_not_zero==l_placebo_XX&"`normalized'"!="")|(l_placebo_XX>1&all_Ns_pl_
> not_zero==l_placebo_XX&"`normalized'"==""){
2412. capture ereturn scalar p_jointplacebo=scalar(p_jointplacebo)
2413. }
2414. }
2415. 
. if "`trends_lin'"==""{
2416. capture ereturn scalar Av_tot_effect = scalar(delta_XX)
2417. capture ereturn scalar N_avg_total_effect = scalar(N_effect_XX)
2418. capture ereturn scalar N_switchers_effect_average = N_switchers_effect_XX
2419. capture ereturn scalar se_avg_total_effect = se_XX
2420. }
2421. 
. ereturn local cmd "did_multiplegt_dyn"
2422. ereturn matrix estimates=didmgt_b2 
