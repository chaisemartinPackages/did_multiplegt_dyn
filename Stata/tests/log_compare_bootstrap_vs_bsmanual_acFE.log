. ///// design option which shows the different treatment paths that switcher groups follow
> 
. if "`design'" != "" {   
2307.         qui {
2308.         
.         // Releaod the data before it was changed in save_sample
.         use `data_predesign', clear
2309.         
.         // Error message if the arguments in the option were specified wrong
.         if strpos("`design'", ",") == 0 {
2310.                 di as error ""
2311.                 di as error "Syntax error in design option"
2312.                 di as error "Comma required"
2313.                 di as input _continue ""
2314.                 
.                 exit
2315.         }
2316.         
.         // Fetch the arguments 
.         local des_p = strtrim(substr("`design'", 1, strpos("`design'", ",") - 1))
2317.         local des_path = strtrim(substr("`design'", strpos("`design'", ",") + 1, .))
2318.         local des_n = l_XX 
2319.         
.         // When no percentage value is specified (for how many paths should be shown) it is set to a default of 100%
.         if missing("`des_p'") {
2320.                 local des_p = 1
2321.         }
2322.         local des_per = `des_p' * 100
2323.         local des_per : di %9.2fc `des_per'
2324.         
.         // keep periods up to ℓ periods after the first switch
.         gen F_g_plus_n_XX = F_g_XX + `des_n' - 1
2325.         keep if time_XX >= F_g_XX - 1 & time_XX <= F_g_plus_n_XX
2326.         sort group_XX time_XX
2327.         bys group_XX : gen time_l_XX = _n
2328. 
.         // Aggregate weights by group 
.         keep group_XX time_l_XX weight_XX treatment_XX F_g_XX
2329.         {
2330.                 if "`weight'" != "" {
2331.                         gegen g_weight_XX = sum(weight_XX), by(group_XX)
2332.                 }
2333.                 else {
2334.                         gen g_weight_XX = 1
2335.                 }
2336.         }
2337.         drop weight_XX
2338.         // Reshape wide to represent the treatment path by time
.         greshape wide treatment_XX, i(group_XX g_weight_XX F_g_XX) j(time_l_XX)
2339.         
.         // Drop missing treatments 
.         foreach v of varlist treatment_XX* {
2340.                 drop if `v' == .
2341.         }
2342.         
.         // Remove non switchers 
.         count if F_g_XX > T_max_XX
2343.         local non_switchers = r(N)
2344.         drop if F_g_XX > T_max_XX
2345.         
.         // Creating varibale to store number of groups per treatment path and collapsing
.         gen N_XX = 1
2346.         sum g_weight_XX
2347.         gen N_w_XX =  (g_weight_XX * N_XX) / r(sum)
2348.         drop group_XX g_weight_XX
2349.         gcollapse (sum) N_XX N_w_XX, by(treatment_XX*)
2350.         order N* treat* 
2351.         sum N_XX
2352.         local tot_switch = r(sum)
2353.         
.         // Keep the observations amounting to p% of the detected treatment paths 
.         gen neg_N_XX = -N_XX
2354.         sort neg_N_XX treatment_XX*
2355.         gen cum_sum_XX = sum(N_w_XX)
2356.         gen in_table_XX = (cum_sum_XX <= `des_p')
2357.         sort in_table_XX cum_sum_XX
2358.         bys in_table_XX: gen id_XX = _n
2359.         
.         // Keep all observations up to the first exceeding the p%       
.         keep if (in_table_XX == 1) | (in_table_XX == 0 & id_XX == 1)    
2360.         // Store the final % of groups included by the design option
.         {
2361.                 if `des_p' < 1 {
2362.                         sum cum_sum_XX if in_table == 0
2363.                         local last_p : di %9.2fc 100 * r(min)
2364.                 }
2365.                 else {
2366.                         local last_p : di %9.2fc 100
2367.                 }
2368.         }
2369.         
.         sort neg_N_XX treatment_XX*
2370.         drop neg_N_XX in_table_XX id_XX cum_sum_XX
2371.         
.         // Prepare matrix for the output table
.         mat define desmat = J(`=_N', `= 2 + 1 + `des_n'', .)
2372.         local colnames
2373.         label var N_XX "#Groups"
2374.         label var N_w_XX "%Groups"
2375.         replace N_w_XX=100*N_w_XX
2376.         * display in % terms
.         
.         // Generate the column/row names and fill treatment path
.         local j = 1
2377.         foreach v of varlist _all {
2378.                 local m : var label `v'
2379.                 if strpos("`v'", "treatment_XX") > 0 {
2380.                         local k = substr("`v'", length("treatment_XX") + 1, .)
2381.                         local m = "ℓ=`=`k'-1'"
2382.                 }
2383.                 local colnames `colnames' `m'   
2384.                 
.                 // Fill treatement path
.                 forv i = 1/`=_N' {
2385.                         matrix desmat[`i', `j'] = `v'[`i']
2386.                 }
2387.                 local j = `j' + 1
2388.                 
.         }
2389.         local rownames
2390.         forv i = 1/`=_N' {
2391.                 local rownames `rownames' "TreatPath`i'"
2392.         }
2393.         foreach v in col row {
2394.                 mat `v'n desmat = ``v'names'
2395.         }
2396.         }
2397. 
.         // output in console
.         if "`des_path'" == "console" {          
2398.                 display _newline
2399.                 di "{hline 80}"
2400.                 di _skip(10) "{bf:Detection of treatment paths - `des_n' periods after first switch}"
2401.                 if "`by'" !=""{ 
2402.                         * Add description with the by variable level if by is specified 
.                         di _skip(35) "{bf:By: `by' = `val_lab_int_XX'}"
2403.                 }       
2404.                 di "{hline 80}"
2405.                 matlist desmat, format(%9.4gc)
2406.                 di "{hline 80}"
2407.                 di "{it: Treatment paths detected in at least `=strtrim("`des_per'")'% of the switching groups `tot_switch' for which 
> `effects' effects could be estimated.}"
2408.                 di "{it: Total % = `=strtrim("`last_p'")' %}"
2409.                 
.                 // Get values for the reference line that explains how to read the table 
.                 qui {
2410.                         local n_groups = N_XX[1]
2411.                         local d_start = treatment_XX1[1]
2412.                         if `des_n' == 1 {
2413.                                 local d_vec : di %9.2gc treatment_XX2[1]
2414.                                 local d_vec = strtrim("`d_vec'")
2415.                         }
2416.                         else {
2417.                                 local d_vec = "vector ("
2418.                                 forv j = 1/`des_n' {
2419.                                         local k : di %9.2gc treatment_XX`=`j' + 1'[1]
2420.                                         local k = strtrim("`k'")
2421.                                         local d_vec = "`d_vec'`k', "
2422.                                 }
2423.                                 local d_vec = substr("`d_vec'", 1, length("`d_vec'")-2) + ")"
2424.                         }
2425.                 }
2426.                 di as text "{it: Design interpretation (first row):}"
2427.                 di as text "{it: `n_groups' groups started with treatment `d_start' and then experienced treatment `d_vec'.}"         
>   
2428.         }
2429.         
.         // output as excel
.         else if "`des_path'" != "console" & "`des_path'" !=  "" {
2430.                 if "`by'"==""{
2431.                 qui {
2432.                         putexcel set "`des_path'", replace sheet("Design", replace)
2433.                         putexcel A1 = matrix(desmat, names)
2434.                 }
2435.                  di "{bf:Design exported to `des_path'}"
2436.                 }
2437.                 else if "`by'"!=""{
2438.                         qui {
2439.                         * Create new sheet for each by level when by is specified       
.                         putexcel set "`des_path'", modify sheet("Design `by' = `val_lab_int_XX'", replace)
2440.                         putexcel A1 = matrix(desmat, names)
2441.                         }
2442.                  di "{bf:Design exported to `des_path'}"
2443.         }  
2444.         }
2445. }
2446. 
