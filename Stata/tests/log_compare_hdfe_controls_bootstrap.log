. // For switchers in
. if "`switchers'"==""|"`switchers'"=="in"{ 
651. sum L_g_XX if S_g_XX==1
652. scalar L_u_XX=r(max)
653. *For placebos
. if `placebo'!=0{
654. sum L_g_placebo_XX if S_g_XX==1
655. scalar L_placebo_u_XX=r(max)
656. 
. // If the trends_lin option was specified, L_placebo_u_XX should be decreased by 1
