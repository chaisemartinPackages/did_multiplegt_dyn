. *﻿* did_multiplegt_dyn : did_multiplegt, robust to dynamic effects and with asymptotic variances
. ** Henceforth, "the paper" refers to "Difference-in-Differences Estimators of Intertemporal
. ** Treatment Effects", by Chaisemartin and D'Haultfoeuille.
. ** Henceforth, "the companion paper" refers to "Estimators and Variance Estimators Computed by the
. ** did_multiplegt_dyn Command", by Chaisemartin et al.
. ** The adofile contains two programs. 
. ** Each program contains numbered sections, tagged with "//////////".
. ** Sections may contain unnumbered subsections, tagged with "/////".
. ** Subsections may contain unnumbered subsubsections, tagged with "//".
. ** Subsubsections may be further divided into paragraphs, tagged with "*".
. ** Comments are also tagged with "*".
. ** This version : January 17th, 2026
. 
. ** This version includes Diego's changes:
. **** Fixes to variance estimation with controls() (tks)
. **** Fixes to same_switchers() and same_switchers_pl() with unbalanced panel
. **** Fixes to controls() with unbalanced panel
. **** no_updates turned into _no_updates
. **** Fix to cluster variances
. **** Fixed norm weights with unbalanced panels
. **** Fixed effect_equal()
. **** (proposed) comprehensive fix to demeaning with clusters + simplified syntax
. **** (proposed) fix to demeaning when E_hat_denom == 1
. **** more_granular_demeaning
. **** Added Clement's second fix to placebo
. **** Replaced _r_ub and _r_lb with explicit CI computation
. **** Added sup test from sotable
. 
. ** Felix:
. **** Delete if d_sq_int_XX==`l' condition when summing placebo variances 
. **** Adjust - when storing the switcher out variances
. **** Add cap drop group2_XX to Tom's change regarding the re-counting of groups
. **** Add different_paths_XX in the group statement "gegen rank_paths_XX=group(-count_path_XX different_paths_XX) if count_path_XX!=." when
>  generating variable to distinguish paths for the by_path() option
. 
. ** Clément:
. **** Demeaning for singular cohorts
. **** No demeaning if singular cohorts have joint DoF = 1
. 
. **** Line 3204, add if "`trends_lin'"=="" condition when adding the avg_effect estimate to the matrix used for esttab (solve delta_XX not 
> found error) -> needed to add this condition at multiple places
. **** Add ereturn for p-value test joint nullity effects
. 
. *** DAC:
. **** Added HC2 BM DOF SES to predict_het
. 
. ********************************************************************************
. *                                 PROGRAM 1                                    *
. ********************************************************************************
. 
. capture program drop did_multiplegt_dyn

. 
. program did_multiplegt_dyn, eclass
  1.         version 12.0
  2.         syntax varlist(min=4 max=4 numeric) [if] [in] [, effects(integer 1) placebo(integer 0) switchers(string) only_never_switchers c
> ontrols(varlist numeric) trends_nonparam(varlist numeric) weight(varlist numeric max=1) dont_drop_larger_lower NORMALIZED cluster(varlist 
> numeric max=1) graphoptions(string) save_results(string) graph_off same_switchers same_switchers_pl effects_equal(string)  drop_if_d_miss_
> before_first_switch trends_lin ci_level(integer 95) by(varlist numeric max=1) predict_het(string) predict_het_hc2bm design(string) date_fi
> rst_switch(string)  NORMALIZED_weights CONTinuous(integer 0) save_sample less_conservative_se more_granular_demeaning by_path(string) boot
> strap(string) _no_updates hdfe_controls(string)]
  3.         
. ////////// 0. Auto-updates
> if "`_no_updates'" == "" {
  4.         if uniform() < 0.01 {
  5.                 noi ssc install did_multiplegt_dyn, replace
  6.         }
  7. }       
  8. 
. ////////// 1. Checking that necessary tools to run command installed, and that syntax correctly specified.      
>                 
. ///// Check if gtools is installed, if not present link to install
> qui cap which gtools
  9. if _rc{
 10.         di ""
 11.         di as error "You have not installed the gtools package which is used within the did_multiplegt_dyn command."
 12.         di `"{stata "ssc install gtools": Click here to install gtools}"'
 13.         di as input _continue ""
 14.         
.         exit
 15. }       
 16. 
. // Save controls in a specific local if trends_lin by() continuous() and continuous are specified at the same time
. if "`trends_lin'"!=""&"`by'"!=""&`continuous'!=0{
 17.         local controls_orig_XX = "`controls'"
 18. }
 19. 
. // Error message if by and by_path specified at the same time
. if "`by'"!=""&"`by_path'"!=""{  
 20.         di as error ""
 21.         di as error "The options by() and by_path() can not be specified at the same time!"
 22.         di as input _continue ""
 23.         exit
 24. }
 25. 
. 
. if `continuous'<0{
 26.         di ""
 27.         di as error "The input of the continuous() option has to be a positive integer!"
 28.         di as input _continue ""
 29.         
.         exit
 30. }
 31. 
. if ("`by_path'"!=""&"`graphoptions'"!=""){
 32.         di ""
 33.         di as error "by_path() builds on pre-specified graph options so it does not allow for any further inputs in graphoptions()!"
 34.         di as input _continue ""
 35.         
.         exit
 36. }       
 37. 
. if ("`by_path'"!=""&"`by_path'"!="all"){
 38.         
.         capture confirm integer number `by_path'
 39.         if _rc{
 40.         di ""   
 41.         di as error "The input of the by_path() option has to be {it:all} or a positive integer!"
 42.         di as input _continue ""
 43.         
.         exit
 44.         }
 45.         
. if `by_path'<=0{
 46.         di ""
 47.         di as error "The input of the by_path() option has to be {it:all} or a positive integer!"
 48.         di as input _continue ""
 49.         
.         exit
 50. }
 51. }
 52. 
. if "`bootstrap'"!=""&`continuous'==0{
 53.         di as error "You specified the bootstrap option without the continuous option. Please be aware that we strongly recommend to on
> ly compute bootstraped standard errors when you want to use the continuous option. Otherwise you can rely on the (much faster) computation
>  of analytical standard errors."       
 54.         di as input _continue ""
 55. }
 56. 
. if "`bootstrap'"==""&`continuous'>0{
 57.         di as error "You specified the continuous option without the bootstrap option. Please be aware that we recommend to compute boo
> tstraped standard errors when you are using the continuous option as the analytical standard errors can be liberal in that case."        
 58.         di as input _continue ""
 59. }
 60. 
. // Allow to specify seed with bootstrap
. if "`bootstrap'"==""{
 61.         local bootstrap_XX = 0 // allowing to keep the structure from before
 62. }       
 63. if "`bootstrap'"!=""{
 64.         if strpos("`bootstrap'", ",") == 0 {
 65.                 di as error ""
 66.                 di as error "Syntax error in bootstrap option"
 67.                 di as error "Comma required"
 68.                 di as input _continue ""
 69.                 exit
 70.         }
 71. 
.         local bootstrap_XX = strtrim(substr("`bootstrap'", 1, strpos("`bootstrap'", ",") - 1))
 72.         local seed_temp_XX = strtrim(substr("`bootstrap'", strpos("`bootstrap'", ",") + 1, .))
 73.         
.         // set default to 50 reps
.         if "`bootstrap_XX'"==""{
 74.                 local bootstrap_XX = 50
 75.         }
 76.         
.         // set default to no seed
.         if "`seed_temp_XX'"==""{
 77.                 local seed_XX ""
 78.         }
 79.         if "`seed_temp_XX'"!=""{
 80.                 local seed_XX "seed(`seed_temp_XX')"
 81.         }
 82. }
 83. 
. // Check that bootstrap input is correct 
. if `bootstrap_XX'!=0{
 84.         
.         local controls_bs_orig_XX="`controls'"
 85.         
.         capture confirm integer number `bootstrap_XX'
 86.         if _rc{
 87.         di ""   
 88.         di as error "The input of the bootstrap() option has to be a positive integer greater than 1"
 89.         di as input _continue ""
 90.         exit
 91.         }
 92.         
. if `bootstrap_XX'<2{
 93.         di ""
 94.         di as error "The input of the bootstrap() option has to be a positive integer greater than 1"
 95.         di as input _continue ""
 96.         exit
 97. }
 98. }
 99. 
. ///// Add a Warning that same_switchers_pl only works when same_switchers is specified.
> if "`same_switchers_pl'"!=""&"`same_switchers'"==""{
100.         di ""
101.         di as error "The same_switchers_pl option only works if same_switchers is specified as well!"
102.         di as input _continue ""
103.         
.         exit
104. }
105. 
. ///// Add a Warning that continous and the design option(s) should not be specified simulataneously
> if `continuous'>0&"`design'"!=""{
106.         di ""
107.         di as error "The design option can not be specified together with the continuous option!"
108.         di as input _continue ""
109. 
.         exit
110. }
111. 
. ///// hdfe_controls is incompatible with trends_lin (outcome gets first-differenced
> ///// before our level fit can use it). Allow hdfe_controls without controls
> ///// (FE-only residualization).
> if "`hdfe_controls'"!=""&"`trends_lin'"!=""{
112.         di ""
113.         di as error "The trends_lin option cannot be specified together with hdfe_controls()."
114.         di as input _continue ""
115. 
.         exit
116. }
117. 
. if "`more_granular_demeaning'" != "" {
118.         local less_conservative_se "less_conservative_se"
119. }
120. 
. ////////// 2. Data preparation steps    
>         
. ///// Storing path of initial dataset
> local dataset_name_XX `c(filename)'
121. 
. if "`save_sample'" != "" {
122.         cap drop _did_sample*
123. }
124. 
. ///// Preserving data 
> preserve
125. 
. ///// Quietly
>         qui{
126. 
.         
. ///// capture drop of several variables created below
> capture drop outcome_non_diff_XX                                
127. capture drop outcome_XX
128. capture drop group_XX
129. capture drop time_XX
130. capture drop treatment_XX
131. capture drop d_sq_XX
132. capture drop d_fg_XX
133. capture drop diff_from_sq_XX
134. capture drop ever_change_d_XX
135. capture drop never_change_d_XX
136. capture drop temp_F_g_XX
137. capture drop F_g_XX
138. capture drop t_min_XX
139. capture drop T_max_XX
140. capture drop N_gt_XX
141. capture drop T_g_XX
142. capture drop controls_time_XX
143. capture drop _fillin
144. capture drop time_d_nonmiss_XX
145. capture drop min_time_d_nonmiss_XX
146. capture drop d_F_g_temp_XX
147. capture drop d_F_g_XX
148. capture drop S_g_XX
149. capture drop S_g_het_XX
150. capture drop L_g_XX
151. capture drop U_Gg_plus_XX
152. capture drop U_Gg_minus_XX
153. capture drop U_Gg_global_XX
154. capture drop w_plus_XX
155. capture drop first_obs_by_gp_XX
156. capture drop first_obs_by_clust_XX
157. capture drop avg_post_switch_treat_XX
158. capture drop count_time_post_switch_XX_temp
159. capture drop count_time_post_switch_XX
160. capture drop ever_strict_increase_XX
161. capture drop ever_strict_decrease_XX
162. capture drop U_Gg_var_plus_XX
163. capture drop U_Gg_var_minus_XX
164. capture drop U_Gg_var_global_XX
165. capture drop U_Gg_var_global_2_XX
166. capture drop weight_XX
167. capture drop delta_XX
168. capture drop aux_XX
169. 
. // ereturn clear //Modif Felix
. 
. tokenize `varlist'
170. 
. ///// Patching the cluster option: by default, command clusters at group level. 
> ///// If user specified clustering according to group, replace it by empty. 
> if "`cluster'"=="`2'" local cluster ""
171. 
. ///// Selecting the sample 
> 
. //dropping observations with missing group or time
. drop if `2'==.|`3'==.
172. //dropping observations with missing controls
.         if "`controls'" !=""{
173.         foreach var of varlist `controls'{
174.         drop if `var'==.
175.         }
176.         }
177. //dropping observations not included in the if condition
.         if "`if'" !=""{
178.         keep `if'
179.         }
180. // dropping observations not included in the in condition
.         if "`in'" !=""{
181.         keep `in'
182.         } 
183.         
.         
. ///// Collapse and weight
>         
. // Checking wether data has to be collapsed, because at a more disaggregated level than group*time.
.  
. capture drop counter_XX
184. capture drop counter_temp_XX
185. gen counter_temp_XX=1
186. bys `2' `3' : gegen counter_XX=count(counter_temp_XX)
187. sum counter_XX
188. scalar aggregated_data=0
189. if r(max)==1{
190. scalar aggregated_data=1
191. }
192. 
. // Creating the weight variable.
. 
. if("`weight'"==""){
193. gen weight_XX = 1
194. }
195. else{
196. gen weight_XX = `weight'
197. }
198. 
. replace weight_XX=0 if weight_XX==.
199. 
. // Collapsing the data when necessary
. 
. if scalar(aggregated_data)==0{
200.         
.         replace weight_XX=10^(-38) if `1'==.
201.         capture drop tag_y_miss_XX
202.         gen tag_y_miss_XX=(`1'==.)
203.         
.         if "`1'"!="`4'"{                        
204.                 collapse (mean) `1' `4' tag_y_miss_XX `controls' `trends_nonparam' `cluster' `by' `predict_het' (count) weight_XX [pw=w
> eight_XX], by(`2' `3') 
205.         }
206.         
.         if "`1'"=="`4'"{
207.                                 
.                 collapse (mean) `1' `controls' `trends_nonparam' `cluster' `by' `predict_het' (count) weight_XX [pw=weight_XX], by(`2' `3'
> )
208.         }       
209.         
.         replace weight_XX=0 if tag_y_miss_XX==1
210. }
211.         
. //// Modif Felix 26.05.2025 -> tempvar to use the correct weights when we use by_path and the data is collapsed becausee the group variabl
> e is coarser than the panel identifier
> if "`by_path'" != ""{
212.         tempvar weight_path_XX
213.         generate `weight_path_XX' = weight_XX
214. }       
215.         
. ///// by option for heterogeneous treatment effects analysis
> 
. // define local so we run the loop once if by is not specified
. local levels_byvar_XX 1 
216. 
. // checking that by variable is time-invariant
. scalar by_XX  = 1
217. if "`by'" !=""{
218.         xtset `2' `3'
219.         xtsum `by'
220.         if `r(sd_w)'!=0{
221.                 display as error "The variable specified in the option by is time-varying. That variable should be time-invariant."
222.                 di as input _continue ""
223.                 exit
224.         }
225. }
226. 
. if "`by'" !=""{
227. // save data to load again in the multiple repetitions of the estimation
. tempfile by_data_XX
228. save "`by_data_XX'.dta", replace
229. // store local with number of estimations we need to run
. levelsof `by', local(levels_byvar_XX)
230. local `by'_lab_XX: value label `by'
231. }
232. // Loop to run estimation multiple times in case of by
. } // end of the quietly condition
233. foreach l_by of local levels_byvar_XX { 
234.         qui{
235. if "`by'" !=""{ 
236. * Check if we have value labels 
. ds `by', has(vallabel)
237. local `by'_has_vallabel_XX=r(varlist)
238. if "``by'_has_vallabel_XX'"!="."{
239.         local val_lab_int_XX "`: label ``by'_lab_XX' `l_by''"
240. } 
241. if "``by'_has_vallabel_XX'"=="."{
242.         local val_lab_int_XX "`l_by'"
243. }
244. // sample restriction for the by option
.         keep if `by' == `l_by'
245. }               
246. 
. ///// Further sample selection steps
> 
. // dropping observations with a missing clustering variable
.         if "`cluster'" !=""{
247.         drop if `cluster'==.
248.         }
249. //dropping groups with always missing treatment or outcome
. capture drop mean_d_XX
250. capture drop mean_y_XX
251. bys `2': gegen mean_d_XX=mean(`4')
252. bys `2': gegen mean_y_XX=mean(`1')
253. drop if mean_d_XX==.|mean_y_XX==.
254. drop mean_d_XX mean_y_XX
255. 
. // save data for bootstrap
. if `bootstrap_XX'!=0{
256.         
.         qui tempfile data_bootstrap_XX
257.         qui save "`data_bootstrap_XX'.dta", replace
258. 
.         if "`less_conservative_se'"!=""{
259.                 di as error ""
260.                 di as error "The less_conservative_se option has no effect when bootstrap is specified, therefore it is ignored in this
>  case to save computation time."
261.                 di as input _continue ""
262.                 local less_conservative_se ""
263. }
264. }
265. 
. ///// predict_het option for heterogeneous treatment effects analysis
> 
. if "`predict_het'"!=""{
266. 
. if strpos("`predict_het'", ",") == 0 {
267.                 di as error ""
268.                 di as error "Syntax error in predict_het option"
269.                 di as error "Comma required"
270.                 di as input _continue ""
271.                 exit
272.         }
273. 
. local het_vars_XX = strtrim(substr("`predict_het'", 1, strpos("`predict_het'", ",") - 1))
274. local het_nums_XX = strtrim(substr("`predict_het'", strpos("`predict_het'", ",") + 1, .))
275. 
.         // Modif Felix: Add checks for correct inputs in predict_het
.         if "`het_vars_XX'"==""{
276.                 di as error "You did not specify any variables to be used in the predict_het option, therefore this option will be igno
> red"
277.                 di as input _continue ""
278.         }
279.         
.         if "`het_nums_XX'"==""{
280.                 local het_nums_XX
281.         }
282.         
.         local pred_het `het_vars_XX'
283.         local het_effects `het_nums_XX' 
284. 
. * Check if predict_het and normalized are specified simulataneously
. if "`normalized'"!=""{
285.         local pred_het ""
286.         local het_effects ""
287.         local predict_het ""
288.         di as error ""
289.         di as error "The options normalized and predict_het can not be specified at the same time, therefore predict_het will be ignore
> d."
290.         di as input _continue ""
291. }
292. 
. * Check if predict_het and controls are specified simulataneously
. if "`predict_het'"!=""&"`controls'"!=""{
293.         local pred_het ""
294.         local het_effects ""
295.         local predict_het ""
296.         di as error ""
297.         di as error "The options controls() and predict_het can not be specified at the same time, therefore predict_het will be ignore
> d."
298.         di as input _continue ""
299. }
300. }       
301. 
. * Check if only time-invariant variables are specified in predict_het
. if "`pred_het'" !=""{
302.         
.         local predict_het_bad=""
303.         local predict_het_good=""
304.         
.         foreach var in `pred_het'{
305.         bys `2': sum `var'
306.         
.         if r(sd)!=0{
307.                 local predict_het_bad="`predict_het_bad' `var'"
308.         }
309.         if r(sd)==0{
310.                 local predict_het_good="`predict_het_good' `var'"
311.         }
312.         }
313.         
.         if "`predict_het_bad'"!=""{
314.         display as error "The variable(s) (`predict_het_bad') specified in the option predict_het"
315.         display as error "is(are) time-varying, the command will therefore ignore them."
316.         di as input _continue ""
317.         }
318. }
319. 
. *Limit use of predict_het_hc2bm to cases where predict_het is specified
. if "`predict_het'"=="" & "`predict_het_hc2bm'" != "" {
320.         di as error ""
321.         di as error "Option predict_het_hc2bm only available when predict_het is specified."
322.         
.         di as input _continue ""
323.         
.         exit
324. }
325. 
. 
. ///// Creating Y G T D variables
> 
. gen outcome_XX=`1'
326. * Inside a bootstrap rep on the hdfe path, _bs_id_XX exists (created by the
. * outer call's idcluster() option). Combining it with the user's group var
. * gives each cloned cluster appearance distinct unit IDs, which keeps xtset
. * and reghdfe well-defined. Outside the hdfe path (or in the outer call),
. * _bs_id_XX is absent and group_XX falls back to the plain user-group ID.
. capture confirm variable _bs_id_XX
327. if _rc == 0 & "`hdfe_controls'" != "" {
328.     gegen group_XX = group(_bs_id_XX `2')
329. }
330. else {
331.     gegen group_XX = group(`2')
332. }
333. gegen time_XX=group(`3')
334. gen treatment_XX=`4'
335. 
. ///// Declaring data as (G,T) panel
> 
. xtset group_XX time_XX
336. 
. ///// Creating variables useful to deal with imbalanced panels:
> 
. // G's first and last date when D not missing
. 
. gen time_d_nonmiss_XX=time_XX if treatment_XX!=.
337. bys group_XX: gegen min_time_d_nonmiss_XX=min(time_d_nonmiss_XX)
338. capture drop max_time_d_nonmiss_XX
339. bys group_XX: gegen max_time_d_nonmiss_XX=max(time_d_nonmiss_XX)
340. 
. // G's first date when Y not missing
. 
. capture drop time_y_nonmiss_XX
341. capture drop min_time_y_nonmiss_XX
342. gen time_y_nonmiss_XX=time_XX if outcome_XX!=.
343. bys group_XX: gegen min_time_y_nonmiss_XX=min(time_y_nonmiss_XX)
344. 
. // G's first date when D missing after Y has been not missing
. 
. capture drop time_d_miss_XX
345. capture drop min_time_d_miss_aft_ynm_XX
346. gen time_d_miss_XX=time_XX if treatment_XX==.&time_XX>=min_time_y_nonmiss_XX
347. bys group_XX: gegen min_time_d_miss_aft_ynm_XX=min(time_d_miss_XX)
348. drop time_d_nonmiss_XX time_y_nonmiss_XX time_d_miss_XX 
349. 
. ///// Creating baseline treatment
> ///// D_{g,1} in paper, redefined to account for imbalanced panels: 
> ///// g's treatment at first period where g's treatment non missing
> 
. gen d_sq_XX_temp=treatment_XX if time_XX==min_time_d_nonmiss_XX
350. bys group_XX: gegen d_sq_XX=mean(d_sq_XX_temp)
351. drop d_sq_XX_temp 
352. 
. ///// Enforcing Design Restriction 2 in the paper.
> ///// If the option dont_drop_larger_lower was not specified, 
> ///// drop (g,t) cells such that at t, g has experienced both a strictly lower 
> ///// and a strictly higher treatment than its baseline treatment.
> 
. gen diff_from_sq_XX=(treatment_XX-d_sq_XX)
353. 
. if "`dont_drop_larger_lower'"==""{              
354.         sort group_XX time_XX
355.         gen ever_strict_increase_XX=(diff_from_sq_XX>0&treatment_XX!=.) 
356.         replace ever_strict_increase_XX=1 if ever_strict_increase_XX[_n-1]==1&group_XX==group_XX[_n-1]
357. 
.         gen ever_strict_decrease_XX=(diff_from_sq_XX<0&treatment_XX!=.) 
358.         replace ever_strict_decrease_XX=1 if ever_strict_decrease_XX[_n-1]==1&group_XX==group_XX[_n-1]
359. 
.         drop if ever_strict_increase_XX==1 & ever_strict_decrease_XX==1
360.         
.         drop ever_strict_increase_XX ever_strict_decrease_XX
361.                 
. }
362. 
. ///// Sort data
> sort group_XX time_XX
363. 
. ///// Counting number of groups
> //sum group_XX
. //scalar G_XX=r(max)
. 
. ///// Ever changed treatment
> gen ever_change_d_XX=(abs(diff_from_sq_XX)>0&treatment_XX!=.)
364. replace ever_change_d_XX=1 if ever_change_d_XX[_n-1]==1&group_XX==group_XX[_n-1]
365. 
. ///// Creating date of first treatment change
> sort group_XX time_XX
366. gen temp_F_g_XX=time_XX if ever_change_d_XX==1&ever_change_d_XX[_n-1]==0 
367. replace temp_F_g_XX=0 if temp_F_g_XX==.
368. bys group_XX: gegen F_g_XX=max(temp_F_g_XX)
369. drop temp_F_g_XX
370. 
. ///// If continuous option specified, generating polynomials of D_{g,1},
> ///// storing D_{g,1} somewhere, and replacing it by 0.
> if `continuous'>0{
371.         
.         scalar degree_pol = `continuous'
372.         
. forvalues pol_level = 1/`=degree_pol'{
373.         scalar pol_level_XX = `pol_level'
374.         capture drop d_sq_`pol_level'_XX 
375.         gen d_sq_`pol_level'_XX = d_sq_XX^scalar(pol_level_XX)
376. }
377. capture drop d_sq_XX_orig
378. gen d_sq_XX_orig=d_sq_XX
379. replace d_sq_XX=0
380. }
381. 
. // Create a new variable = to d_sq_XX expressed in integers
. capture drop d_sq_int_XX
382. 
. gegen d_sq_int_XX = group(d_sq_XX)
383. 
. ///// Dropping the values of the baseline treatment such that no variance in F_g within those values.
> capture drop var_F_g_XX
384. bys d_sq_XX `trends_nonparam': gegen var_F_g_XX=sd(F_g_XX)
385. drop if var_F_g_XX==0
386. drop var_F_g_XX
387. 
. //// CHANGE BELOW - tks
> //// Counting number of groups after the drop above
> cap drop group2_XX
388. egen group2_XX = group(group_XX)
389. sum group2_XX
390. scalar G_XX=r(max)
391. ////
> 
. ///// Error message if Design Restriction 1 is not met.
> count
392. if r(N)==0{
393.         di as error ""
394.         di as error "No treatment effect can be estimated. This is because Design Restriction 1 in de Chaisemartin & D'Haultfoeuille (2
> 024) is not satisfied in the data, given the options requested. This may be due to the fact that groups' period-one treatment is continuou
> s, or takes a large number of values, and you have not specified the continuous option. If so, you can try to specify this option. If the 
> issue persists even with this option, this means that all groups experience their first treatment change at the same date, a situation whe
> re the estimators of de Chaisemartin & D'Haultfoeuille (2024) cannot be used."
395.         di as input _continue ""
396. 
.         exit
397. }
398. 
. ///// For each value of the baseline treatment, we drop time periods such that we do not have any control with that baseline treatment aft
> er that period
> ///// This means the panel is no longer balanced, though it is balanced within values of the baseline treatment
> gen never_change_d_XX=1-ever_change_d_XX
399. bys time_XX d_sq_XX `trends_nonparam': gegen controls_time_XX=max(never_change_d_XX)
400. drop if controls_time_XX==0
401. 
. ///// Computing t_min_XX, T_max_XX, and replacing F_g_XX by last period plus one for those that never change treatment
> sum time_XX
402. scalar t_min_XX=r(min)
403. scalar T_max_XX=r(max)
404. replace F_g_XX=T_max_XX+1 if F_g_XX==0
405. 
. ///// Dealing with missing treatments: most conservative option
> 
. *Let FMD_g denote the first date when g's treatment is missing while y has been not missing at least once, so that we know for sure that g
>  already exists. If that date is before the first period when g's treatment changes, we do not know when g's treatment has changed for the
>  first time. Then, a conservative option is to drop all of g's outcomes starting at FMD_g.
. 
. if "`drop_if_d_miss_before_first_switch'"!=""{
406. replace outcome_XX=. if min_time_d_miss_aft_ynm_XX<F_g_XX&time_XX>=min_time_d_miss_aft_ynm_XX
407. }
408. 
. ///// Dealing with missing treatments: most liberal option
> 
. *Let FD_g and LD_g respectively denote the first and last period where a group's treatment is non missing. Let FY_g denote the first perio
> d where a group's outcome is non missing.
. 
. *For groups that experience at least one treatment change, let LDBF_g denote the last date before F_g where g's treatment is non missing. 
> We have FD_g<=LDBF_g<F_g<=LD_g, and we will deal with missing treatments depending on when they occur with respect to those four dates.
. 
. capture drop last_obs_D_bef_switch_t_XX
409. capture drop last_obs_D_bef_switch_XX
410. gen last_obs_D_bef_switch_t_XX=time_XX if time_XX<F_g_XX&treatment_XX!=.
411. bys group_XX: gegen last_obs_D_bef_switch_XX=max(last_obs_D_bef_switch_t_XX)
412. 
. *For groups that do not experience a treatment change, we just have FD_g<=LD_g, and we will deal with missing treatments depending on when
>  they occur with respect to those two dates.
. 
. *For t<FD_g, by default we are going to consider that g joins the panel at FD_g: any non-missing outcome before FD_g replaced as missing, 
> but all non-missing outcomes after FD_g are kept. For groups such that FY_g<FD_g, this is a "liberal" convention: those groups exist befor
> e FD_g, so one could argue that their status quo treatment is missing and they should be dropped from the analysis. We give the user the o
> ption to do that, with drop_if_d_miss_before_first_switch option
.   
. replace outcome_XX=. if time_XX<min_time_d_nonmiss_XX 
413. 
. *For groups that experience a treatment change, if D_gt missing at FD_g<t<LDBF_g, we replace their missing treatment by their status-quo t
> reatment. Again, this is a liberal convention, so we give the user the option to not use those observations, with drop_if_d_miss_before_fi
> rst_switch option.
. 
. replace treatment_XX=d_sq_XX if F_g_XX<T_max_XX+1&treatment_XX==.&time_XX<last_obs_D_bef_switch_XX&time_XX>min_time_d_nonmiss_XX
414. 
. *For groups that experience a treatment change, if D_gt missing at LDBF_g<t<F_g (equivalent to LDBF_g<F_g-1), we cannot know the exact dat
> e when their treatment has changed, even in a binary and staggered design. Therefore, we set their outcomes at missing starting at LDBF_g+
> 1. We also redefine their F_g as T+1 because they are effectively control groups. We also define the trunc_control_XX as LDBF_g+1 for them
> , because they can only be used as controls till that date.
. 
. replace outcome_XX=. if F_g_XX<T_max_XX+1&time_XX>last_obs_D_bef_switch_XX&last_obs_D_bef_switch_XX<F_g_XX-1
415. capture drop trunc_control_XX
416. gen trunc_control_XX=last_obs_D_bef_switch_XX+1 if F_g_XX<T_max_XX+1&last_obs_D_bef_switch_XX<F_g_XX-1
417. replace F_g_XX=T_max_XX+1 if F_g_XX<T_max_XX+1&last_obs_D_bef_switch_XX<F_g_XX-1
418. 
. *For groups that experience a treatment change, if D_gt missing at F_g<t, we replace their missing treatment by D(g,F_g). This is again a 
> liberal convention, but it is innocuous for the reduced-form parameters DID_l, so we do not give the user the option to overrule it (Note 
> that overruling it could make the same_switchers option fail)
. 
. gen d_F_g_temp_XX = treatment_XX if time_XX==F_g_XX
419. bys group_XX: gegen d_F_g_XX = mean(d_F_g_temp_XX)
420. replace treatment_XX=d_F_g_XX if F_g_XX<T_max_XX+1&treatment_XX==.&time_XX>F_g_XX&last_obs_D_bef_switch_XX==F_g_XX-1
421. 
. *For groups that do not experience a treatment change, if D_gt missing at FD_g<t<LD_g, we replace their missing treatment by D_g1. This is
>  again a liberal convention, so we give the user the option to not use those observations, with drop_if_d_miss_before_first_switch option.
. 
. replace treatment_XX=d_sq_XX if F_g_XX==T_max_XX+1&treatment_XX==.&time_XX>min_time_d_nonmiss_XX&time_XX<max_time_d_nonmiss_XX
422. 
. *For groups that do not experience a treatment change, we replace all their outcomes by missing at t>LD_g. Even in a binary and staggered 
> design, we cannot infer their treatment at t>LD_g.
. 
. replace outcome_XX=. if F_g_XX==T_max_XX+1&time_XX>max_time_d_nonmiss_XX
423. replace trunc_control_XX=max_time_d_nonmiss_XX+1 if F_g_XX==T_max_XX+1
424. 
. ///// Store the outcome in levels, will be useful later when predict_het and trends_lin specified
> if "`predict_het_good'"!=""{
425. gen outcome_non_diff_XX=outcome_XX
426. }
427. 
. ///// Unconditional level-outcome snapshot, used by the hdfe_controls path for
> ///// the reghdfe fit (trends_lin overwrites outcome_XX with its first difference below).
> capture drop Y_level_XX
428. gen double Y_level_XX = outcome_XX
429. 
. ///// If trends_lin option specified, drop units for which F_g_XX==2, and redefine 
> ///// outcome and controls in first difference.
> if "`trends_lin'"!=""{
430.         drop if F_g_XX==2
431.         xtset group_XX time_XX
432.         capture drop FD_outcome_XX
433.         gen FD_outcome_XX =outcome_XX-L.outcome_XX
434.         replace outcome_XX = FD_outcome_XX
435.         drop FD_outcome_XX
436.         
.         // adapt controls for case where trends_lin by and continuous specified together
.         if "`trends_lin'"!=""&"`by'"!=""&`continuous'!=0{
437.         local controls = "`controls_orig_XX'"
438. }
439.         
.         if "`controls'" !=""{
440.         foreach var of varlist `controls'{
441.         capture drop FD_`var'_XX
442.         gen FD_`var'_XX =`var' -L.`var'
443.         replace `var' = FD_`var'_XX
444.         drop FD_`var'_XX
445.         }
446.         }
447.         drop if time_XX==1
448.         sum time_XX
449.         scalar t_min_XX=r(min)
450. }
451. 
. ///// Balancing the panel
> cap rename _merge _merge_og
452. fillin group_XX time_XX
453. capture drop d_sq_XX_new
454. bys group_XX: gegen d_sq_XX_new=mean(d_sq_XX)
455. drop d_sq_XX
456. rename d_sq_XX_new d_sq_XX
457. 
. ///// CHANGE BELOW - tks
> 
. bys group_XX: gegen d_sq_int_XX_new = mean(d_sq_int_XX)
458. drop d_sq_int_XX
459. rename d_sq_int_XX_new d_sq_int_XX
460. 
. bys group_XX: gegen F_g_XX_new = mean(F_g_XX)
461. drop F_g_XX
462. rename F_g_XX_new F_g_XX
463. 
. /////
> 
. ///// Defining N_gt, the weight of each cell (g,t)
> gen N_gt_XX=1
464. replace N_gt_XX = N_gt_XX*weight_XX  //
465. replace N_gt_XX=0 if outcome_XX==.|treatment_XX==.
466. 
. ///// Determining last period where g still has a control group:
> ///// There is still a group with same 
> ///// treatment as g's in period 1 and whose treatment has not changed since 
> ///// start of panel. Definition adapted from the paper, to account for 
> ///// imbalanced panel.
> 
. capture drop F_g_trunc_XX
467. gen F_g_trunc_XX=F_g_XX
468. replace F_g_trunc_XX=min(F_g_XX,trunc_control_XX) if trunc_control_XX!=.
469. bys d_sq_XX `trends_nonparam': gegen T_g_XX = max(F_g_trunc_XX) 
470. replace T_g_XX = T_g_XX-1
471. 
. ///// Defining S_g: 
> ///// an indicator variable for groups whose average post switch 
> ///// treatment value is larger than their initial treatment D_{g,1}. 
> ///// They will be considered switchers in. If S_g==0, the group is a switcher out. 
> ///// For never-switchers, S_g is undefined.
> ///// Definition of S_g matches that in paper, unless dont_drop_larger_lower specified.
> 
. bys group_XX : gegen avg_post_switch_treat_XX_temp = total(treatment_XX) if time_XX>=F_g_XX&time_XX<=T_g_XX
472. gen count_time_post_switch_XX_temp=(treatment_XX!=.) if time_XX>=F_g_XX&time_XX<=T_g_XX
473. bysort group_XX : gegen count_time_post_switch_XX=total(count_time_post_switch_XX_temp)
474. replace avg_post_switch_treat_XX_temp =avg_post_switch_treat_XX_temp/count_time_post_switch_XX
475. bys group_XX: gegen avg_post_switch_treat_XX=mean(avg_post_switch_treat_XX_temp)
476. drop avg_post_switch_treat_XX_temp
477. 
. // When a group is a switching group, but its average post-treatment treatment 
. // value is exactly equal to its baseline treatment, we cannnot classify it as 
. // a swicher in or a switcher out, but it is not a control either. 
. // As such, we drop it from the estimation. Those groups are referred to 
. // as no-first-stage-switchers. This issue can only arise 
. // if dont_drop_larger_lower specified. 
. // if continuous is specified we do this according to the original 
. // baseline treatment and not to the one set to 0 to correctly
. // track if a group is switcher in or switcher out.
. if `continuous'==0{
478.         drop if avg_post_switch_treat_XX==d_sq_XX&F_g_XX!=T_g_XX+1
479.         gen S_g_XX=(avg_post_switch_treat_XX>d_sq_XX) if F_g_XX!=T_max_XX+1
480. }
481. else if `continuous'>0{
482.         drop if avg_post_switch_treat_XX==d_sq_XX_orig&F_g_XX!=T_g_XX+1
483.         gen S_g_XX=(avg_post_switch_treat_XX>d_sq_XX_orig) if F_g_XX!=T_max_XX+1
484. }       
485. // correct for the fact that if all avg_post_switch_treat_XX are missing it is considered as +inf
. egen aux_XX = min(avg_post_switch_treat_XX), by(group_XX)
486. replace S_g_XX = . if aux_XX ==.
487. 
. // Define another version where S_g=-1 for switchers out, which we need 
. // when predict_het or continuous specified.
. if "`predict_het_good'"!="" | `continuous'>0{
488. gen S_g_het_XX=S_g_XX
489. replace S_g_het_XX=-1 if S_g_het_XX==0
490. if "`predict_het_good'"!=""{
491. scalar heterogeneity_scalar_XX=1
492. }
493. }
494. 
. 
. ///// If continuous option specified: binarizing and staggerizing treatment,
> ///// and adding time_FEs interacted with D_{g,1} as controls
> if `continuous'>0{
495. 
. //Binarizing and staggerizing treatment
. capture drop treatment_XX_temp
496. gen treatment_XX_temp = (F_g_XX<=time_XX)*S_g_het_XX if S_g_het_XX!=.
497. capture drop treatment_XX_orig
498. gen treatment_XX_orig=treatment_XX
499. replace treatment_XX = treatment_XX_temp 
500. 
. //Enriching controls
. tab time_XX, gen(time_fe_XX_)
501. local max_time_XX=r(r)
502. // Modif Clément: actually, to compute the estimator with the continuous option we need to control for polynomial in D_{g,1} interacted
>  with \sum_{k=1}^t'1\{t=k}, sum of period FEs up to t'.
. forvalue i=2/`max_time_XX'{
503. replace time_fe_XX_`i'=(time_XX>=`i')
504. }
505. // End modif Clément
. foreach var of varlist time_fe_XX_2-time_fe_XX_`max_time_XX'{
506.         forvalues pol_level = 1/`=degree_pol'{
507.                 gen `var'_bt`pol_level'_XX = `var'*d_sq_`pol_level'_XX
508.                 local controls "`controls' `var'_bt`pol_level'_XX"
509.         }
510.         capture drop `var'
511. }
512. capture drop time_fe_XX_1
513. }
514. 
. ///// Creating treatment at F_g: D_{g,F_g}
> gen d_fg_XX_temp=treatment_XX if time_XX==F_g_XX
515. bys group_XX: gegen d_fg_XX=mean(d_fg_XX_temp)
516. replace d_fg_XX=d_sq_XX if d_fg_XX==. & F_g_XX==T_max_XX+1
517. drop d_fg_XX_temp 
518. 
. ///// Creating the variable L_g_XX = T_g_XX - F_g_XX, so that we can compute L_u or L_a afterwards.
> gen L_g_XX = T_g_XX - F_g_XX +1
519. 
. ///// Creating the equivalent variable L_g_placebo_XX for the placebos.
> if `placebo'!=0{
520. capture drop L_g_placebo_XX
521. gen L_g_placebo_XX = min(L_g_XX, F_g_XX-2) if F_g_XX>=3
522. }
523. 
. ///// Tagging first observation of each group_XX.
> sort group_XX time_XX
524. bysort group_XX : gen first_obs_by_gp_XX = (_n==1)
525. 
. ///// If cluster option specified, tagging first observation of each cluster, 
> ///// and checking clustering variable weakly coarser than group variable.
> 
. if "`cluster'"!=""{
526.                 
.         // FELIX 06-03-25 -> I guess this is how Tom solved it 
.         cap drop cluster_group_XX
527.         bysort group_XX: gegen cluster_group_XX=min(`cluster') 
528.         bysort group_XX: replace `cluster'=cluster_group_XX if `cluster'==.
529.         // Can do this because clusters have to be coarser than groups
.         
.         capture drop cluster_var_g_XX
530.         
.         bysort `cluster' (group_XX time_XX) : gen first_obs_by_clust_XX = (_n==1) if `cluster'!=. // FELIX 05_03_25 -> This is then not ne
> eded anymore
531.         
.         //Error message for clustering: non-nested case
.         bysort group_XX: gegen cluster_var_g_XX = sd(`cluster')
532.         sum cluster_var_g_XX
533.         scalar max_cluster_var_XX = `r(max)'
534.         if (scalar(max_cluster_var_XX) >0){
535.         di as error ""
536.         di as error "The group variable should be nested within the clustering variable."
537.         di as input _continue ""
538.         exit
539.         }
540.         
. }
541. 
. ///// Declaring data as panel //
> xtset group_XX time_XX
542. 
. ///// Creating first-differenced outcome and treatment//
> capture drop diff_y_XX
543. capture drop diff_d_XX
544. gen diff_y_XX = d.outcome_XX
545. g diff_d_XX = d.treatment_XX
546. 
. ////////// 3. Necessary pre-estimation steps when the controls option is specified.
> 
. if "`controls'" !="" | "`hdfe_controls'" != ""{
547. 
. if "`controls'" != "" {
548. local count_controls=0
549. 
. capture drop fd_X_all_non_missing_XX
550. gen fd_X_all_non_missing_XX=1
551. 
. foreach var of varlist `controls'{
552. 
. local count_controls=`count_controls'+1
553. 
. capture drop diff_X`count_controls'_XX
554. capture drop avg_diff_X`count_controls'_XX
555. capture drop resid_X`count_controls'_time_FE_XX
556. 
. ///// Computing the first differences of the control variables
> 
. xtset group_XX time_XX
557. gen diff_X`count_controls'_XX=D.`var'
558. replace fd_X_all_non_missing_XX=0 if diff_X`count_controls'_XX==.
559. }
560. 
. ///// Residualization, and computation of term entering variance. 
> 
. local count_controls=0
561. local mycontrols_XX ""
562. local prod_controls_y ""
563. 
. foreach var of varlist `controls'{
564. local count_controls=`count_controls'+1
565. 
. capture drop sum_weights_control_XX //So as to consider the weighted regressions.
566. 
. // Computing  \Delta X_{.,t}: average of controls' first difference at time t, 
. // among groups whose treatment has not changed yet.
. 
. bys time_XX d_sq_XX `trends_nonparam' : gegen sum_weights_control_XX = total(N_gt_XX) if ever_change_d_XX==0&diff_y_XX!=.&fd_X_all_non_mis
> sing_XX==1
567. bys time_XX d_sq_XX `trends_nonparam' : gegen avg_diff_X`count_controls'_XX = total(N_gt_XX*diff_X`count_controls'_XX) if ever_change_d
> _XX==0&diff_y_XX!=.&fd_X_all_non_missing_XX==1
568. 
. bys time_XX d_sq_XX `trends_nonparam' : replace avg_diff_X`count_controls'_XX = avg_diff_X`count_controls'_XX/sum_weights_control_XX
569. 
. // Computing \Delta\Dot{X}_{g,t}, the difference between the first differences 
. // of covariates and the average of their first-difference, which gives us 
. // the residuals of a regression of covariates on time fixed effects. 
. //Multiply by sqrt(N_gt_XX) to replicate weighted regression.
. 
. gen resid_X`count_controls'_time_FE_XX = sqrt(N_gt_XX)*(diff_X`count_controls'_XX - avg_diff_X`count_controls'_XX)
570. 
. replace resid_X`count_controls'_time_FE_XX=0 if resid_X`count_controls'_time_FE_XX==.
571. 
. // Storing the obtained residuals for the computation of theta_d
. local mycontrols_XX "`mycontrols_XX' resid_X`count_controls'_time_FE_XX"
572. 
. // Generating the product between \Delta\Dot{X}_{g,t} and \Delta Y_{g,t}
. //Multiply by sqrt(N_gt_XX) to replicate weighted regression
. capture drop prod_X`count_controls'_Ngt_XX
573. // Delete those we do not need anymore
. capture drop prod_X`count_controls'_diff_y_temp_XX
574. capture drop prod_X`count_controls'_diff_y_XX
575. capture drop diff_y_wXX
576. gen diff_y_wXX = sqrt(N_gt_XX)*diff_y_XX
577. 
. * Note: resid_X`count_controls'_time_FE_XX is already multiplied by sqrt(N_gt_XX)
. gen prod_X`count_controls'_Ngt_XX=resid_X`count_controls'_time_FE_XX*sqrt(N_gt_XX)
578. replace prod_X`count_controls'_Ngt_XX=0 if prod_X`count_controls'_Ngt_XX==.
579. 
. }
580. 
. } // end of `if "`controls'" != ""` setup (hdfe_controls-only path skips it)
581. else {
582. * hdfe_controls without controls: minimal pre-residualization setup
. local count_controls=0
583. capture drop fd_X_all_non_missing_XX
584. gen fd_X_all_non_missing_XX=1
585. }
586. 
. ///// Computing the Den_d matrices and their inverts,
> ///// and creating locals storing the status quos for which Den_d^{-1} not defined.
> 
. local store_singular_XX ""
587. local store_noresidualization_XX ""
588. local levels_d_sq_XX_final ""
589. 
. levelsof d_sq_int_XX, local(levels_d_sq_XX)
590. 
. if "`hdfe_controls'" == "" {
591. 
. foreach l of local levels_d_sq_XX {
592. 
. capture drop E_y_hat_gt_int_`l'_XX
593. 
. // Running residualization regression to compute predicted values
. 
. local controlsXX ""
594. forv i = 1/`count_controls'{
595.         local controlsXX "`controlsXX' diff_X`i'_XX"
596. }
597. 
. *Modif Clément 30/6/2025
. *cap reg diff_y_XX `controlsXX' ibn.time_XX [aw=N_gt_XX] if d_sq_int_XX==`l'&time_XX<F_g_XX, noconst
. if "`trends_nonparam'" == "" {
598. cap reg diff_y_XX `controlsXX' ibn.time_XX [aw=N_gt_XX] if d_sq_int_XX==`l'&time_XX<F_g_XX, noconst
599. }
600. if "`trends_nonparam'" != "" {
601. capture drop trends_nonparam_temp_XX
602. gegen trends_nonparam_temp_XX=group(`trends_nonparam')  
603. cap reg diff_y_XX `controlsXX' ibn.time_XX#ibn.trends_nonparam_temp_XX [aw=N_gt_XX] if d_sq_int_XX==`l'&time_XX<F_g_XX, noconst
604. }
605. *End Modif Clément 19/6/2025
. 
. if (_rc == 0) {
606. predict E_y_hat_gt_int_`l'_XX if d_sq_int_XX==`l'&time_XX<F_g_XX
607. *Modif Clément 19/6/2025
. capture drop trends_nonparam_temp_XX
608. *End Modif Clément 19/6/2025
.         tempfile data_XX
609.         save "`data_XX'.dta", replace
610.         
. // A baseline treatment is relevant iff it is taken by at least two groups with different values of F_g_XX
. // and non-missing diff_y_XX, otherwise we do not need to perform the residualization for this specific baseline treatment.
. 
. scalar store_singular_`l'_XX = 0 
611. tab F_g_XX if d_sq_int_XX==`l'  
612. 
. scalar useful_res_`l'_XX = `r(r)'
613.         if (scalar(useful_res_`l'_XX)>1){
614. 
. // Isolate the observations used in the computation of theta_d
. 
. keep if ever_change_d_XX==0&diff_y_XX!=.&fd_X_all_non_missing_XX==1&d_sq_int_XX==`l'
615. 
. // Using the matrix accum function, to regress the first difference of outcome on the first differences of covariates. We will obtain the 
> vectors of coefficients \theta_d s, where d indexes values of the baseline treatment.
. 
. capture matrix accum overall_XX = diff_y_wXX `mycontrols_XX'
616. scalar rc_XX=_rc
617. 
. if scalar(rc_XX)!=0{
618. scalar store_singular_`l'_XX = 1
619. local store_noresidualization_XX "`store_noresidualization_XX' `l'"
620. scalar useful_res_`l'_XX=1
621. }
622. 
. else {
623.         
. // Isolate the parts of the matrix we need
. matrix didmgt_XX = overall_XX[2..`=`count_controls'+1',2..`=`count_controls'+1']
624. matrix didmgt_Xy = overall_XX[2..`=`count_controls'+1',1]
625. 
. // Computing the vectors of coefficients \theta_d s for each value of the baseline treatment
. matrix coefs_sq_`l'_XX = invsym(didmgt_XX)*didmgt_Xy
626. local levels_d_sq_XX_final "`levels_d_sq_XX_final' `l'" // Added local so as to avoid adding to the final block non-existent coefficien
> ts.
627. 
.                 // Computing the matrix Den^{-1}_d
.                         //Check first if the matrix is invertible, invsym() inverts a matrix even if it is singular
.                         capture drop scalar det_XX
628.                         scalar det_XX = det(didmgt_XX)
629. 
.                 if (abs(scalar(det_XX))<=10^(-16)){ 
630.                                         scalar store_singular_`l'_XX = 1
631.                                         scalar drop det_XX
632.                 }
633. 
.                 // Changes Diego 27-03-25: N_c_`l'_XX adjustment
.                 sum F_g_XX
634.                 gen N_c_`l'_temp_XX = time_XX >= 2 & time_XX <= r(max) - 1 & time_XX < F_g_XX & diff_y_XX < .
635.                 sum N_gt_XX if N_c_`l'_temp_XX == 1
636. 
.                 matrix inv_Denom_`l'_XX = invsym(didmgt_XX)*r(sum)*G_XX
637.                 drop N_c_`l'_temp_XX
638. }
639. 
. use "`data_XX'.dta", clear
640. 
. }
641. }
642. else {
643. *Modif Clément 19/6/2025
. capture drop trends_nonparam_temp_XX
644. *End Modif Clément 19/6/2025
.     drop if d_sq_int_XX == `l'
645.     noi di "Baseline Treatment Level `l' dropped because of insufficient observations."
646. }
647. 
. }
648. 
. } // end `if "`hdfe_controls'" == ""` (matrix accum path)
649. else {
650. 
. * hdfe_controls path: fit one level model per baseline l using reghdfe.
. * The level fit on Y_level_XX automatically absorbs group_XX (unit FE),
. * time_XX (or trends_nonparam interaction), and whatever the user passes
. * in hdfe_controls(). The long-difference of yhat_lvl is subtracted from
. * diff_y later (per i) instead of coefs_sq*diff_X.
. 
. local hdfe_absorb_XX "group_XX `hdfe_controls'"
651. if "`trends_nonparam'" != "" {
652.     capture drop trends_nonparam_temp_XX
653.     gegen trends_nonparam_temp_XX = group(`trends_nonparam')
654.     local hdfe_absorb_XX "`hdfe_absorb_XX' i.time_XX#i.trends_nonparam_temp_XX"
655. }
656. else {
657.     local hdfe_absorb_XX "`hdfe_absorb_XX' time_XX"
658. }
659. 
. foreach l of local levels_d_sq_XX {
660. 
.     capture drop yhat_lvl_`l'_XX
661.     capture drop E_y_hat_gt_int_`l'_XX
662.     scalar store_singular_`l'_XX = 0
663. 
.     tab F_g_XX if d_sq_int_XX==`l'
664.     scalar useful_res_`l'_XX = `r(r)'
665. 
.     if (scalar(useful_res_`l'_XX)>1) {
666.         * fit on the not-yet-switched same-D_g,1 sample (mirrors line 1030 keep)
.         cap reghdfe Y_level_XX `controls' [aw=N_gt_XX] ///
>             if ever_change_d_XX==0 & fd_X_all_non_missing_XX==1 ///
>                & d_sq_int_XX==`l' & time_XX < F_g_XX, ///
>             absorb(`hdfe_absorb_XX')
667.         if _rc != 0 {
668.             scalar store_singular_`l'_XX = 1
669.             local store_noresidualization_XX "`store_noresidualization_XX' `l'"
670.             scalar useful_res_`l'_XX = 1
671.         }
672.         else {
673.             * default predict: includes absorbed FE contribution. Predict on every
.             * obs so that long-diffs `yhat_lvl - L`i'.yhat_lvl` are defined past F_g.
.             predict yhat_lvl_`l'_XX
674.             local levels_d_sq_XX_final "`levels_d_sq_XX_final' `l'"
675.             * Placeholder so downstream `gen E_y_hat_gt_`l'_XX = E_y_hat_gt_int_`l'_XX * ...`
.             * doesn't error. Only fed into in_sum_temp (analytical SE), which is gated.
.             gen double E_y_hat_gt_int_`l'_XX = 0 if d_sq_int_XX==`l' & time_XX < F_g_XX
676.         }
677.     }
678.     else {
679.         capture drop trends_nonparam_temp_XX
680.         drop if d_sq_int_XX == `l'
681.         noi di "Baseline Treatment Level `l' dropped because of insufficient observations."
682.     }
683. }
684. capture drop trends_nonparam_temp_XX
685. 
. }
686. 
. //Fill up store_singular_XX, with correct values of statu quo and not the levels -> Modif Felix
. levelsof d_sq_XX, local(levels_d_sq_bis_XX)
687. scalar index_sing_XX = 0
688. foreach l of local levels_d_sq_bis_XX {
689.         scalar index_sing_XX = scalar(index_sing_XX)+1
690.         capture confirm scalar store_singular_`=index_sing_XX'_XX
691.         if _rc==0{
692.                 if(scalar(store_singular_`=index_sing_XX'_XX) == 1){
693.                 local store_singular_XX = "`store_singular_XX' `l'"
694.                 }
695.         }
696. }
697. 
. ///// Display errors if one of the Den_d^{-1} is not defined
> if ("`store_singular_XX'"!=""){
698.         
.         di as error "Some control variables are not taken into account for groups with baseline treatment equal to: [`store_singular_XX']"
699.         di as error "This may occur in the following situations:"
700.         di as error "1. For groups with those values of the baseline treatment, the regression of the outcome first difference on the c
> ontrols' first differences and time fixed effects has fewer observations than variables. Note that for each value of the baseline treatmen
> t, those regressions are estimated among (g,t)s such that g has not changed treatment yet at t."
701.         di as error "2. For groups with those values of the baseline treatment, two or more of your control variables are perfectly col
> linear in the sample where the regression is run, for instance because those control variables do not vary over time."
702.         di as input _continue ""
703. }
704. 
. ///// Values of baseline treatment such that residualization could not be performed at all are dropped.
> foreach l of local store_noresidualization_XX {
705. drop if d_sq_int_XX==`l'
706. }
707. 
. * snapshot total control count so the per-(l, i) residualization application
. * can fire the hdfe diff(yhat_lvl) subtraction exactly once per l (on the
. * last control iteration when controls != "", or directly when controls == "").
. local n_controls_XX = `count_controls'
708. 
. } // end of the if "`controls'" !="" | "`hdfe_controls'" != "" condition
709. 
. ////////// 4. Performing the estimation and storing the results
> 
. ///// Computing L_u/L_a, maximum number of event-study effects that can be computed
> ///// for the switchers in/out, to compare them to number of effects requested,
> ///// and finally determine the number of effects to be estimated.
> ///// Same thing for the placebos.
> 
. // Initializing L_u_XX and L_a_XX with default values.
. scalar L_u_XX=.
710. scalar L_a_XX=.
711. 
. // For switchers in
. if "`switchers'"==""|"`switchers'"=="in"{ 
712. sum L_g_XX if S_g_XX==1
713. scalar L_u_XX=r(max)
714. *For placebos
. if `placebo'!=0{
715. sum L_g_placebo_XX if S_g_XX==1
716. scalar L_placebo_u_XX=r(max)
717. 
. // If the trends_lin option was specified, L_placebo_u_XX should be decreased by 1
. // because data starts at period 2 instead of 1.
. if "`trends_lin'"!=""{
718.         scalar L_placebo_u_XX=L_placebo_u_XX-1
719. }
720. if L_placebo_u_XX==. {
721.     scalar L_placebo_u_XX = 0
722. }
723. }
724. }
725. 
. // For switchers out
. if "`switchers'"==""|"`switchers'"=="out"{
726. sum L_g_XX if S_g_XX==0
727. scalar L_a_XX=r(max)
728. *For placebos
. if `placebo'!=0{
729. sum L_g_placebo_XX if S_g_XX==0
730. scalar L_placebo_a_XX=r(max)
731. if "`trends_lin'"!=""{
732.         scalar L_placebo_a_XX=L_placebo_a_XX-1
733. }
734. if L_placebo_a_XX==. {
735.     scalar L_placebo_a_XX = 0
736. }
737. }
738. }
739. 
. // Error message if Design Restriction 1 is not met
. 
. if ("`switchers'"=="in"&(L_u_XX==.|L_u_XX==0))|("`switchers'"=="out"&(L_a_XX==.|L_a_XX==0))|("`switchers'"==""&(L_u_XX==.|L_u_XX==0)&(L_a_
> XX==.|L_a_XX==0)){
740.         di as error ""
741.         di as error "No treatment effect can be estimated. This is because Design Restriction 1 in de Chaisemartin & D'Haultfoeuille (2
> 024) is not satisfied in the data, given the options requested. This may be due to the fact that groups' period-one treatment is continuou
> s, or takes a large number of values, and you have not specified the continuous option. If so, you can try to specify this option. If the 
> issue persists even with this option, this means that all groups experience their first treatment change at the same date, a situation whe
> re the estimators of de Chaisemartin & D'Haultfoeuille (2024) cannot be used."
742.         di as input _continue ""
743.                 
.         exit
744. }
745. 
. // Checking that the number of dynamic and placebo effects requested by user
. // are feasible, and correcting them if they are not. 
. 
. if "`switchers'"==""{
746. scalar l_XX=max(L_a_XX, L_u_XX)
747. scalar l_XX=min(l_XX, `effects')
748. 
. if `placebo'!=0{
749. scalar l_placebo_XX=max(L_placebo_a_XX, L_placebo_u_XX)
750. scalar l_placebo_XX=min(l_placebo_XX, `placebo')
751. // The number of placebos computed cannot be greater than the number of effects computed:
. scalar l_placebo_XX=min(l_placebo_XX, `effects')
752. }
753. else{
754. scalar l_placebo_XX=0
755. }
756. }
757. 
. if "`switchers'"=="in"{
758.         scalar l_XX=min(`effects', L_u_XX)
759.         if `placebo'!=0{
760.                 scalar l_placebo_XX=min(`placebo', L_placebo_u_XX)
761.                 // The number of placebos computed cannot be greater than the number of effects computed:
.                 scalar l_placebo_XX=min(l_placebo_XX, `effects') 
762.                 }
763. else{
764.         scalar l_placebo_XX=0
765. }
766. }
767. 
. if "`switchers'"=="out"{
768.         scalar l_XX=min(`effects', L_a_XX)
769.                 if `placebo'!=0{
770.                         scalar l_placebo_XX=min(`placebo', L_placebo_a_XX)
771.                         // The number of placebos computed cannot be greater than the number of effects computed:
.                         scalar l_placebo_XX=min(l_placebo_XX, `effects')
772.                 }
773. else{
774.         scalar l_placebo_XX=0
775. }
776. }
777. 
. //If the number of effects or placebos initially asked by user was too large, 
. // display an error message.
. if l_XX<`effects'{
778.         di as error ""
779.         di as error "The number of effects requested is too large. The number of effects which can be estimated is at most " l_XX ". Th
> e command will therefore try to estimate " l_XX " effect(s)."
780.         di as input _continue ""
781. }
782. 
. if `placebo'!=0{
783.         if l_placebo_XX<`placebo'&`effects'>=`placebo'{
784.                 di as error ""
785.                 di as error "The number of placebos which can be estimated is at most " l_placebo_XX ". The command will therefore try 
> to estimate " l_placebo_XX " placebo(s)."
786.                 di as input _continue ""
787.         }
788. 
.         if `effects'<`placebo'{
789.                 di as error ""
790.                 di as error "The number of placebo requested cannot be larger than the number of effects requested. The command cannot 
> compute more than " l_placebo_XX " placebo(s)."
791.                 di as input _continue ""
792.         }
793. }
794. 
. // Adjustment to add more placebos (did_multiplegt_dyn_all_pl)
. local max_pl_u_XX = 0
795. local max_pl_a_XX = 0
796. local max_pl_gap_u_XX = 0
797. local max_pl_gap_a_XX = 0
798. gen pl_gap_XX = (F_g_XX - 2) - L_g_XX if S_g_XX != .
799. if ("`switchers'" == "" | "`switchers'" == "in") {
800.         sum F_g_XX if S_g_XX == 1
801.         local max_pl_u_XX = r(max) - 2
802.         sum pl_gap_XX if S_g_XX == 1
803.         local max_pl_gap_u_XX = r(max)
804. }
805. if ("`switchers'" == "" | "`switchers'" == "out") {
806.         sum F_g_XX if S_g_XX == 0
807.         local max_pl_a_XX = r(max) - 2
808.         sum pl_gap_XX if S_g_XX == 0
809.         local max_pl_gap_a_XX = r(max)
810. }
811. scalar max_pl_XX = max(`max_pl_u_XX', `max_pl_a_XX')
812. scalar max_pl_gap_XX = max(`max_pl_gap_u_XX', `max_pl_gap_a_XX')
813. drop pl_gap_XX
814. 
. ///// Start the by_path option here -> after defining l_XX etc. but before calling the core program
> if "`by_path'"!=""{
815. 
. // Disentangle all the treatment paths and match switchers with those paths with not yet switchers with the same baseline that can be used
>  as controls
. forvalues k=0/`=l_XX'{
816.         gen dummy_treat_`k'_temp=treatment_XX if time_XX==F_g_XX-1+`k'
817.         gegen dummy_treat_`k'=max(dummy_treat_`k'_temp), by(group_XX)
818.         capture drop dummy_treat_`k'_temp
819. }
820. // Variable grouping all groups that follow exactly the same treatment path from F_g-1 to F_g-1+\ell
