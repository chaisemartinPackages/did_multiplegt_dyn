> ereturn matrix estimates=didmgt_b2 
> ereturn matrix didmgt_variances=didmgt_var2
> ereturn matrix variances= compatibility_variances
> ereturn local cmd "did_multiplegt_dyn"
> */
. 
. 
. ////////// 6. Computing p-values from the tests 
> 
. //// Generate combined Variance-Covariance Matrix for honestdid
> // Note: Check if all of them are defined!
. // If test is feasible, initalize scalar at 0
.                 scalar all_Ns_pl_not_zero=0
1414.                 scalar all_delta_pl_not_zero=0
1415.                 
.                 // Count the number of placebos that can be estimated
.                 forvalue i=1/`=l_placebo_XX'{
1416.                 if ("`switchers'"==""&(N1_placebo_`i'_XX_new!=0|N0_placebo_`i'_XX_new!=0))|("`switchers'"=="out"&N0_placebo_`i'_XX_new
> !=0)|("`switchers'"=="in"&N1_placebo_`i'_XX_new!=0){
1417.                         scalar all_Ns_pl_not_zero=all_Ns_pl_not_zero+1
1418.                         
.                 }
1419.                 // Count the number of normalized placebos that can be estimated
.                 if "`normalized'"!=""{
1420.                 if (delta_D_pl_`i'_global_XX!=0 & delta_D_pl_`i'_global_XX!=.){
1421.                         scalar all_delta_pl_not_zero=all_delta_pl_not_zero+1
1422.                 }
1423.                 }
1424.                 }
1425.                 
.                 scalar all_Ns_not_zero=0
1426.         
.                 forvalue i=1/`=l_XX'{
1427.                 if ("`switchers'"==""&(N1_`i'_XX_new!=0|N0_`i'_XX_new!=0))|("`switchers'"=="out"&N0_`i'_XX_new!=0)|("`switchers'"=="in
> "&N1_`i'_XX_new!=0){
1428.                         scalar all_Ns_not_zero=all_Ns_not_zero+1
1429.                         }
1430.         }
1431.                 
. if ((all_Ns_pl_not_zero==l_placebo_XX & "`normalized'"=="")|(all_Ns_pl_not_zero==l_placebo_XX & "`normalized'"!="" & all_delta_pl_not_zero
> ==l_placebo_XX))&all_Ns_not_zero==l_XX{               
1432. 
. // Creating a matrix where the variances and the covariances will be stored.
. matrix didmgt_Var_all_XX=J(`=l_XX'+`=l_placebo_XX',`=l_XX'+`=l_placebo_XX',0)
1433. 
. local total_num_estimates_XX=`=l_XX'+`=l_placebo_XX'
1434. 
. // combine effects and placebos in "one" variable with running index (similarly for scalars storing the se's)
. capture drop U_Gg_var_comb_*_XX
1435. forvalue i=1/`=l_XX'{
1436.         gen U_Gg_var_comb_`i'_XX=U_Gg_var_glob_`i'_XX
1437.         scalar se_all_`i'_XX=se_`i'_XX
1438.         if "`normalized'"!=""{
1439.                 scalar delta_D_all_`i'_XX=delta_D_`i'_global_XX
1440.         }
1441. }
1442. forvalue i=`=l_XX+1'/`total_num_estimates_XX'{
1443.         local j=`i'-`=l_XX'
1444.         gen U_Gg_var_comb_`i'_XX=U_Gg_var_glob_pl_`j'_XX
1445.         scalar se_all_`i'_XX=se_placebo_`j'_XX
1446.         if "`normalized'"!=""{
1447.                 scalar delta_D_all_`i'_XX=delta_D_pl_`j'_global_XX
1448.         }
1449. }
1450. 
. 
. // If the option cluster is specified, we have previously replaced U_Gg_var_glob_pl_`i'_XX by clust_U_Gg_var_glob_pl_`i'_XX, and U_Gg_var_
> glob_`i'_XX by clust_U_Gg_var_glob_`i'_XX. 
. // Now, we must also replace first_obs_by_gp_XX by first_obs_by_clust_XX
. if "`cluster'"!=""{
1451. replace first_obs_by_gp_XX=first_obs_by_clust_XX
1452. }
1453. 
. forvalue i=1/`total_num_estimates_XX'{
1454.                 
.                 // Fill the diagonal with the Variances
.                 matrix didmgt_Var_all_XX[`i',`i']= scalar(se_all_`i'_XX)^2
1455.         
.                 // Fill off diagonal with covariances
.                 if `i'<`total_num_estimates_XX'{
1456.                 forvalue j=`=`i'+1'/`total_num_estimates_XX'{
1457.                         
.                         * Create variables necessary to compute the covariances
.                         capture drop U_Gg_var_comb_`i'_`j'_XX
1458.                         capture drop U_Gg_var_comb_`i'_`j'_2_XX
1459.                                         
.                         if ("`normalized'"==""){
1460.                         gen U_Gg_var_comb_`i'_`j'_XX = U_Gg_var_comb_`i'_XX + U_Gg_var_comb_`j'_XX
1461.                 }
1462.                         
.                         // Also need adjusted delta_D for all effects!!!
.                         if "`normalized'"!=""{
1463.                         gen U_Gg_var_comb_`i'_`j'_XX = U_Gg_var_comb_`i'_XX/scalar(delta_D_all_`i'_XX) + U_Gg_var_comb_`j'_XX/scalar(d
> elta_D_all_`j'_XX)
1464.                 }
1465. 
.                         * Estimate the covariances
.                         gen U_Gg_var_comb_`i'_`j'_2_XX = U_Gg_var_comb_`i'_`j'_XX^2*first_obs_by_gp_XX
1466.                         
.                         
.                         sum U_Gg_var_comb_`i'_`j'_2_XX
1467.                         scalar var_sum_comb_`i'_`j'_XX=r(sum)/G_XX^2
1468.                         
.                         scalar cov_comb_`i'_`j'_XX = (scalar(var_sum_comb_`i'_`j'_XX) - scalar(se_all_`i'_XX)^2 - scalar(se_all_`j'_XX)^2)
> /2
1469.         
.                         * Store the results
.                         matrix didmgt_Var_all_XX[`i',`j']= scalar(cov_comb_`i'_`j'_XX)
1470.                         matrix didmgt_Var_all_XX[`j',`i']= scalar(cov_comb_`i'_`j'_XX)
1471. 
.                 }
1472.         }
1473.         
. }
1474. 
. *** Modif Felix: replace by bootstrap var/cov matrix
. if `bootstrap_XX'!=0{
1475.         matrix didmgt_Var_all_XX=bs_var_cov_XX
1476. }
1477. 
. }
1478.         // Error message if not all of the specified effects/placebos could be estimated 
.         else{
1479.                 di as error ""
1480.                 di as error "Some placebos/effects could not be estimated. Therefore, the command will not be compatible with the hone
> stdid command."
1481.                 di as input _continue ""
1482.         }
1483. 
. ///// Performing a test that all placebo are jointly equal to 0.
> 
. // initalize scalar
. scalar all_Ns_pl_not_zero=.
1484. scalar all_delta_pl_not_zero=.
1485. 
. // Test can only be run when at least two placebos requested:
. if (l_placebo_XX!=0)&l_placebo_XX>1{
1486. 
.                 // If test is feasible, initalize scalar at 0
.                 scalar all_Ns_pl_not_zero=0
1487.                 scalar all_delta_pl_not_zero=0
1488.                 
.                 // Count the number of placebos that can be estimated
.                 forvalue i=1/`=l_placebo_XX'{
1489.                 if ("`switchers'"==""&(N1_placebo_`i'_XX_new!=0|N0_placebo_`i'_XX_new!=0))|("`switchers'"=="out"&N0_placebo_`i'_XX_new
> !=0)|("`switchers'"=="in"&N1_placebo_`i'_XX_new!=0){
1490.                         scalar all_Ns_pl_not_zero=all_Ns_pl_not_zero+1
1491.                         
.                 }
1492.                 // Count the number of normalized placebos that can be estimated
.                 if "`normalized'"!=""{
1493.                 if (delta_D_pl_`i'_global_XX!=0 & delta_D_pl_`i'_global_XX!=.){
1494.                         scalar all_delta_pl_not_zero=all_delta_pl_not_zero+1
1495.                 }
1496.                 }
1497.                 }
1498. 
.         // Test can only be run when all requested placebos could be computed:
.         // Add condition with normalized
.         if (all_Ns_pl_not_zero==l_placebo_XX & "`normalized'"=="")|(all_Ns_pl_not_zero==l_placebo_XX & "`normalized'"!="" & all_delta_pl_n
> ot_zero==l_placebo_XX){
1499. 
.         // Creating a vector with all placebo estimates
.         matrix didmgt_Placebo=J(l_placebo_XX,1,0)
1500.         
.         // Creating a matrix where the variances and the covariances of the placebos will be stored.
.         matrix didmgt_Var_Placebo=J(l_placebo_XX,l_placebo_XX,0)
1501.         
.         // Fill those matrices
.         forvalue i=1/`=l_placebo_XX'{
1502.                 
.                 matrix didmgt_Placebo[`i',1]=scalar(DID_placebo_`i'_XX)
1503.                 matrix didmgt_Var_Placebo[`i',`i']= scalar(se_placebo_`i'_XX)^2
1504.         
.                 if `i'<`=l_placebo_XX'{
1505.                 forvalue j=`=`i'+1'/`=l_placebo_XX'{
1506.                         
.                         * Create variables necessary to compute the covariances
.                         capture drop U_Gg_var_pl_`i'_`j'_XX
1507.                         capture drop U_Gg_var_pl_`i'_`j'_2_XX
1508.                                         
.                         if ("`normalized'"==""){
1509.                         gen U_Gg_var_pl_`i'_`j'_XX = U_Gg_var_glob_pl_`i'_XX + U_Gg_var_glob_pl_`j'_XX
1510.                 }
1511.                         
.                         if "`normalized'"!=""{
1512.                         gen U_Gg_var_pl_`i'_`j'_XX = U_Gg_var_glob_pl_`i'_XX/scalar(delta_D_pl_`i'_global_XX) + U_Gg_var_glob_pl_`j'_X
> X/scalar(delta_D_pl_`j'_global_XX)
1513.                 }
1514. 
.                         * Estimate the covariances
.                         gen U_Gg_var_pl_`i'_`j'_2_XX = U_Gg_var_pl_`i'_`j'_XX^2*first_obs_by_gp_XX
1515.                         
.                         sum U_Gg_var_pl_`i'_`j'_2_XX
1516.                         scalar var_sum_pla_`i'_`j'_XX=r(sum)/G_XX^2
1517.                         
.                         scalar cov_pl_`i'_`j'_XX = (scalar(var_sum_pla_`i'_`j'_XX) - scalar(se_placebo_`i'_XX)^2 - scalar(se_placebo_`j'_X
> X)^2)/2
1518.         
.                         * Store the results
.                         matrix didmgt_Var_Placebo[`i',`j']= scalar(cov_pl_`i'_`j'_XX)
1519.                         matrix didmgt_Var_Placebo[`j',`i']= scalar(cov_pl_`i'_`j'_XX)
1520. 
.                 }
1521.         }
1522.         
.         }
1523.         
.         *** Modif Felix: replace matrix with bootstrap
.         if `bootstrap_XX'!=0{
1524.                 matrix didmgt_Var_Placebo=bs_var_cov_XX["_bs_`=l_XX+1'".."_bs_`=l_XX+l_placebo_XX'","_bs_`=l_XX+1'".."_bs_`=l_XX+l_pla
> cebo_XX'"]
1525.         }       
1526.         
.         // Compute P-value for the F-test on joint nullity of all placebos
.         matrix didmgt_Var_Placebo_inv=invsym(didmgt_Var_Placebo)
1527.         matrix didmgt_Placebo_t=didmgt_Placebo'
1528.         matrix didmgt_chi2placebo=didmgt_Placebo_t*didmgt_Var_Placebo_inv*didmgt_Placebo
1529.         
.         
.         
.         *Modif David 05_02_2026: check that matrix has full rank before performing the test:
.         * Check rank of didmgt_Var_Placebo
.         matrix symeigen X_pl v_pl = didmgt_Var_Placebo
1530.         scalar warning_pl= abs(v_pl[1,1]/v_pl[rowsof(v_pl), colsof(v_pl)])
1531.         if (warning_pl != .) {
1532.                 scalar p_jointplacebo=1-chi2(l_placebo_XX,didmgt_chi2placebo[1,1])
1533.                 ereturn scalar p_jointplacebo=1-chi2(l_placebo_XX,didmgt_chi2placebo[1,1])
1534.                 }
1535.         if (warning_pl == .){
1536.                 scalar p_jointplacebo=.
1537.                 ereturn scalar p_jointplacebo=.
1538.                 }
1539. 
.         }
1540.         
.         // Error message if not all of the specified placebos could be estimated 
.         else{
1541.                 di as error ""
1542.                 di as error "Some placebos could not be estimated. Therefore, the test of joint nullity of the placebos could not be c
> omputed."
1543.                 di as input _continue ""
1544.         }
1545.         
. }
1546. 
. 
. ///// Performing a test that all DID_\ell effects are equal to 0 
> // Felix: This will be automatically reported in case there are at least two effects requested and none are missign
. 
. // initalize scalar
. scalar all_Ns_not_zero=.
1547. scalar all_delta_not_zero=.
1548. 
. // Test can only be run when at least two placebos requested:
. if l_XX>1{
1549. 
.                 // If test is feasible, initalize scalar at 0
.                 scalar all_Ns_not_zero=0
1550.                 scalar all_delta_not_zero=0
1551.                 
.                 // Count the number of effects that can be estimated
.                 forvalue i=1/`=l_XX'{
1552.                 if ("`switchers'"==""&(N1_`i'_XX_new!=0|N0_`i'_XX_new!=0))|("`switchers'"=="out"&N0_`i'_XX_new!=0)|("`switchers'"=="in
> "&N1_`i'_XX_new!=0){
1553.                         scalar all_Ns_not_zero=all_Ns_not_zero+1
1554.                         
.                 }
1555.                 // Count the number of normalized effects that can be estimated
.                 if "`normalized'"!=""{
1556.                 if (delta_D_`i'_global_XX!=0 & delta_D_`i'_global_XX!=.){
1557.                         scalar all_delta_not_zero=all_delta_not_zero+1
1558.                 }
1559.                 }
1560.                 }
1561. 
.         // Test can only be run when all requested effects could be computed:
.         // Add condition with normalized
.         if (all_Ns_not_zero==l_XX & "`normalized'"=="")|(all_Ns_not_zero==l_XX & "`normalized'"!="" & all_delta_not_zero==l_XX){
1562. 
.         // Creating a vector with all placebo estimates
.         matrix didmgt_effects=J(l_XX,1,0)
1563.         
.         // Creating a matrix where the variances and the covariances of the placebos will be stored.
.         matrix didmgt_Var_effects=J(l_XX,l_XX,0)
1564.         
.         // Fill those matrices
.         forvalue i=1/`=l_XX'{
1565.                 
.                 matrix didmgt_effects[`i',1]=scalar(DID_`i'_XX)
1566.                 matrix didmgt_Var_effects[`i',`i']= scalar(se_`i'_XX)^2
1567.         
.                 if `i'<`=l_XX'{
1568.                 forvalue j=`=`i'+1'/`=l_XX'{
1569.                         
.                         * Create variables necessary to compute the covariances
.                         capture drop U_Gg_var_`i'_`j'_XX
1570.                         capture drop U_Gg_var_`i'_`j'_2_XX
1571.                                         
.                         if ("`normalized'"==""){
1572.                         gen U_Gg_var_`i'_`j'_XX = U_Gg_var_glob_`i'_XX + U_Gg_var_glob_`j'_XX
1573.                 }
1574.                         
.                         if "`normalized'"!=""{
1575.                         gen U_Gg_var_`i'_`j'_XX = U_Gg_var_glob_`i'_XX/scalar(delta_D_`i'_global_XX) + U_Gg_var_glob_`j'_XX/scalar(del
> ta_D_`j'_global_XX)
1576.                 }
1577. 
.                         * Estimate the covariances
.                         gen U_Gg_var_`i'_`j'_2_XX = U_Gg_var_`i'_`j'_XX^2*first_obs_by_gp_XX
1578.                         
.                         sum U_Gg_var_`i'_`j'_2_XX
1579.                         scalar var_sum_`i'_`j'_XX=r(sum)/G_XX^2
1580.                         
.                         scalar cov_`i'_`j'_XX = (scalar(var_sum_`i'_`j'_XX) - scalar(se_`i'_XX)^2 - scalar(se_`j'_XX)^2)/2
1581.         
.                         * Store the results
.                         matrix didmgt_Var_effects[`i',`j']= scalar(cov_`i'_`j'_XX)
1582.                         matrix didmgt_Var_effects[`j',`i']= scalar(cov_`i'_`j'_XX)
1583. 
.                 }
1584.         }
1585.         
.         }
1586.         
.         *** Modif Felix: replace matrix with bootstrap
.         if `bootstrap_XX'!=0{
1587.                 matrix didmgt_Var_eff=bs_var_cov_XX["_bs_`=1'".."_bs_`=l_XX'","_bs_`=1'".."_bs_`=l_XX'"]
1588.         }       
1589.         
.         // Compute P-value for the F-test on joint nullity of all effects
.         matrix didmgt_Var_effects_inv=invsym(didmgt_Var_effects)
1590.         matrix didmgt_effects_t=didmgt_effects'
1591.         matrix didmgt_chi2effects=didmgt_effects_t*didmgt_Var_effects_inv*didmgt_effects
1592.         
.         
.         *Modif David 05_02_2026: check that matrix has full rank before performing the test:
.         * Check rank of didmgt_Var_effects
.         matrix symeigen X_eff v_eff = didmgt_Var_effects
1593.         scalar warning_eff= abs(v_eff[1,1]/v_eff[rowsof(v_eff), colsof(v_eff)])
1594.         if (warning_eff != .) {
1595.                 scalar p_jointeffects=1-chi2(l_XX,didmgt_chi2effects[1,1])
1596.                 ereturn scalar p_jointeffects=1-chi2(l_XX,didmgt_chi2effects[1,1])
1597.                 }
1598.         if (warning_eff == .){
1599.                 scalar p_jointeffects=.
1600.                 ereturn scalar p_jointeffects=.
1601.                 }
1602. 
.         }
1603.         
.         // Error message if not all of the specified placebos could be estimated 
.         else{
1604.                 di as error ""
1605.                 di as error "Some effects could not be estimated. Therefore, the test of joint nullity of the effects could not be com
> puted."
1606.                 di as input _continue ""
1607.         }
1608.         
. }
