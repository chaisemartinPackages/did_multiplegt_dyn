981.         capture drop count`i'_pl_plus_XX
982.         capture drop  count`i'_pl_minus_XX
983.         capture drop count`i'_pl_global_XX
984.         
.         gen U_Gg_pl_`i'_plus_XX   = 0
985.         gen U_Gg_pl_`i'_minus_XX   = 0
986.         scalar N1_placebo_`i'_XX=0
987.         scalar N0_placebo_`i'_XX=0
988.         gen U_Gg_var_pl_`i'_in_XX=0
989.         gen U_Gg_var_pl_`i'_out_XX=0
990.         scalar sum_for_var_placebo_in_XX=0
991.         scalar sum_for_var_placebo_out_XX=0
992.         gen count`i'_pl_plus_XX = 0
