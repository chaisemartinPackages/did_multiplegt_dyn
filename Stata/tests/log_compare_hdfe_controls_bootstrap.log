1184.         }
1185. }
1186. 
. ereturn scalar N_placebo_`i' = N_placebo_`i'_XX
1187. matrix mat_res_XX[`=l_XX' + 1 + `i',5]=N_placebo_`i'_XX
1188. matrix mat_res_XX[`=l_XX'+ 1 + `i',6]=N_switchers_placebo_`i'_XX
1189. 
. // Modif Felix weight
. if "`weight'"!=""{
1190.         matrix mat_res_XX[`=l_XX'+ 1 + `i',6]=N1_`i'_pl_XX_weight+N0_`i'_pl_XX_weight
1191.         ereturn scalar N_switchers_placebo_`i'_w=N1_`i'_pl_XX_weight+N0_`i'_pl_XX_weight
