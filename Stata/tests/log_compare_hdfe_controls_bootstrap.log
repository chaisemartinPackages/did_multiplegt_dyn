. gen U_Gg_global_XX = w_plus_XX*U_Gg_plus_XX +(1-w_plus_XX)*U_Gg_minus_XX
1088. replace U_Gg_global_XX=. if first_obs_by_gp_XX==0
1089. 
. // Averaging the U_Gg to compute average total effect
. 
. gegen delta_XX = total(U_Gg_global_XX)
1090. replace delta_XX = delta_XX/G_XX
1091. scalar delta_XX = delta_XX
1092. ereturn scalar Av_tot_effect = scalar(delta_XX)
1093. 
. // Completing the results matrix
. 
. * Storing the results
. matrix mat_res_XX[l_XX+1,1]= scalar(delta_XX)
1094. local rownames "`rownames' Av_tot_eff" 
1095. * Number of switchers
. scalar N_switchers_effect_XX=0
1096. forvalue i=1/`=l_XX'{
