1218. 
. //// Add bootstrap 
> if `bootstrap_XX'!=0{
1219.         
.         // Save "pre-bootstraped" results matrix so it does not get overwritten 
.         matrix mat_res_bs_XX=mat_res_XX
1220.         
.         // Save "pre-bootstrap" data 
.         qui tempfile data_pre_bootstrap_XX
1221.         qui save "`data_pre_bootstrap_XX'.dta", replace
1222.         
.         // Load original data 
.         use "`data_bootstrap_XX'.dta", clear
1223.         
.         // gen numlists
.         numlist "1/`=l_XX'"
1224.         local num_eff_XX "`r(numlist)'"
1225.         // Adjust for missings
.         local num_eff_XX: list num_eff_XX- missing_eff_XX
1226.         
.         if `=l_placebo_XX'>0{
1227.         numlist "1/`=l_placebo_XX'"
