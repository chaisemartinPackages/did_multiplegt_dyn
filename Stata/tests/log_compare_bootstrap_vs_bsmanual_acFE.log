. ********************************************************************************
. *                                 PROGRAM 2                                    *
. ********************************************************************************
. *Main goal: compute the variables U_Gg_plus_XX, U_Gg_minus_XX, U_Gg_var_plus_XX, and U_Gg_var_minus_XX,
. *which are necessary to compute the DID_\ell estimators and their variance.
. 
. capture program drop did_multiplegt_dyn_core_new

. 
. program did_multiplegt_dyn_core_new, eclass
  1.         version 12.0
  2.         syntax varlist(min=4 max=4 numeric) [, effects(integer 1) placebo(integer 0) switchers(string) only_never_switchers controls(va
> rlist numeric) trends_nonparam(varlist numeric) weight(varlist numeric) dont_drop_larger_lower NORMALIZED cluster(varlist numeric) graphop
> tions(string) SAVe_results(string) graph_off same_switchers same_switchers_pl drop_if_d_miss_before_first_switch trends_lin ci_level(integ
> er 95) by(varlist numeric max=1) predict_het(string) design(string) date_first_switch(string) NORMALIZED_weights CONTinuous(string) switch
> ers_core(string) less_conservative_se]
  3.         qui{
  4.                 
. ////////// 1. Scalars initialization
> 
. ///// Initializing the number of effects and placebos to estimate, depending on whether we consider switchers in or switchers out. 
> ///// Initializing also a scalar for whether the estimation is for switchers in or out.
>         
. if "`switchers_core'"=="in"{
  5. scalar l_u_a_XX=min(`effects', L_u_XX)
  6. 
. if `placebo'!=0{
  7.         scalar l_placebo_u_a_XX=min(`placebo', L_placebo_u_XX)
  8.         }
  9. 
.         scalar increase_XX=1
 10. }
 11. 
. if "`switchers_core'"=="out"{
 12. scalar l_u_a_XX=min(`effects', L_a_XX)
 13. 
. if `placebo'!=0{
 14.         scalar l_placebo_u_a_XX=min(`placebo', L_placebo_a_XX)
 15.         }
 16. 
. scalar increase_XX=0
 17. }
 18. 
. ///// Initializing values of baseline treatment
> levelsof d_sq_int_XX, local(levels_d_sq_XX)
 19. 
. ////////// 2. Data preparation steps to generate variables necessary for computation of event-study effects     
> 
. ///// Drop some variables we only create once
> capture drop num_g_paths_0_XX
 20. capture drop cohort_fullpath_0_XX
 21. capture drop path_0_XX
 22. capture drop d_fg0_XX 
 23. 
. ///// Loop over the number of dynamic effects_equal
> 
. forvalue i=1/`=l_u_a_XX'{
 24. 
. ///// Capture drop of variables created below
> 
. capture drop distance_to_switch_`i'_XX
 25. capture drop never_change_d_`i'_XX
 26. capture drop N`=increase_XX'_t_`i'_XX
 27. capture drop N`=increase_XX'_t_`i'_XX_w
 28. capture drop N`=increase_XX'_t_`i'_g_XX
 29. capture drop N_gt_control_`i'_XX
 30. capture drop diff_y_`i'_XX
 31. capture drop dummy_U_Gg`i'_XX
 32. capture drop U_Gg`i'_temp_XX
 33. capture drop U_Gg`i'_XX
 34. capture drop count`i'_core_XX
 35. capture drop U_Gg`i'_temp_var_XX
 36. capture drop U_Gg`i'_var_XX
 37. 
. capture drop never_change_d_`i'_wXX
 38. capture drop distance_to_switch_`i'_wXX
 39. 
. capture drop d_fg`i'_XX
 40. capture drop path_`i'_XX
 41. capture drop num_g_paths_`i'_XX
 42. capture drop cohort_fullpath_`i'_XX
 43. 
. capture drop dof_cohort_`i'_s_t_XX
 44. capture drop dof_cohort_`i'_ns_t_XX
 45. capture drop dof_cohort_`i'_s0_t_XX
 46. capture drop dof_cohort_`i'_s1_t_XX
 47. capture drop dof_cohort_`i'_s2_t_XX
 48. capture drop count_cohort_`i'_s_t_XX
 49. capture drop count_cohort_`i'_ns_t_XX
 50. capture drop count_cohort_`i'_s0_t_XX
 51. capture drop count_cohort_`i'_s1_t_XX
 52. capture drop count_cohort_`i'_s2_t_XX
 53. capture drop total_cohort_`i'_s_t_XX
 54. capture drop total_cohort_`i'_ns_t_XX
 55. capture drop total_cohort_`i'_s0_t_XX
 56. capture drop total_cohort_`i'_s1_t_XX
 57. capture drop total_cohort_`i'_s2_t_XX
 58. capture drop mean_cohort_`i'_s_t_XX
 59. capture drop mean_cohort_`i'_ns_t_XX
 60. capture drop mean_cohort_`i'_s0_t_XX
 61. capture drop mean_cohort_`i'_s1_t_XX
 62. capture drop mean_cohort_`i'_s2_t_XX
 63. 
. capture drop E_hat_gt_`i'_XX
 64. capture drop DOF_gt_`i'_XX
 65. 
. ///// Creating long difference of outcome
> 
. xtset group_XX time_XX
 66. bys group_XX : gen diff_y_`i'_XX = outcome_XX - L`i'.outcome_XX
 67. 
. ///// Creating treatment paths if less_conservative_se option specified
> 
. if "`less_conservative_se'" != ""{
 68. 
. // Creating a time-invariant, group-level variable, containing g's treatment at F_g-1+\ell
. gen d_fg_XX_temp=treatment_XX if time_XX==F_g_XX + `=-1+`i''
 69. bys group_XX: gegen d_fg`i'_XX=mean(d_fg_XX_temp)
 70. 
. // This variable might be missing, for groups whose treatment never changes, and
. // for groups not observed \ell periods after treatment change. Then, we impute
. // their treatment at F_g-1+\ell-1. Inconsequential, just to avoid missing values.
. // We also need to initialize a variable d_fg0_XX, when \ell=1.
. if `i'==1{
 71. gen d_fg0_XX=d_sq_XX
 72. gegen path_0_XX=group(d_fg0_XX F_g_XX)
 73. }
 74. replace d_fg`i'_XX=d_fg`=`i'-1'_XX if d_fg`i'_XX==.
 75. gegen path_`i'_XX = group(path_`=`i'-1'_XX d_fg`i'_XX)
 76. drop d_fg_XX_temp 
 77. 
. // For each group, define a variable counting how many groups belong to the same cohort,
. // with cohorts defined as d_fg0_XX F_g_XX, as well as the full path.
. if `i'==1{
 78.         bysort path_0_XX: gegen num_g_paths_0_XX=nunique(group_XX)
 79. }
 80. bysort path_`i'_XX: gegen num_g_paths_`i'_XX=nunique(group_XX)
 81. 
. // For each group, generate a dummy for whether at least two groups in their cohort.
. gen cohort_fullpath_`i'_XX=(num_g_paths_`i'_XX>1)
 82. if `i'==1{
 83. gen cohort_fullpath_0_XX=(num_g_paths_0_XX>1) 
 84. }
 85. }
 86. 
. ///// Identifying the control (g,t)s in the estimation of dynamic effect i 
> bys group_XX: gen never_change_d_`i'_XX=(F_g_XX>time_XX) if diff_y_`i'_XX!=.
 87. 
. if "`only_never_switchers'" != "" {
 88.         replace never_change_d_`i'_XX = 0 if F_g_XX > time_XX & F_g_XX < T_max_XX + 1 & diff_y_`i'_XX != .
 89. }
 90. 
. ///// Creating N^g_t:
> ///// number of control groups for g at t
> gen never_change_d_`i'_wXX = never_change_d_`i'_XX*N_gt_XX
 91. bys time_XX d_sq_XX `trends_nonparam': gegen N_gt_control_`i'_XX=total(never_change_d_`i'_wXX)
 92. 
. ///// Creating binary variable indicating whether g is \ell periods away from switch
> 
. // If the same_switchers option is specified:
. 
. if ("`same_switchers'"!=""){
 93. 
. capture drop relevant_y_missing_XX
 94. capture drop cum_fillin_XX
 95. capture drop fillin_g_XX 
 96. capture drop fillin_g_pl_XX
 97. capture drop dum_fillin_temp_XX 
 98. capture drop still_switcher_`i'_XX  
 99. 
. sort group_XX time_XX
100. 
. // Modif. Diego 31-03-2025: long-difference and other variables to tailor distance_to_switch to the groups for which the all the effects c
> an be computed
. cap drop N_g_control_check_XX
101. gen N_g_control_check_XX = 0
102. 
. forv j = 1/`=`effects'' {
103.         cap drop diff_y_last_XX
104.         cap drop never_change_d_last_XX
105.         cap drop never_change_d_last_wXX
106.         cap drop N_gt_control_last_XX
107.         cap drop N_g_control_last_temp_XX
108.         cap drop N_g_control_last_m_XX
109.         cap drop diff_y_relev_temp_XX
110.         cap drop diff_y_relev_XX
111. 
.         xtset group_XX time_XX
112.         bys group_XX : gen diff_y_last_XX = outcome_XX - L`j'.outcome_XX
113.         bys group_XX: gen never_change_d_last_XX=(F_g_XX>time_XX) if diff_y_last_XX!=.
114.         if "`only_never_switchers'" != "" {
115.                 replace never_change_d_last_XX = 0 if F_g_XX > time_XX & F_g_XX < T_max_XX + 1 & diff_y_last_XX != .
116.         }
117.         gen never_change_d_last_wXX = never_change_d_last_XX*N_gt_XX
118.         bys time_XX d_sq_XX `trends_nonparam': gegen N_gt_control_last_XX=total(never_change_d_last_wXX)
119. 
.         gen N_g_control_last_temp_XX = N_gt_control_last_XX if time_XX == F_g_XX - 1 + `j'
120.         bys group_XX: egen N_g_control_last_m_XX = mean(N_g_control_last_temp_XX)
121. 
.         gen diff_y_relev_temp_XX = diff_y_last_XX if time_XX == F_g_XX - 1 + `j'
122.         bys group_XX: egen diff_y_relev_XX = mean(diff_y_relev_temp_XX)
123. 
.         replace N_g_control_check_XX = N_g_control_check_XX + (N_g_control_last_m_XX > 0 & diff_y_relev_XX != .)
124. }
125. 
. * If the same_switchers_pl option is specified:
. 
. if ("`same_switchers_pl'"!=""){
126. cap drop N_g_control_check_pl_XX
127. gen N_g_control_check_pl_XX = 0
128. forv j = 1/`=`placebo'' {
129.         cap drop diff_y_last_XX
130.         cap drop never_change_d_last_XX
131.         cap drop never_change_d_last_wXX
132.         cap drop N_gt_control_last_XX
133.         cap drop N_g_control_last_temp_XX
134.         cap drop N_g_control_last_m_XX
135.         cap drop diff_y_relev_temp_XX
136.         cap drop diff_y_relev_XX
137. 
.         xtset group_XX time_XX
138.         bys group_XX : gen diff_y_last_XX = outcome_XX - F`j'.outcome_XX
139.         bys group_XX: gen never_change_d_last_XX=(F_g_XX>time_XX) if diff_y_last_XX!=.
140.         if "`only_never_switchers'" != "" {
141.                 replace never_change_d_last_XX = 0 if F_g_XX > time_XX & F_g_XX < T_max_XX + 1 & diff_y_last_XX != .
142.         }
143.         gen never_change_d_last_wXX = never_change_d_last_XX*N_gt_XX
144.         bys time_XX d_sq_XX `trends_nonparam': gegen N_gt_control_last_XX=total(never_change_d_last_wXX)
145. 
.         gen N_g_control_last_temp_XX = N_gt_control_last_XX if time_XX == F_g_XX - 1 - `j'
146.         bys group_XX: egen N_g_control_last_m_XX = mean(N_g_control_last_temp_XX)
147. 
.         gen diff_y_relev_temp_XX = diff_y_last_XX if time_XX == F_g_XX - 1 - `j'
148.         bys group_XX: egen diff_y_relev_XX = mean(diff_y_relev_temp_XX)
149. 
.         replace N_g_control_check_pl_XX = N_g_control_check_pl_XX + (N_g_control_last_m_XX > 0 & diff_y_relev_XX != .)
150. }
151. * Generate a variable tagging the switchers that should be dropped
. * Is the case if at least one of the placebos or effects we try to estimate is missing:
. gen relevant_y_missing_XX=(outcome_XX==.&time_XX>=F_g_XX-1-`=`placebo''&time_XX<=F_g_XX-1+`=`effects'') 
152. * Or if some of the controls are missing:
. if "`controls'" != ""{
153. replace relevant_y_missing_XX=1 if fd_X_all_non_missing_XX==0&time_XX>=F_g_XX-1-`=`placebo''&time_XX<=F_g_XX-1+`=`effects''
154. }
155. 
. // Modif. Diego 19-04-25: make the same adjustments as below in case same_switcher_pl is specified
. //bys group_XX: gen cum_fillin_XX = sum(relevant_y_missing_XX)
. //gen dum_fillin_temp_XX = (cum_fillin_XX==0&time_XX==F_g_XX-1+`=`effects'')
. //bys group_XX: gegen fillin_g_XX = total(dum_fillin_temp_XX)
. 
. //gen dum_fillin_temp_pl_XX = (cum_fillin_XX==0&time_XX==F_g_XX-1-`=`placebo'')
. //bys group_XX: gegen fillin_g_pl_XX = total(dum_fillin_temp_pl_XX)
. gen fillin_g_pl_XX = (N_g_control_check_pl_XX == `placebo')
156. 
. capture drop dum_fillin_temp_XX
157. capture drop dum_fillin_temp_pl_XX
158. 
. * tag switchers who have no missings from F_g_XX-1-`=`placebo'' to F_g_XX-1+`=`effects''
. gen still_switcher_`i'_XX = (F_g_XX-1+`=`effects''<=T_g_XX & N_g_control_check_XX == `effects')         
159. 
. gen distance_to_switch_`i'_XX=(still_switcher_`i'_XX&time_XX==F_g_XX-1+`i'&`i'<=L_g_XX&S_g_XX==increase_XX&N_gt_control_`i'_XX>0&N_gt_cont
> rol_`i'_XX!=.) if diff_y_`i'_XX!=. 
160. }
161. 
. * If the same_switchers_pl option is not specified:
.         
. if ("`same_switchers_pl'"==""){
162. * Generate a variable tagging the switchers that should be dropped
. * Is the case if at least one of the effects we try to estimate is missing:
. gen relevant_y_missing_XX=(outcome_XX==.&time_XX>=F_g_XX-1&time_XX<=F_g_XX-1+`=`effects'') 
163. * Or if some of the controls are missing:
. if "`controls'" != ""{
164. replace relevant_y_missing_XX=1 if fd_X_all_non_missing_XX==0&time_XX>=F_g_XX&time_XX<=F_g_XX-1+`=`effects''
165. }
166. 
. // Modif. Diego 31-03-2025: we do not need this block if we use the changes above
. //bys group_XX: gen cum_fillin_XX = sum(relevant_y_missing_XX)
. //gen dum_fillin_temp_XX = (cum_fillin_XX==0&time_XX==F_g_XX-1+`=`effects'')
. //bys group_XX: gegen fillin_g_XX = total(dum_fillin_temp_XX)
. 
. * tag switchers who have no missings from F_g_XX-1 to F_g_XX-1+`=`effects''
. // Modif. Diego 31-03-2025: add check for control groups with the same baseline treat to still_switchers for all estimated periods
. 
. gen still_switcher_`i'_XX = (F_g_XX-1+`=`effects''<=T_g_XX & N_g_control_check_XX == `effects')         
167. gen distance_to_switch_`i'_XX=(still_switcher_`i'_XX&time_XX==F_g_XX-1+`i'&`i'<=L_g_XX&S_g_XX==increase_XX&N_gt_control_`i'_XX>0&N_gt_c
> ontrol_`i'_XX!=.) if diff_y_`i'_XX!=.  
168. 
. }
169. }
170. 
. // If the same_switchers option is not specified
. 
. else{
171. gen distance_to_switch_`i'_XX=(time_XX==F_g_XX-1+`i'&`i'<=L_g_XX&S_g_XX==increase_XX&N_gt_control_`i'_XX>0&N_gt_control_`i'_XX!=.) if d
> iff_y_`i'_XX!=. 
172. }
173. 
. ///// Creating a variable counting the number of groups \ell periods away from switch at t
> 
. gen distance_to_switch_`i'_wXX = distance_to_switch_`i'_XX*N_gt_XX
174. bys time_XX: gegen N`=increase_XX'_t_`i'_XX=total(distance_to_switch_`i'_wXX)
175. 
. ///// Computing N1_l,N0_l.
> 
. // Initializing the N1_`i'_XX/N0_`i'_XX scalar at 0. 
. scalar N`=increase_XX'_`i'_XX =0
176. 
. // Loop over t incrementing the scalar
. forvalue t=`=t_min_XX'/`=T_max_XX'{
177.         sum N`=increase_XX'_t_`i'_XX if time_XX==`t'
178.         if !missing(r(mean)) scalar N`=increase_XX'_`i'_XX = N`=increase_XX'_`i'_XX + r(mean)
179. }
180. 
. // Modif Felix weight
. if "`weight'"!=""{
181. 
.         bys time_XX: gegen N`=increase_XX'_t_`i'_XX_w=total(distance_to_switch_`i'_XX)
182.         
.         scalar N`=increase_XX'_`i'_XX_weight =0
183. 
. // Loop over t incrementing the scalar
. forvalue t=`=t_min_XX'/`=T_max_XX'{
184.         sum N`=increase_XX'_t_`i'_XX_w if time_XX==`t'
185.         if !missing(r(mean)) scalar N`=increase_XX'_`i'_XX_weight = N`=increase_XX'_`i'_XX_weight + r(mean)
186. }
187. }
188. 
. ///// Creating N^1_{t,\ell,g}/N^0_{t,\ell,g}: 
> ///// Variable counting number of groups \ell periods away from switch at t, 
> ///// and with same D_{g,1} and trends_nonparam.
> 
. bys time_XX d_sq_XX `trends_nonparam': gegen N`=increase_XX'_t_`i'_g_XX=total(distance_to_switch_`i'_wXX)
189. 
. ///// Creating all the adjustment terms to compute estimators with controls, and their variances
>  
. if "`controls'" != ""{
190.         
. // Initialize intermediate Variable needed later        
. capture drop part2_switch`=increase_XX'_`i'_XX
191. gen part2_switch`=increase_XX'_`i'_XX=0
192. 
. // generation of the T_d variable = max_{g:D_g,1 = d} F_g - 1: 
. // last period when treatment effects can still be estimated for groups with baseline treatment equal to d
. 
. capture drop T_d_XX
193. gegen T_d_XX = max(F_g_XX), by(d_sq_int_XX)
194. replace T_d_XX = T_d_XX - 1
195. 
. // Computing the long differences of the control variables (X_g_t - X_g_t-l)
. 
. local count_controls=0
196. 
. foreach var of varlist `controls'{
197.                 
. local count_controls=`count_controls'+1
198. 
. capture drop diff_X`count_controls'_`i'_XX
199. 
. xtset group_XX time_XX
200. gen diff_X`count_controls'_`i'_XX=`var' - L`i'.`var'
201. 
. // Computing N_g_t * (X_g_t - X_g_t-l)
. 
. capture drop diff_X`count_controls'_`i'_N_XX
202. gen diff_X`count_controls'_`i'_N_XX = N_gt_XX * diff_X`count_controls'_`i'_XX 
203. 
. foreach l of local levels_d_sq_XX { // index l corresponds to d in the paper 
204. 
. // intermediate variable to count the number of groups within each not yet switched cohort
. 
. // Changes Diego 27-03-25
. //capture drop dummy_XX
. //gen dummy_XX=(F_g_XX>time_XX & d_sq_int_XX == `l')
. 
. // Computing coordinates of vectors m_+_(g,d,l) and m_-_(g,d,l)
. 
. *Creating variable inside the summation across t in m^+_{g,d,\ell}/m^-_{g,d,\ell}
. capture drop m`=increase_XX'_g_`count_controls'_`l'_`i'_XX 
205. gen m`=increase_XX'_g_`count_controls'_`l'_`i'_XX = (`i' <= T_g_XX-2 & d_sq_int_XX == `l')* (G_XX / N`=increase_XX'_`i'_XX) * ([distanc
> e_to_switch_`i'_XX - (N`=increase_XX'_t_`i'_g_XX/N_gt_control_`i'_XX) * never_change_d_`i'_XX] * (time_XX>=`=`i'+1'&time_XX<=T_g_XX) * dif
> f_X`count_controls'_`i'_N_XX)
206. *Summing that variable across t, and leaving one non missing observation per g  
. capture drop m`=increase_XX'_`l'_`count_controls'_`i'_XX
207. bys group_XX: gegen m`=increase_XX'_`l'_`count_controls'_`i'_XX=total(m`=increase_XX'_g_`count_controls'_`l'_`i'_XX)
208. bys group_XX: replace m`=increase_XX'_`l'_`count_controls'_`i'_XX = . if _n != 1
209. 
. // Computing coordinates of vectors M^+_{d,\ell} and M^-_{d,\ell}
. 
. capture drop M`=increase_XX'_`l'_`count_controls'_`i'_XX
210. egen M`=increase_XX'_`l'_`count_controls'_`i'_XX = total(m`=increase_XX'_`l'_`count_controls'_`i'_XX)
211. replace M`=increase_XX'_`l'_`count_controls'_`i'_XX = (1/G_XX)*M`=increase_XX'_`l'_`count_controls'_`i'_XX
212. 
. // number of groups within each not yet switched cohort
. capture drop E_hat_denom_`count_controls'_`l'_XX
213. //// CHANGE BELOW - tks + Changes Diego 27-03-25: replace dummy_XX_2 with dummy_XX
> 
. // Modif Clément 20/6/2025:
. * Counting number of groups for DOF adjustment
. {
214. cap drop dummy_XX
215. gen dummy_XX = 0
216. replace dummy_XX = (F_g_XX>time_XX & d_sq_int_XX == `l') if diff_y_XX < .
217.         if "`cluster'" == "" {
218.                 bys time_XX : egen E_hat_denom_`count_controls'_`l'_XX = total(dummy_XX) if d_sq_int_XX == `l'
219.         }
220.         else {
221.                 cap drop cluster_temp_XX
222.                 gen cluster_temp_XX= `cluster' if dummy_XX == 1
223.                 bys time_XX : gegen E_hat_denom_`count_controls'_`l'_XX = nunique(cluster_temp_XX) if !missing(cluster_temp_XX)
224.         }
225. }
226. // End Modif Clément 20/6/2025
. 
. // Add the indicator for at least two groups in the cohort to E_y_hat_gt_`l'_XX (demeaning is possible)
. capture drop E_y_hat_gt_`l'_XX
227. gen E_y_hat_gt_`l'_XX=E_y_hat_gt_int_`l'_XX*(E_hat_denom_`count_controls'_`l'_XX>=2)
228. 
. 
. // Computing the summation from t=2 to F_g-1 that appears in the last term 
. // of U^{+,var,X}_{g,\ell} and U^{-,var,X}_{g,\ell}, defined in the companion paper.
.  
. capture drop in_sum_temp_`count_controls'_`l'_XX
229. capture drop N_c_`l'_temp_XX
230. capture drop N_c_`l'_XX
231. //// CHANGE BELOW - tks, Changes Diego 27-03-25: Multiply by N_gt_XX
> gen N_c_`l'_temp_XX = N_gt_XX * (d_sq_int_XX == `l' & time_XX >= 2 & time_XX <= T_d_XX & time_XX < F_g_XX & diff_y_XX < .)
232. ////
> egen N_c_`l'_XX = total(N_c_`l'_temp_XX)
233. /// Changes Diego 16-06-25: Adjust demeaning when E_hat_denom == 1
> cap drop in_sum_temp_adj_`count_controls'_`l'_XX
234. gen in_sum_temp_adj_`count_controls'_`l'_XX = 0 if E_y_hat_gt_`l'_XX != .
235. replace in_sum_temp_adj_`count_controls'_`l'_XX = (sqrt((E_hat_denom_`count_controls'_`l'_XX)/(E_hat_denom_`count_controls'_`l'_XX - 1)
> )-1) if E_y_hat_gt_`l'_XX != . & E_hat_denom_`count_controls'_`l'_XX > 1
236. gen in_sum_temp_`count_controls'_`l'_XX = (prod_X`count_controls'_Ngt_XX*(1+(E_hat_denom_`count_controls'_`l'_XX>=2)*in_sum_temp_adj_`c
> ount_controls'_`l'_XX)*(diff_y_XX-E_y_hat_gt_`l'_XX)*(time_XX>=2 & time_XX<=F_g_XX-1)) / N_c_`l'_XX
237. 
. 
. capture drop in_sum_`count_controls'_`l'_XX
238. capture drop in_sum_temp_adj_`count_controls'_`l'_XX
239. bys group_XX: gegen in_sum_`count_controls'_`l'_XX = total(in_sum_temp_`count_controls'_`l'_XX) 
240. 
. }
241. 
. 
. // Residualize the outcome difference wrt control differences:
. // Yg,t − Yg,t−ℓ − (Xg,t − Xg,t−ℓ)*θ_{Dg,1}
. 
. foreach l of local levels_d_sq_XX { 
242.         if (scalar(useful_res_`l'_XX)>1){
243. replace diff_y_`i'_XX = diff_y_`i'_XX - coefs_sq_`l'_XX[`=`count_controls'',1]*diff_X`count_controls'_`i'_XX if d_sq_int_XX==`l' 
244. * N.B. : in the above line, we do not add "&diff_X`count_controls'_`i'_XX!=." because we want to exclude from the estimation any first/
> long-difference for which the covariates are missing.
. 
. // Initialize intermediate Variable needed later
. capture drop in_brackets_`l'_`count_controls'_XX        
245. gen in_brackets_`l'_`count_controls'_XX=0
246. 
. }
247. }
248. }
249. }
