1205.         }
1206. }
1207. 
. }
1208. 
. //// Extract estimates vector (without avg_effect) for honestdid
> matrix didmgt_results_no_avg1_XX=J(`=l_XX',1,.)
1209. matrix didmgt_results_no_avg1_XX=mat_res_XX[1 .. `=l_XX',1]
1210. matrix didmgt_results_no_avg_XX = didmgt_results_no_avg1_XX
1211. 
. if `=l_placebo_XX'>0{
1212. matrix didmgt_results_no_avg2_XX=J(`=l_placebo_XX',1,.)
1213. matrix didmgt_results_no_avg2_XX=mat_res_XX[`=l_XX'+2 .. `=l_XX'+`=l_placebo_XX'+1,1]
1214. matrix didmgt_results_no_avg_XX = didmgt_results_no_avg1_XX \ didmgt_results_no_avg2_XX
1215. }
1216. 
. matrix didmgt_results_no_avg_XX=didmgt_results_no_avg_XX'
1217. 
