1273.         di as input _continue ""
1274.         
.         local missing_pl_XX `missing_pl_XX' `i'
1275.         
.         scalar N_placebo_`i'_XX=0
1276.         scalar N_switchers_placebo_`i'_XX=0
1277.         }
1278. }
1279. 
. ereturn scalar N_placebo_`i' = N_placebo_`i'_XX
1280. matrix mat_res_XX[`=l_XX' + 1 + `i',5]=N_placebo_`i'_XX
