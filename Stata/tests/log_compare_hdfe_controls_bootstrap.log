. ///// save_sample option that allows to see which groups were included in the estimation and if they were switcher in/out ot control
> 
. if "`save_sample'" != "" {
2279.         qui {
2280.                 // keeping only group, time and switcher status (if not missing)
.                 keep if !missing(`2') & !missing(`3') 
2281.                 keep `2' `3' S_g_XX switcher_tag_XX
2282.                 
.                 if "`by'"==""{
2283.                         
.                 // redefine S_g_XX to show if group is switcher in/out or control       
.                 rename S_g_XX _did_sample
2284.                 rename switcher_tag_XX _effect
2285.                 replace _did_sample = -1 if _did_sample == 0
2286.                 replace _did_sample = 0 if _did_sample == .
2287.                 cap label drop switch_lab_XX 
2288.                 label define switch_lab_XX 0 "Never-switcher" 1 "Switcher-in" -1 "Switcher-out"
2289.                 label values _did_sample switch_lab_XX
2290.                 
.                 // Save dataset to be in the memory at the end
.                 tempfile did_sample
2291.                 save `did_sample', replace
2292.                 }
2293.                 
.                 // Same procedure, but with by we get multiple samples
.                 else if "`by'"!=""{
2294.                         
.                 // redefine S_g_XX to show if group is switcher in/out or control       
.                 rename S_g_XX _did_sample_`l_by'
2295.                 rename switcher_tag_XX _effect_`l_by'
2296.                 replace _did_sample_`l_by' = -1 if _did_sample_`l_by' == 0
2297.                 replace _did_sample_`l_by' = 0 if _did_sample_`l_by' == .
2298.                 cap label drop switch_lab_XX 
2299.                 label define switch_lab_XX 0 "Never-switcher" 1 "Switcher-in" -1 "Switcher-out"
2300.                 label values _did_sample_`l_by' switch_lab_XX
2301.                 
.                 // Save dataset to be in the memory at the end
.                 tempfile did_sample_`l_by'
2302.                 save `did_sample_`l_by'', replace
2303.                 }
2304.         }
2305. }
