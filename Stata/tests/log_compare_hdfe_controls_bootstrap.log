1152. scalar DID_placebo_`i'_XX = DID_placebo_`i'_XX
1153. 
. if "`normalized'"!=""{
1154.         scalar DID_placebo_`i'_XX = scalar(DID_placebo_`i'_XX)/scalar(delta_D_pl_`i'_global_XX)
1155. }
