868. forvalues k=1/`num_paths_XX'{
869.         count if different_paths_XX==`k'&first_obs_by_gp_XX==1 // important to count each group just once in case of unbalanced panel!
870.         replace count_path_XX=r(N) if different_paths_XX==`k' 
