.                 // Count the number of effects that can be estimated
.                 forvalue i=1/`=l_XX'{
  2.                 if ("`switchers'"==""&(N1_`i'_XX_new!=0|N0_`i'_XX_new!=0))|("`switchers'"=="out"&N0_`i'_XX
> _new!=0)|("`switchers'"=="in"&N1_`i'_XX_new!=0){
  3.                         scalar all_Ns_not_zero=all_Ns_not_zero+1
  4.                         
.                 }
  5.                 // Count the number of normalized effects that can be estimated
.                 if "`normalized'"!=""{
  6.                 if (delta_D_`i'_global_XX!=0 & delta_D_`i'_global_XX!=.){
  7.                         scalar all_delta_not_zero=all_delta_not_zero+1
  8.                 }
  9.                 }
 10.                 }
. 
.         // Test can only be run when all requested effects could be computed:
.         // Add condition with normalized
.         if (all_Ns_not_zero==l_XX & "`normalized'"=="")|(all_Ns_not_zero==l_XX & "`normalized'"!="" & all_del
> ta_not_zero==l_XX){
. 
.         // Creating a vector with all placebo estimates
.         matrix didmgt_effects=J(l_XX,1,0)
.         
.         // Creating a matrix where the variances and the covariances of the placebos will be stored.
.         matrix didmgt_Var_effects=J(l_XX,l_XX,0)
.         
.         // Fill those matrices
.         forvalue i=1/`=l_XX'{
  2.                 
.                 matrix didmgt_effects[`i',1]=scalar(DID_`i'_XX)
  3.                 matrix didmgt_Var_effects[`i',`i']= scalar(se_`i'_XX)^2
  4.         
.                 if `i'<`=l_XX'{
  5.                 forvalue j=`=`i'+1'/`=l_XX'{
  6.                         
.                         * Create variables necessary to compute the covariances
.                         capture drop U_Gg_var_`i'_`j'_XX
  7.                         capture drop U_Gg_var_`i'_`j'_2_XX
  8.                                         
.                         if ("`normalized'"==""){
  9.                         gen U_Gg_var_`i'_`j'_XX = U_Gg_var_glob_`i'_XX + U_Gg_var_glob_`j'_XX
 10.                 }
 11.                         
.                         if "`normalized'"!=""{
 12.                         gen U_Gg_var_`i'_`j'_XX = U_Gg_var_glob_`i'_XX/scalar(delta_D_`i'_global_XX) + U_G
> g_var_glob_`j'_XX/scalar(delta_D_`j'_global_XX)
 13.                 }
 14. 
.                         * Estimate the covariances
.                         gen U_Gg_var_`i'_`j'_2_XX = U_Gg_var_`i'_`j'_XX^2*first_obs_by_gp_XX
 15.                         
.                         sum U_Gg_var_`i'_`j'_2_XX
 16.                         scalar var_sum_`i'_`j'_XX=r(sum)/G_XX^2
 17.                         
.                         scalar cov_`i'_`j'_XX = (scalar(var_sum_`i'_`j'_XX) - scalar(se_`i'_XX)^2 - scalar(se
> _`j'_XX)^2)/2
 18.         
.                         * Store the results
.                         matrix didmgt_Var_effects[`i',`j']= scalar(cov_`i'_`j'_XX)
 19.                         matrix didmgt_Var_effects[`j',`i']= scalar(cov_`i'_`j'_XX)
 20. 
.                 }
 21.         }
 22.         
.         }

