2298.         ereturn matrix effect_het_`i'_XX=effect_het_`i'_XX
2299.         }       
2300.         foreach i in `all_effects_XX_pl'{
2301.         ereturn matrix effect_het_pl_`i'_XX=effect_het_pl_`i'_XX
2302.         }       
2303. }
2304. }
2305. 
. ///// Option that shows a table with weights attached to each normalized effect
> if "`normalized_weights'" != "" {
2306.         qui {
2307.                 // Error as normalized_weights only works in combination with normalized
.                 if "`normalized'" == "" {
2308.                         noi di as err "normalized option required to compute normalized_weights"
2309.                         di as input _continue ""
2310.                         exit
2311.                 }
2312. 
.         // Set up the matrix for the output table
.         mat define weight_mat = J(`=l_XX + 1', `=l_XX', .)
2313.         local cols ""
2314. 
.         forv i = 1/`=l_XX'{     
2315.                 local m = "ℓ=`i'"
2316.                 local cols `cols' `m'
2317.                 gen N_gt_`i'_temp_XX = N_gt_XX if time_XX == F_g_XX - 1 + `i' & `i' <= L_g_XX & N_gt_control_`i'_XX > 0 & N_gt_control
> _`i'_XX != . & diff_y_`i'_XX != .
2318.                 gegen N_gt_`i'_XX = mean(N_gt_`i'_temp_XX), by(group_XX)
2319.                 drop N_gt_`i'_temp_XX
2320.                 forv k = 0/`=`i' - 1' {
2321.                         // Visualization by k
.                         local row = `k' + 1
2322.                         
.                         // Compute the delta_ℓ_k, if the continuous option is specified the original treatment values are used
.                         if `continuous'==0{
2323.                         gen delta_`i'_`k' = abs(treatment_XX - d_sq_XX) if time_XX == F_g_XX - 1 + `i' - `k' & F_g_XX - 1 + `i' <= T_g
> _XX
2324.                         }
2325.                         else if `continuous'>0{
2326.                         gen delta_`i'_`k' = abs(treatment_XX_orig - d_sq_XX_orig) if time_XX == F_g_XX - 1 + `i' - `k' & F_g_XX - 1 + 
> `i' <= T_g_XX
2327.                         }
2328.                         replace delta_`i'_`k' = delta_`i'_`k' * N_gt_`i'_XX
2329.                         // Filling the weight matrix 
.                         sum delta_`i'_`k'
2330.                         mat weight_mat[`row', `i'] = (`r(sum)' / scalar(delta_D_`i'_global_XX)) / scalar(N_switchers_effect_`i'_XX)
2331.                         //mat weight_mat[`row', `i'] = (`r(sum)' / `denom_`i'_norm_XX')
.                 }               
2332.                 drop N_gt_`i'_XX
2333.         }
2334.         
.         // Generating the row names 
.         // Visualization by k 
.         local rows ""
2335.         forv j = 1/`=l_XX' {
2336.                         local r = "k=`=`j'-1'"
2337.                         local rows `rows' `r'
2338.         }       
2339. 
.         local rows `rows' "Total"
2340.         
.         // Fill the values for the displayed table
.         matrix define mat_temp = J(`=l_XX', `=l_XX', 0) 
2341.         forv i = 1/`=l_XX' {
2342.                 forv j = 1/`=l_XX' {
2343.                         if weight_mat[`i', `j'] != . {
2344.                                 mat mat_temp[`i', `j'] = weight_mat[`i', `j']
2345.                         }
2346.                 }
2347.         }       
2348.         
.         // Getting the correct order
.         matrix define mat_total = mat_temp' * J(`=l_XX', 1, 1)
2349.         forv i = 1/`=l_XX' {
2350.                 mat weight_mat[`=l_XX+1', `i'] = mat_total[`i', 1]
2351.         }
2352.         
.         // Add row and column names
.         mat rown weight_mat = `rows'
2353.         mat coln weight_mat = `cols'    
2354.         }
2355. 
.         // Output the table
.         display _newline
2356.         di "{hline 70}"
2357.         di _skip(15) "{bf:Weights on treatment lags}"
2358.         if "`by'" !=""{ 
2359.         * Add description with the by variable level if by is specified 
.         di _skip(25) "{bf:By: `by' = `val_lab_int_XX'}"
2360.         }       
2361.         di "{hline 70}"
2362.         matlist weight_mat, format(%9.4fc) lines(rowtotal)
2363.         display _newline                
2364. }
2365. 
. // Saving data for further options as save sample drops variables 
. qui tempfile data_predesign
2366. qui save `data_predesign', replace
2367. 
. 
. ///// save_sample option that allows to see which groups were included in the estimation and if they were switcher in/out ot control
> 
. if "`save_sample'" != "" {
2368.         qui {
2369.                 // keeping only group, time and switcher status (if not missing)
.                 keep if !missing(`2') & !missing(`3') 
2370.                 keep `2' `3' S_g_XX switcher_tag_XX
2371.                 
.                 if "`by'"==""{
2372.                         
.                 // redefine S_g_XX to show if group is switcher in/out or control       
.                 rename S_g_XX _did_sample
2373.                 rename switcher_tag_XX _effect
2374.                 replace _did_sample = -1 if _did_sample == 0
2375.                 replace _did_sample = 0 if _did_sample == .
2376.                 cap label drop switch_lab_XX 
2377.                 label define switch_lab_XX 0 "Never-switcher" 1 "Switcher-in" -1 "Switcher-out"
2378.                 label values _did_sample switch_lab_XX
2379.                 
.                 // Save dataset to be in the memory at the end
.                 tempfile did_sample
2380.                 save `did_sample', replace
2381.                 }
2382.                 
.                 // Same procedure, but with by we get multiple samples
.                 else if "`by'"!=""{
2383.                         
.                 // redefine S_g_XX to show if group is switcher in/out or control       
.                 rename S_g_XX _did_sample_`l_by'
2384.                 rename switcher_tag_XX _effect_`l_by'
2385.                 replace _did_sample_`l_by' = -1 if _did_sample_`l_by' == 0
2386.                 replace _did_sample_`l_by' = 0 if _did_sample_`l_by' == .
2387.                 cap label drop switch_lab_XX 
2388.                 label define switch_lab_XX 0 "Never-switcher" 1 "Switcher-in" -1 "Switcher-out"
2389.                 label values _did_sample_`l_by' switch_lab_XX
2390.                 
.                 // Save dataset to be in the memory at the end
.                 tempfile did_sample_`l_by'
2391.                 save `did_sample_`l_by'', replace
2392.                 }
2393.         }
2394. }
2395. 
. ///// design option which shows the different treatment paths that switcher groups follow
> 
. if "`design'" != "" {   
2396.         qui {
2397.         
.         // Releaod the data before it was changed in save_sample
.         use `data_predesign', clear
2398.         
.         // Error message if the arguments in the option were specified wrong
.         if strpos("`design'", ",") == 0 {
2399.                 di as error ""
2400.                 di as error "Syntax error in design option"
2401.                 di as error "Comma required"
2402.                 di as input _continue ""
2403.                 
.                 exit
2404.         }
2405.         
.         // Fetch the arguments 
.         local des_p = strtrim(substr("`design'", 1, strpos("`design'", ",") - 1))
2406.         local des_path = strtrim(substr("`design'", strpos("`design'", ",") + 1, .))
2407.         local des_n = l_XX 
2408.         
.         // When no percentage value is specified (for how many paths should be shown) it is set to a default of 100%
.         if missing("`des_p'") {
2409.                 local des_p = 1
2410.         }
2411.         local des_per = `des_p' * 100
2412.         local des_per : di %9.2fc `des_per'
2413.         
.         // keep periods up to ℓ periods after the first switch
.         gen F_g_plus_n_XX = F_g_XX + `des_n' - 1
2414.         keep if time_XX >= F_g_XX - 1 & time_XX <= F_g_plus_n_XX
2415.         sort group_XX time_XX
2416.         bys group_XX : gen time_l_XX = _n
2417. 
.         // Aggregate weights by group 
.         keep group_XX time_l_XX weight_XX treatment_XX F_g_XX
2418.         {
2419.                 if "`weight'" != "" {
2420.                         gegen g_weight_XX = sum(weight_XX), by(group_XX)
2421.                 }
2422.                 else {
2423.                         gen g_weight_XX = 1
2424.                 }
2425.         }
2426.         drop weight_XX
2427.         // Reshape wide to represent the treatment path by time
.         greshape wide treatment_XX, i(group_XX g_weight_XX F_g_XX) j(time_l_XX)
2428.         
.         // Drop missing treatments 
.         foreach v of varlist treatment_XX* {
2429.                 drop if `v' == .
2430.         }
2431.         
.         // Remove non switchers 
.         count if F_g_XX > T_max_XX
2432.         local non_switchers = r(N)
2433.         drop if F_g_XX > T_max_XX
2434.         
.         // Creating varibale to store number of groups per treatment path and collapsing
.         gen N_XX = 1
2435.         sum g_weight_XX
2436.         gen N_w_XX =  (g_weight_XX * N_XX) / r(sum)
2437.         drop group_XX g_weight_XX
2438.         gcollapse (sum) N_XX N_w_XX, by(treatment_XX*)
2439.         order N* treat* 
2440.         sum N_XX
2441.         local tot_switch = r(sum)
2442.         
.         // Keep the observations amounting to p% of the detected treatment paths 
.         gen neg_N_XX = -N_XX
2443.         sort neg_N_XX treatment_XX*
2444.         gen cum_sum_XX = sum(N_w_XX)
2445.         gen in_table_XX = (cum_sum_XX <= `des_p')
2446.         sort in_table_XX cum_sum_XX
2447.         bys in_table_XX: gen id_XX = _n
2448.         
.         // Keep all observations up to the first exceeding the p%       
.         keep if (in_table_XX == 1) | (in_table_XX == 0 & id_XX == 1)    
2449.         // Store the final % of groups included by the design option
.         {
2450.                 if `des_p' < 1 {
2451.                         sum cum_sum_XX if in_table == 0
2452.                         local last_p : di %9.2fc 100 * r(min)
2453.                 }
2454.                 else {
2455.                         local last_p : di %9.2fc 100
2456.                 }
2457.         }
2458.         
.         sort neg_N_XX treatment_XX*
2459.         drop neg_N_XX in_table_XX id_XX cum_sum_XX
2460.         
.         // Prepare matrix for the output table
.         mat define desmat = J(`=_N', `= 2 + 1 + `des_n'', .)
2461.         local colnames
2462.         label var N_XX "#Groups"
2463.         label var N_w_XX "%Groups"
2464.         replace N_w_XX=100*N_w_XX
2465.         * display in % terms
.         
.         // Generate the column/row names and fill treatment path
.         local j = 1
2466.         foreach v of varlist _all {
2467.                 local m : var label `v'
2468.                 if strpos("`v'", "treatment_XX") > 0 {
2469.                         local k = substr("`v'", length("treatment_XX") + 1, .)
2470.                         local m = "ℓ=`=`k'-1'"
2471.                 }
2472.                 local colnames `colnames' `m'   
2473.                 
.                 // Fill treatement path
.                 forv i = 1/`=_N' {
2474.                         matrix desmat[`i', `j'] = `v'[`i']
2475.                 }
2476.                 local j = `j' + 1
2477.                 
.         }
2478.         local rownames
2479.         forv i = 1/`=_N' {
2480.                 local rownames `rownames' "TreatPath`i'"
2481.         }
2482.         foreach v in col row {
2483.                 mat `v'n desmat = ``v'names'
2484.         }
2485.         }
2486. 
.         // output in console
.         if "`des_path'" == "console" {          
2487.                 display _newline
2488.                 di "{hline 80}"
2489.                 di _skip(10) "{bf:Detection of treatment paths - `des_n' periods after first switch}"
2490.                 if "`by'" !=""{ 
2491.                         * Add description with the by variable level if by is specified 
.                         di _skip(35) "{bf:By: `by' = `val_lab_int_XX'}"
2492.                 }       
2493.                 di "{hline 80}"
2494.                 matlist desmat, format(%9.4gc)
2495.                 di "{hline 80}"
2496.                 di "{it: Treatment paths detected in at least `=strtrim("`des_per'")'% of the switching groups `tot_switch' for which 
> `effects' effects could be estimated.}"
2497.                 di "{it: Total % = `=strtrim("`last_p'")' %}"
2498.                 
.                 // Get values for the reference line that explains how to read the table 
.                 qui {
2499.                         local n_groups = N_XX[1]
2500.                         local d_start = treatment_XX1[1]
2501.                         if `des_n' == 1 {
2502.                                 local d_vec : di %9.2gc treatment_XX2[1]
2503.                                 local d_vec = strtrim("`d_vec'")
2504.                         }
2505.                         else {
2506.                                 local d_vec = "vector ("
2507.                                 forv j = 1/`des_n' {
2508.                                         local k : di %9.2gc treatment_XX`=`j' + 1'[1]
2509.                                         local k = strtrim("`k'")
2510.                                         local d_vec = "`d_vec'`k', "
2511.                                 }
2512.                                 local d_vec = substr("`d_vec'", 1, length("`d_vec'")-2) + ")"
2513.                         }
2514.                 }
2515.                 di as text "{it: Design interpretation (first row):}"
2516.                 di as text "{it: `n_groups' groups started with treatment `d_start' and then experienced treatment `d_vec'.}"         
>   
2517.         }
2518.         
.         // output as excel
.         else if "`des_path'" != "console" & "`des_path'" !=  "" {
2519.                 if "`by'"==""{
2520.                 qui {
2521.                         putexcel set "`des_path'", replace sheet("Design", replace)
2522.                         putexcel A1 = matrix(desmat, names)
2523.                 }
2524.                  di "{bf:Design exported to `des_path'}"
2525.                 }
2526.                 else if "`by'"!=""{
2527.                         qui {
2528.                         * Create new sheet for each by level when by is specified       
.                         putexcel set "`des_path'", modify sheet("Design `by' = `val_lab_int_XX'", replace)
2529.                         putexcel A1 = matrix(desmat, names)
2530.                         }
2531.                  di "{bf:Design exported to `des_path'}"
2532.         }  
2533.         }
2534. }
2535. 
. 
. ///// Date first switch option: produces a table showing the number of groups switching for the first time by period
> 
. if "`date_first_switch'" != "" {
2536.         qui {
2537. 
.         // Reload the data before it was changed in save_sample
.         use `data_predesign', clear
2538.         
.         // Fetch the arguments 
.         local dfs_opt = strtrim(substr("`date_first_switch'", 1, strpos("`date_first_switch'", ",") - 1))
2539.         local dfs_path = strtrim(substr("`date_first_switch'", strpos("`date_first_switch'", ",") + 1, .))
2540.         
.         // Error message if the arguments in the option were specified wrong
.         if "`dfs_opt'" != "" & "`dfs_opt'" != "by_baseline_treat" {
2541.                 di as error ""
2542.                 di as error "Only option {bf:by_baseline_treat} allowed"
2543.                 di as input _continue ""
2544.                 exit
2545.         }
2546.         
.         // Drop non switchers
.         drop if F_g_XX == T_max_XX+1 | F_g_XX == .
2547.         keep if time_XX == F_g_XX 
2548.         *Keep just 1 observation per group
.         keep `2' `3' F_g_XX d_sq_XX
2549.         }
2550.         
.         // When by_baseline_treat is not specified
.         if missing("`dfs_opt'") {
2551.                 qui {
2552.                 // collapse the number of groups by time
.                 gcollapse (count) `2', by(`3')
2553.                 tostring `3', replace
2554.                 // generate the share of each group
.                 sum `2'
2555.                 local tot_s = r(sum)
2556.                 gen share_XX = `2'/`tot_s' * 100
2557.                 
.                 // make matrix with the number and share of groups by time
.                 mkmat `2' share_XX, matrix(dfs) rownames(`3')
2558.                 mat colnames dfs = #Groups %Groups
2559.                 }
2560. 
.                 // output in console
.                 if "`dfs_path'" == "console" {          
2561.                         display _newline
2562.                         di "{hline 48}"
2563.                         di  _skip(10) "{bf:Switching dates}"
2564.                         if "`by'" !=""{ 
2565.                                 * Add description with the by variable level if by is specified
.                                 di _skip(10) "{bf:By: `by' = `val_lab_int_XX'}"
2566.                         }       
2567.                         di "{hline 48}"
2568.                         matlist dfs, format(%9.4gc) rowtitle("Any status quo treat.") twidth(25) // New text
2569.                         di "{hline 48}"         
2570. 
.                         ereturn scalar switch_dates = `=_N'
2571.                 }
2572.                 // output as excel
.                 else if "`dfs_path'" != "console" & "`dfs_path'" !=  "" {
2573.                         if "`by'"==""{
2574.                                 qui putexcel set "`dfs_path'", replace sheet("Switching dates", replace)
2575.                                 qui putexcel A1 = matrix(dfs, names)
2576.                                 di "{bf:Switching dates exported to `dfs_path'}"
2577.                         }
2578.                         else if "`by'"!=""{
2579.                                 * Create new sheet for each by level when by is specified       
.                                 qui putexcel set "`dfs_path'", modify sheet("Switching dates `by' = `val_lab_int_XX'", replace)
2580.                                 qui putexcel A1 = matrix(dfs, names)
2581.                                 di "{bf:Switching dates exported to `dfs_path'}"
2582.                         }
2583.                 }               
2584.         }
2585.         
.         // When by_baseline_treat is specified
.         else {
2586.                 // collapse, but this time by time and status quo treatment
.                 qui {
2587.                 gcollapse (count) `2', by(`3' d_sq_XX)
2588.                 tostring `3', replace
2589.                 gegen tot_share_XX = sum(`2'), by(d_sq_XX)
2590.                 gen share_XX = `2'/tot_share_XX * 100
2591.                 sort d_sq_XX `3'
2592.                 }
2593.                 
.                 display _newline
2594.                 if "`dfs_path'" == "console" {
2595.                         di "{hline 48}"
2596.                         di _skip(10) "{bf:Switching dates}"
2597.                         di "{hline 48}"
2598.                 }
2599.                 
.                 // make matrix with the number and share of groups by time, one for each level of status quo treatment
.                 qui {
2600.                         tostring d_sq_XX, replace
2601.                         levelsof d_sq_XX, local(levels_d_sq_XX)
2602.                         local i = 1
2603.                 }
2604.                 foreach m of local levels_d_sq_XX {
2605.                         qui {
2606.                                 mkmat `2' share_XX if d_sq_XX == "`m'", matrix(dfs`i') rownames(`3')
2607.                                 mat colnames dfs`i' = #Groups %Groups
2608.                                 sum `2'
2609.                                 local tot_s = r(sum)
2610.                         }                       
2611.                         // output in console
.                         if "`dfs_path'" == "console" {          
2612.                                 matlist dfs`i', format(%9.4gc) rowtitle("Status quo treat. = `m'") twidth(25) // New
2613.                                 di "{hline 48}"
2614.                                 qui {
2615.                                         sum `2' if d_sq_XX == "`m'"
2616.                                         local tot_s = r(sum)
2617.                                         count if d_sq_XX == "`m'"
2618.                                         ereturn scalar switch_dates_Dsq_`l_by' = `r(N)' // New
2619.                                 }
2620.                         }
2621.                         // output as excel
.                         else if "`dfs_path'" != "console" & "`dfs_path'" !=  "" {
2622.                                 qui {
2623.                                 if `i' == 1 {
2624.                                         local rep_opt "replace"
2625.                                 }
2626.                                 else {
2627.                                         local rep_opt "modify"
2628.                                 }
2629.                                 
.                                 if "`by'"==""{
2630.                                         putexcel set "`dfs_path'", `rep_opt' sheet("Switch. Dates Base treat `m'", replace)
2631.                                         putexcel A1 = matrix(dfs`i', names)
2632.                                         noi di _newline
2633.                                 }
2634.                                 else if "`by'"!=""{
2635.                                         * Create new sheet for each by level when by is specified
.                                         putexcel set "`dfs_path'", modify sheet("Dates Base treat=`m' & `by' = `val_lab_int_XX'", replace)
>  //`by' = `val_lab_int_XX'
2636.                                         putexcel A1 = matrix(dfs`i', names)
2637.                                         noi di _newline
2638.                                 }       
2639.                         }
2640.                 }
2641.                 local i = `i' + 1                       
2642.                 }
2643.                 // consol message if output is written to excel
.                 if "`dfs_path'" != "console" & "`dfs_path'" != "" {
2644.                         di "Switching dates exported to `dfs_path'"
2645.                 }
2646.         }
2647. }
2648. 
. // Reload the data before it was changed in save_sample
. qui use `data_predesign', clear // Modif Felix: Add qui
2649. 
. // If by specified, reload the original data before restricting the sample with by
. if "`by'" !=""{ 
2650. use "`by_data_XX'.dta", clear
2651. local rownames ""
2652. 
. // Save the matrices to generate multiple graphs
. matrix mat_res_XX_by_`l_by'=mat_res_XX
2653. }
2654. 
. } // End of the byvar loop
2655. 
. ////////// 9. Event study graph
> 
. ///// Producing a graph
> qui {
2656. 
. // Initialize color pattern for multiple graphs wihen by is specified 
. local col1 "midblue"
2657. local col2 "midblue" 
2658. local col3 "red"  
2659. local col4 "red" 
2660. local col5 "green" 
2661. local col6 "green"    
2662. local col7 "magenta" 
2663. local col8 "magenta"   
2664. local col9 "gold"   
2665. local col10 "gold"    
2666. local col11 "lime" 
2667. local col12 "lime"      
2668. 
. local graph_input ""
2669. local graph_options ""
2670. local graph_options_int ""
2671. 
. if "`by'" ==""|scalar(by_XX)==0{
2672. *Version with only one event study graph        
. // Translate results matrix into data                   
. capture drop mat_res_XX1 mat_res_XX2 mat_res_XX3 mat_res_XX4 mat_res_XX5 mat_res_XX6 mat_res_XX7
2673. svmat mat_res_XX
2674. 
. // artificially replacing the result of average effect by 0
. forvalue index=1/6{
2675. replace mat_res_XX`index'=0 if mat_res_XX7==0 
2676. }
2677. 
. capture drop point_estimate
2678. capture drop se_point_estimate
2679. capture drop lb_CI_95
2680. capture drop up_CI_95
2681. capture drop N
2682. capture drop N_switchers
2683. capture drop time_to_treat
2684. 
. rename mat_res_XX1 point_estimate
2685. rename mat_res_XX2 se_point_estimate
2686. rename mat_res_XX3 lb_CI_95
2687. rename mat_res_XX4 up_CI_95
2688. rename mat_res_XX5 N
2689. rename mat_res_XX6 N_switchers
2690. rename mat_res_XX7 time_to_treat
2691. 
. 
. sort time_to_treat
2692. 
. // Define fixed graph options as they are implemented as flexible locals
. local graph_input "(connected point_estimate time_to_treat, lpattern(solid)) (rcap up_CI_95 lb_CI_95 time_to_treat)"
2693. local graph_options "legend(off)"
2694. 
. }
2695. 
. if "`by'" !=""{
2696.                 
. // Save tempfile because we will do sorting afterwards 
. tempfile before_graph_XX
2697. save "`before_graph_XX'.dta", replace           
2698. 
. // Create datasets from the results matrix for each level of the by variable            
. local cnt_XX=1
2699. local merge_count=1
2700. foreach l of local levels_byvar_XX {
2701. use "`before_graph_XX'.dta", clear              
2702.         
. capture drop mat_res_XX_by_`l'1 mat_res_XX_by_`l'2 mat_res_XX_by_`l'3 mat_res_XX_by_`l'4 mat_res_XX_by_`l'5 mat_res_XX_by_`l'6 mat_res_XX_
> by_`l'7
2703. svmat mat_res_XX_by_`l'
2704. 
. // artificially replacing the result of average effect by 0
. forvalue index=1/6{
2705. replace mat_res_XX_by_`l'`index'=0 if mat_res_XX_by_`l'7==0
2706. }
2707. 
. capture drop point_estimate_`l'
2708. capture drop se_point_estimate_`l'
2709. capture drop lb_CI_95_`l'
2710. capture drop up_CI_95_`l'
2711. capture drop N_`l'
2712. capture drop N_switchers_`l'
2713. capture drop time_to_treat
2714. 
. rename mat_res_XX_by_`l'1 point_estimate_`l'
2715. rename mat_res_XX_by_`l'2 se_point_estimate_`l'
2716. rename mat_res_XX_by_`l'3 lb_CI_95_`l'
2717. rename mat_res_XX_by_`l'4 up_CI_95_`l'
2718. rename mat_res_XX_by_`l'5 N_`l'
2719. rename mat_res_XX_by_`l'6 N_switchers_`l'
2720. rename mat_res_XX_by_`l'7 time_to_treat
2721. 
. 
. // pick CI color matching the line color
. local col_CI=`cnt_XX'+1
2722. 
. // Create a local that adjusts the graph automatically for ll the by levels
. local graph_input "`graph_input' (connected point_estimate_`l' time_to_treat, lpattern(solid) lcolor(`col`cnt_XX'') mcolor(`col`cnt_XX''))
>  (rcap up_CI_95_`l' lb_CI_95_`l' time_to_treat, lcolor(`col`col_CI''))" 
2723. 
. // Store value labels for the legend if they exist, show the level otherwise
. ds `by', has(vallabel)
2724. local `by'_has_vallabel_XX=r(varlist)
2725. if "``by'_has_vallabel_XX'"!="."{
2726.         local val_lab_int_XX "`: label ``by'_lab_XX' `l''"
2727. } 
2728. if "``by'_has_vallabel_XX'"=="."{
2729.         local val_lab_int_XX "`l'"
2730. }
2731. 
. // Automatcially adjust the legend for each additional graph from the by option
. local graph_options_int "`graph_options_int' `cnt_XX' "`by' = `val_lab_int_XX'""
2732. 
. // +2 to skip the CI's to get the correct color for the next event study graph
. local cnt_XX=`cnt_XX'+2
2733. 
. // Save the specific dataset needed for the graphs
. keep point_estimate_`l' se_point_estimate_`l' lb_CI_95_`l' up_CI_95_`l' N_`l' N_switchers_`l' time_to_treat
2734. tempfile graph_`l'_XX
2735. keep if time_to_treat!=. 
2736. *to allow time_to_treat as id of the dataset and use merge 1:1
. save "`graph_`l'_XX'.dta", replace      
2737. 
. // Merge the different datasts if there is more then one event study graph to be shown
. if `merge_count'==1{
2738.         use "`graph_`l'_XX'.dta", clear
2739.         sort time_to_treat
2740.         tempfile graph_merge_XX
2741.         save "`graph_merge_XX'.dta", replace
2742. }
2743. if `merge_count'>1{
2744.         use "`graph_merge_XX'.dta", clear
2745.         merge 1:1 time_to_treat using "`graph_`l'_XX'.dta"
2746.         capture drop _merge
2747.         tempfile graph_merge_XX
2748.         save "`graph_merge_XX'.dta", replace
2749. }       
2750. local merge_count=`merge_count'+1
2751. } // end of the differentlevels_byvar_XX loop
2752. 
. // Add universal graph options
. local graph_options "legend(pos(6) order(`graph_options_int') rows(1))"
2753. }       
2754. 
. }
2755. 
. // Event Study graph without any additional graph options
. if ("`graph_off'"==""){
2756. if "`graphoptions'"==""{
2757. twoway `graph_input', xlabel(`=-l_placebo_XX'[1]`=l_XX') xtitle("Relative time to last period before treatment changes (t=0)", size(la
> rge)) title("DID, from last period before treatment changes (t=0) to t", size(large)) graphregion(color(white)) plotregion(color(white)) `
> graph_options'
2758. }
2759. // Event Study graph with additional graph options
. else{
2760. global options="`graphoptions'"
2761. twoway `graph_input', $options
2762. }
2763. } // end graph_off
2764. 
. 
. ///// Saving the results if requested
> if "`save_results'"!=""{
2765. quietly{
2766. keep if time_to_treat!=.
2767. }
2768. 
. // keep main results
. if "`by'"==""{
2769. keep time_to_treat point_estimate se_point_estimate lb_CI_95 up_CI_95 N N_switchers
2770. }
2771. else if "`by'"!=""{
2772. keep time_to_treat point_estimate* se_point_estimate* lb_CI_95* up_CI_95* N* N_switchers*
2773. }
2774. 
. // Store information about the dataset
. label data "Stores did_multiplegt_dyn estimates' information: Type 'notes' for details." 
2775. local command_options_XX effects(`effects') placebo(`placebo') switchers(`switchers') `only_never_switchers' controls(`controls') tren
> ds_nonparam(`trends_nonparam') weight(`weight') `dont_drop_larger_lower' `normalized' cluster(`cluster') `same_switchers' `trends_lin' by(
> `by') predict_het(`predict_het') ci_level(`ci_level') design(`design') date_first_switch(`date_first_switch') continuous(`continuous') `le
> ss_conservative_se' `normalized_weights'
2776. notes : "{bf:{ul:Date of Run:}} `c(current_date)' at `c(current_time)'"
2777. notes : "{bf:{ul:Command Syntax:}} did_multiplegt `1' `2' `3' `4' `if' `in', `command_options_XX' "
2778. notes : "{bf:{ul:Path of the Used Dataset:}} `dataset_name_XX' "
2779. save "`save_results'", replace
2780. 
. }
2781. 
. display _newline
2782. di as text "The development of this package was funded by the European Union (ERC, REALLYCREDIBLE,GA N°101043899)."
2783. 
. // Restoring data
. restore
2784. 
. ///// When both save_sample and by were specified merge the different datasets for each level of the by variable into one dataset that wil
> l be in memory after the command ran
> if "`save_sample'" != "" { 
2785.         if "`by'"==""{
2786.         qui merge m:1 `2' `3' using `did_sample', gen(_merge_XX)
2787.         qui drop if _merge_XX == 2
2788.         qui drop _merge_XX
2789.         }
2790.         else if "`by'"!=""{
2791.         foreach l of local levels_byvar_XX {    
2792.         qui merge m:1 `2' `3' using `did_sample_`l'', gen(_merge_XX)
2793.         qui drop if _merge_XX == 2
2794.         qui drop _merge_XX      
2795.         }
2796.         }
2797. }
2798. end

