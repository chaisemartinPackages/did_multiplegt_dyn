751. scalar max_pl_gap_XX = max(`max_pl_gap_u_XX', `max_pl_gap_a_XX')
752. drop pl_gap_XX
753. 
. ///// Start the by_path option here -> after defining l_XX etc. but before calling the core program
> if "`by_path'"!=""{
754. 
. // Disentangle all the treatment paths and match switchers with those paths with not yet switchers with the same baseline that can be used
>  as controls
. forvalues k=0/`=l_XX'{
755.         gen dummy_treat_`k'_temp=treatment_XX if time_XX==F_g_XX-1+`k'
756.         gegen dummy_treat_`k'=max(dummy_treat_`k'_temp), by(group_XX)
757.         capture drop dummy_treat_`k'_temp
758. }
759. // Variable grouping all groups that follow exactly the same treatment path from F_g-1 to F_g-1+\ell
. gegen different_paths_temp_XX=group(dummy_treat_*) if time_XX<=F_g_XX-1+`=l_XX'
760. gegen different_paths_XX=max(different_paths_temp_XX), by(group_XX)
