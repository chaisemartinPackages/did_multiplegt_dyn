1286.         capture drop N_placebo_`i'_XX_w
1287.         
.         gen count`i'_pl_global_XX_w=count`i'_pl_global_XX/weight_XX
1288.         gegen N_placebo_`i'_XX_w = total(count`i'_pl_global_XX_w) 
1289.         scalar N_placebo_`i'_XX_w = N_placebo_`i'_XX_w
1290.         ereturn scalar N_placebo_`i'_w = N_placebo_`i'_XX_w
1291.         matrix mat_res_XX[`=l_XX' + 1 + `i',5]=N_placebo_`i'_XX_w
1292. }
1293. 
. }
1294. 
. // Generate string local for sotable
. local str_placebo "Placebo_1"
1295. if l_placebo_XX > 1 {
