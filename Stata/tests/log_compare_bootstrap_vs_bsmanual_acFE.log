  6. capture drop interact_var_XX
  7. capture drop group_interact_var_XX
  8. capture drop d_sq_group_XX      
  9. 
. // Defining the parts needed for the long difference 
. * Yg,Fg−1
. gen Yg_Fg_min1_XX_temp=outcome_non_diff_XX if time_XX==F_g_XX-1
 10. bys group_XX: gegen Yg_Fg_min_1_XX=mean(Yg_Fg_min1_XX_temp)
 11. capture drop Yg_Fg_min1_XX_temp
 12. 
. * Yg,Fg−2 
. if "`trends_lin'" != ""{
 13. gen Yg_Fg_min2_XX_temp=outcome_non_diff_XX if time_XX==F_g_XX-2
 14. bys group_XX: gegen Yg_Fg_min_2_XX=mean(Yg_Fg_min2_XX_temp)
 15. capture drop Yg_Fg_min2_XX_temp
 16. }
 17. 
. * Yg,Fg−1+ℓ
. gen Yg_Fg_`i'_XX_temp=outcome_non_diff_XX if time_XX==F_g_XX-1+`i'
 18. bys group_XX: gegen Yg_Fg_`i'_XX=mean(Yg_Fg_`i'_XX_temp)
 19. capture drop Yg_Fg_`i'_XX_temp
 20. 
. // Now generate Sg*(Yg,Fg−1+ℓ − Yg,Fg−1) 
. gen prod_het_`i'_XX=(Yg_Fg_`i'_XX - Yg_Fg_min_1_XX)
 21. if "`trends_lin'" != ""{
 22.         replace prod_het_`i'_XX=prod_het_`i'_XX-`i'*(Yg_Fg_min_1_XX-Yg_Fg_min_2_XX)
 23. }
 24. replace prod_het_`i'_XX=S_g_het_XX*prod_het_`i'_XX
 25. 
. * keep one observation by group to not artificially increase sample
. bys group_XX: replace prod_het_`i'_XX = . if switcher_tag_XX != `i' // Change by DAC to fix issue with the nu
> mber of units
 26. 
. * F_g_XX#d_sq_XX#S_g_het_XX
. gegen d_sq_group_XX=group(d_sq_XX)
 27. 
. //Define clusters for the SE in the predict_het in case the predict_het_hc2bm option is specified
. if "`cluster'" != ""{
 28.         local cluster_het `cluster'
 29. }
 30. if "`cluster'" == ""{
 31.         local cluster_het group_XX
 32. }
 33. //Define SE type according to if predict_het_hc2bm was specified or not
. if "`predict_het_hc2bm'" == ""{
 34.         local ses = "hc2"
 35. }
 36. if "`predict_het_hc2bm'" != ""{
 37.         local ses = "hc2 `cluster_het', dfadjust"
 38. } 
 39. 
. 
. // Run regression of interest
. local reg_failed_XX = 1
 40. if "`trends_nonparam'" == "" {
 41. capture reg prod_het_`i'_XX `predict_het_good' F_g_XX#d_sq_group_XX#S_g_XX [aw=N_gt_XX] if F_g_XX-1+`i'<=T
> _g_XX, level(`ci_level') vce(`ses')
 42. local reg_failed_XX = _rc
 43. }
 44. if "`trends_nonparam'" != "" {
 45. gegen trends_nonparam_temp_XX=group(`trends_nonparam')
 46. capture reg prod_het_`i'_XX `predict_het_good' F_g_XX#d_sq_group_XX#S_g_XX#trends_nonparam_temp_XX [aw=N_g
> t_XX] if F_g_XX-1+`i'<=T_g_XX, level(`ci_level') vce(`ses')
 47. local reg_failed_XX = _rc
 48. capture drop trends_nonparam_temp_XX
 49. }
 50. 
. // Retrieve the results from the regression only if it succeeded
. if `reg_failed_XX' == 0 {
 51. forvalues j=1/`:word count `predict_het_good''{
 52.         scalar beta_het_`j'_eff`i'_hat_XX=_b["`: word `j' of `predict_het_good''"]
 53.         scalar se_het_`j'_eff`i'_hat_XX=_se["`: word `j' of `predict_het_good''"]
 54.         scalar lb_het_`j'_eff`i'_hat_XX=_b["`: word `j' of `predict_het_good''"]+invt(e(N)-e(df_m)-1,0.025
> )*_se["`: word `j' of `predict_het_good''"]
 55.         scalar ub_het_`j'_eff`i'_hat_XX=_b["`: word `j' of `predict_het_good''"]+invt(e(N)-e(df_m)-1,0.975
> )*_se["`: word `j' of `predict_het_good''"]
 56.         scalar t_het_`j'_eff`i'_hat_XX=scalar(beta_het_`j'_eff`i'_hat_XX)/scalar(se_het_`j'_eff`i'_hat_XX)
 57. }
 58. scalar N_het_`i'_hat_XX=e(N)
 59. 
. // Add F-test on joint significance
. test `predict_het_good'
 60. scalar p_het_`i'_hat_XX=r(p)
 61. scalar F_het_`i'_hat_XX=r(F)
 62. }
 63. }
. }
. 
. // Output Part of the predict_het option
. 
. // Generate results matrix
. foreach i in `all_effects_XX'{
  2. matrix effect_het_`i'_XX=J(`:word count `predict_het_good'',6,.)
  3. 
. local effect_het_rownames_`i'_XX ""
  4. 
. forvalue j=1/`:word count `predict_het_good''{
  5. matrix effect_het_`i'_XX[`j',1]=scalar(beta_het_`j'_eff`i'_hat_XX)
  6. matrix effect_het_`i'_XX[`j',2]=scalar(se_het_`j'_eff`i'_hat_XX)
  7. matrix effect_het_`i'_XX[`j',3]=scalar(t_het_`j'_eff`i'_hat_XX)
  8. matrix effect_het_`i'_XX[`j',4]=scalar(lb_het_`j'_eff`i'_hat_XX)
  9. matrix effect_het_`i'_XX[`j',5]=scalar(ub_het_`j'_eff`i'_hat_XX)
 10. matrix effect_het_`i'_XX[`j',6]=scalar(N_het_`i'_hat_XX)
 11. 
. // Generate local with rownames
. local effect_het_rownames_`i'_XX "`effect_het_rownames_`i'_XX' "`: word `j' of `predict_het_good''""
 12. }
 13. 
. // Assign names
. matrix colnames effect_het_`i'_XX= "Estimate" "SE" "t" "LB CI" "UB CI" "N"
 14. matrix rownames effect_het_`i'_XX=`effect_het_rownames_`i'_XX'
 15. 
. }       
. 
. 
. // Output the table
. display _newline
. di "{hline 80}"
. di _skip(25) "{bf:Predicting effect heterogeneity}"
. if "`by'" !=""{
. * Add description with the by variable level if by is specified         
. di _skip(35) "{bf:By: `by' = `val_lab_int_XX'}"
. }       
. di "{hline 80}"
. 
. // output only the specified effects
. foreach i in `all_effects_XX'{
  2. display _newline
  3. di "{hline 80}" 
  4. di _skip(37) "{bf:Effect_`i'}"
  5. di "{hline 80}"
  6. matlist effect_het_`i'_XX
  7. di "{hline 80}"
  8. di as text "{it:Test of joint nullity of the estimates : p-value =} " p_het_`i'_hat_XX
  9. }
. 
. 
. 
. *****************************************************
. // Note: We need a step to ensure that we only do this for the number of pre peridos that are available in th
> e data -> For now just allow as mayn placebos as specified
. 
. // Note: we need to specify "all", correct that in the help file and fix the issue when we specify a numlist
. 
. if `=l_placebo_XX'>0{
. local all_effects_XX_dyn "`all_effects_XX'"
. qui{            
. if "`het_effects'"=="all"{
. local all_effects_XX "" 
. // Take all effects corresponding to the number of requested effect estimates
. forvalues i=1/`=l_placebo_XX'{
  2. local all_effects_XX "`all_effects_XX' `i'"
  3. }
. }
. 
. if "`het_effects'"!="all"{ 
. // allow to only show some effects specified in the option
. local all_effects_XX "`het_effects'"
. local test_eff_XX : subinstr local het_effects " " ",", all 
. local count_length_XX: word count `all_effects_XX'
. if `count_length_XX'==1{
.         local max_test_eff_XX=`test_eff_XX'
. }
. else{
. local max_test_eff_XX = max(`test_eff_XX')
. }
.         if `max_test_eff_XX'>`=l_placebo_XX'{
.         * error if specified effects not matching with those actually calculated        
.                 di as error ""
.                 di as error "You specified some numbers in predict_het that exceed the number of placebos pos
> sible to estimate!"
.                 di as error "Please specify only numbers that are smaller or equal to the number you request 
> in placebo()."
.                 di as input _continue ""
.                 exit
.         }
. }
. 
. local all_effects_XX_pl "`all_effects_XX'" // Modif Felix (delta_XX error)
. 
. foreach i in `all_effects_XX'{
  2. 
. // Modif Felix: Yg,Fg−1-ℓ
. gen Yg_Fg_pl_`i'_XX_temp=outcome_non_diff_XX if time_XX==F_g_XX-1-`i'
  3. bys group_XX: gegen Yg_Fg_pl_`i'_XX=mean(Yg_Fg_pl_`i'_XX_temp)
  4. capture drop Yg_Fg_pl_`i'_XX_temp
  5. 
. // Modif Felix: Now generate Sg*(Yg,Fg−1-ℓ − Yg,Fg−1) 
