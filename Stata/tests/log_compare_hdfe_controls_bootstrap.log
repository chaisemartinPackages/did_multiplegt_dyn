1781. di _skip(15) "{bf:Average cumulative (total) effect per treatment unit}"
1782. if "`by'" !=""{ 
1783. * Add description with the by variable level if by is specified
. di _skip(35) "{bf:By: `by' = `val_lab_int_XX'}"
1784. }
1785. if "$k"!=""{
1786.         local k=$k
1787.         local nb_obs_adj_XX = strlen("${path_`k'_XX}")
1788.         di _skip(`=42-`nb_obs_adj_XX'') "{bf:Path (${path_`k'_XX})}"
1789. }       
1790. di "{hline 80}"
1791. noisily matlist mat_res_avg_XX, nodotz
1792. di "{hline 80}"
1793. 
. ///// Preparing computation of average number of cumulated effects
> // Determine max number of effects by group
. qui{
1794. // unify delta_D_g_`i'_plus_XX and delta_D_g_`i'_minus_XX
. capture drop delta_D_g_1_XX - delta_D_g_`=l_XX'_XX
1795.         
. // generate M_g_XX, maximum number of estimable effects by group        
. capture drop var_l_XX_*
1796. gen var_l_XX_1=`=l_XX'
1797. gen var_l_XX_2=T_g_XX-F_g_XX+1
1798. gegen M_g_XX=min(var_l_XX_1 var_l_XX_2), by(group_XX)
1799. 
. // generate one variable that stores all the different delta_D_g_`i'_XX
. capture drop delta_D_g_XX
1800. 
. gen delta_D_g_XX=.
1801. forvalues j=1/`=l_XX'{
1802.         capture drop delta_D_g_`j'_XX
1803.         gen delta_D_g_`j'_XX=delta_D_g_`j'_plus_XX
1804.         replace delta_D_g_`j'_XX=delta_D_g_`j'_minus_XX if delta_D_g_`j'_XX==0 // Note delta_D_g_`j'_plus_XX/_minus_XX were initialliz
> ed with value 0
1805.         replace delta_D_g_`j'_XX=. if delta_D_g_`j'_XX==0 // does this matter? 
1806.         
.         // Replace the "general" variable with the corresponding delta_D for all effects included in the estimation
.         replace delta_D_g_XX=delta_D_g_`j'_XX if switcher_tag_XX==`j'   
1807. }
1808. 
. // Multiply by the corresponding L
. gen delta_D_g_num_XX=delta_D_g_XX*[(M_g_XX-(switcher_tag_XX-1))]
1809. 
. // take the total over periods and groups 
. gegen delta_D_num_total_XX=total(delta_D_g_num_XX)
1810. sum delta_D_num_total_XX
1811. local delta_D_num_total_XX=r(mean)
1812. 
. gegen delta_D_denom_total_XX=total(delta_D_g_XX)
1813. sum delta_D_denom_total_XX
1814. local delta_D_denom_total_XX=r(mean)
1815. }
1816. di as text "{it:Average number of time periods over which a treatment's effect is accumulated = }"  `delta_D_num_total_XX'/`delta_D_de
> nom_total_XX'
1817. 
. }
1818. 
