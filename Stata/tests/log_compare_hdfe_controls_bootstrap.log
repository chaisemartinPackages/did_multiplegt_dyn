. // Averaging the U_Gg\ell to compute DID_\ell
.  
. gegen DID_`i'_XX = total(U_Gg`i'_global_XX) 
1127. replace  DID_`i'_XX = DID_`i'_XX/G_XX
1128. scalar DID_`i'_XX = DID_`i'_XX
1129. 
. // Computing DID_n_l"  if the option was specified
. 
. if "`normalized'"!=""{
1130.         scalar DID_`i'_XX = scalar(DID_`i'_XX)/scalar(delta_D_`i'_global_XX)
1131. }
1132. 
. // Set DID_\ell missing when there is no switcher or no control
. 
. if ("`switchers'"==""&N1_`i'_XX_new==0&N0_`i'_XX_new==0)|("`switchers'"=="out"&N0_`i'_XX_new==0)|("`switchers'"=="in"&N1_`i'_XX_new==0){
1133.         scalar DID_`i'_XX=.
1134. }
1135. 
. // Store DID_\ell estimates in the ereturn and in the results matrix which will be printed out
. 
. ereturn scalar Effect_`i' = scalar(DID_`i'_XX)
1136. matrix mat_res_XX[`i',1]= scalar(DID_`i'_XX) 
1137. 
. }
1138. 
. ///// Computing the average total effect
> 
. // The average effect cannot be estimated when the trends_lin option is specified so the whole part will be skipped in that case
. 
. if "`trends_lin'"==""{
1139. 
. // Computing the weight w_+.
. 
. if "`switchers'"==""{
1140.         scalar w_plus_XX = U_Gg_den_plus_XX*sum_N1_l_XX/(U_Gg_den_plus_XX*sum_N1_l_XX+U_Gg_den_minus_XX*sum_N0_l_XX)
1141. }
1142. 
. * When the "switchers" option is used, full weight is put to either switchers out or in
. if "`switchers'"=="out"{
1143.         scalar w_plus_XX=0
1144. }
1145. 
. if "`switchers'"=="in"{
1146.         scalar w_plus_XX=1
1147. }
1148. 
. // Aggregating the U_{G,g} for switchers in and out
. 
. gen U_Gg_global_XX = w_plus_XX*U_Gg_plus_XX +(1-w_plus_XX)*U_Gg_minus_XX
1149. replace U_Gg_global_XX=. if first_obs_by_gp_XX==0
1150. 
. // Averaging the U_Gg to compute average total effect
. 
. gegen delta_XX = total(U_Gg_global_XX)
1151. replace delta_XX = delta_XX/G_XX
1152. scalar delta_XX = delta_XX
1153. ereturn scalar Av_tot_effect = scalar(delta_XX)
1154. 
. // Completing the results matrix
. 
. * Storing the results
. matrix mat_res_XX[l_XX+1,1]= scalar(delta_XX)
1155. local rownames "`rownames' Av_tot_eff" 
1156. * Number of switchers
. scalar N_switchers_effect_XX=0
1157. forvalue i=1/`=l_XX'{
1158.         scalar N_switchers_effect_XX = N_switchers_effect_XX + N_switchers_effect_`i'_XX
1159. }
1160. matrix mat_res_XX[l_XX+1,6]=N_switchers_effect_XX
1161. matrix mat_res_XX[l_XX+1,7]=0
1162. ereturn scalar N_switchers_effect_average = N_switchers_effect_XX
1163.  
. * Number of observations used in the estimation
. capture drop count_global_XX
1164. capture drop N_effect_XX
1165. gen count_global_XX=0
1166. forvalue i=1/`=l_XX'{
1167.         replace count_global_XX= max(count_global_XX, count`i'_global_XX)
1168. }
1169. sum count_global_XX
1170. scalar N_effect_XX=r(sum)
1171. matrix mat_res_XX[l_XX+1,5]=scalar(N_effect_XX)
1172. ereturn scalar N_avg_total_effect = scalar(N_effect_XX)
1173. 
. }
1174. 
. // Modif Felix weight
. if "`weight'"!=""{
1175.         scalar N_switchers_effect_XX_w=0
1176.         forvalue i=1/`=l_XX'{
1177.                 scalar N_switchers_effect_XX_w = N_switchers_effect_XX_w + N1_`i'_XX_weight+N0_`i'_XX_weight
1178.         }
1179.         
.         matrix mat_res_XX[l_XX+1,6]=N_switchers_effect_XX_w
1180.         ereturn scalar N_switchers_effect_average_w=N_switchers_effect_XX_w
1181.         
.         capture drop count_global_XX_w
1182.         capture drop N_effect_XX_w
1183.         gen count_global_XX_w=0
1184.         forvalue i=1/`=l_XX'{
1185.                 replace count_global_XX_w= max(count_global_XX_w, count`i'_global_XX_w)
1186.         }
1187.         
.         sum count_global_XX_w
1188.         scalar N_effect_XX_w=r(sum)
1189.         matrix mat_res_XX[l_XX+1,5]=scalar(N_effect_XX_w)
1190.         ereturn scalar N_avg_total_effect_w = scalar(N_effect_XX_w)
1191. }
1192. 
. // Add time_to_treat to the results matrix even when computation of average total effect skipped with trends_lin, important fot the graph 
> later.
. if "`trends_lin'"!=""{
1193.         local rownames "`rownames' Av_tot_eff" 
1194.         matrix mat_res_XX[l_XX+1,7]=0
1195. }
1196. 
. // Generate string local for sotable
. local str_effects "Effect_1"
1197. if l_XX > 1 {
1198.         forv j = 2/`=l_XX' {
1199.                 local str_effects "`str_effects' Effect_`j'"
1200.         }
1201. }
1202.         
. ///// Computing the placebo estimators (same steps as for the DID_\ell, not commented)
> 
. if l_placebo_XX!=0{
1203.         
.         // Create a local to store effects we cant estimate 
.         local missing_pl_XX ""
1204. 
. forvalue i=1/`=l_placebo_XX'{   
1205. 
. gen U_Gg_pl_`i'_global_XX = (N1_placebo_`i'_XX_new/(N1_placebo_`i'_XX_new+N0_placebo_`i'_XX_new))*U_Gg_pl_`i'_plus_XX  +(N0_placebo_`i'_XX
> _new/(N1_placebo_`i'_XX_new+N0_placebo_`i'_XX_new))*U_Gg_pl_`i'_minus_XX 
1206. replace U_Gg_pl_`i'_global_XX=. if first_obs_by_gp_XX==0
1207. 
. gen count`i'_pl_global_XX=max(count`i'_pl_plus_XX, count`i'_pl_minus_XX)
1208. 
. if "`normalized'"!=""{
1209.         scalar delta_D_pl_`i'_global_XX = (N1_placebo_`i'_XX_new/(N1_placebo_`i'_XX_new+N0_placebo_`i'_XX_new))*delta_D_pl_`i'_in_XX+(
> N0_placebo_`i'_XX_new/(N1_placebo_`i'_XX_new+N0_placebo_`i'_XX_new))*delta_D_pl_`i'_out_XX
1210. }
1211. 
. gegen DID_placebo_`i'_XX = total(U_Gg_pl_`i'_global_XX) 
1212. replace  DID_placebo_`i'_XX= DID_placebo_`i'_XX/G_XX
1213. scalar DID_placebo_`i'_XX = DID_placebo_`i'_XX
1214. 
. if "`normalized'"!=""{
1215.         scalar DID_placebo_`i'_XX = scalar(DID_placebo_`i'_XX)/scalar(delta_D_pl_`i'_global_XX)
1216. }
1217. 
. if ("`switchers'"==""&N1_placebo_`i'_XX_new==0&N0_placebo_`i'_XX_new==0)|("`switchers'"=="out"&N0_placebo_`i'_XX_new==0)|("`switchers'"=="
> in"&N1_placebo_`i'_XX_new==0){
1218.         scalar DID_placebo_`i'_XX=.
1219. }
1220. 
. ereturn scalar Placebo_`i' = scalar(DID_placebo_`i'_XX)
1221. 
. matrix mat_res_XX[`=l_XX'+ 1 + `i',1]=scalar(DID_placebo_`i'_XX)
1222. local rownames "`rownames' Placebo_`i'"
1223. 
. scalar N_switchers_placebo_`i'_XX=N1_placebo_`i'_XX_new+N0_placebo_`i'_XX_new
1224. matrix mat_res_XX[`=l_XX'+ 1 + `i',7]= `=-`i''
1225. ereturn scalar N_switchers_placebo_`i' = N_switchers_placebo_`i'_XX
1226. 
. gegen N_placebo_`i'_XX = total(count`i'_pl_global_XX)
1227. scalar N_placebo_`i'_XX = N_placebo_`i'_XX
1228. 
. if N_switchers_placebo_`i'_XX==0|N_placebo_`i'_XX==0{
1229.         di as error ""
1230.         di as error "Placebo_"`i' " cannot be estimated."
1231.         di as error "There is no switcher or no control"
1232.         di as error "for this placebo."
1233.         di as input _continue ""
1234.         
.         local missing_pl_XX `missing_pl_XX' `i'
1235. }
1236. if "`normalized'"!=""{
1237.         if (delta_D_pl_`i'_global_XX==0|delta_D_pl_`i'_global_XX==.){
1238.         di as error ""
1239.         di as error "Placebo_"`i' " cannot be estimated."
1240.         di as error "The denominator is missing for this normalized placebo."
1241.         di as input _continue ""
1242.         
.         local missing_pl_XX `missing_pl_XX' `i'
1243.         
.         scalar N_placebo_`i'_XX=0
1244.         scalar N_switchers_placebo_`i'_XX=0
1245.         }
1246. }
1247. 
. ereturn scalar N_placebo_`i' = N_placebo_`i'_XX
1248. matrix mat_res_XX[`=l_XX' + 1 + `i',5]=N_placebo_`i'_XX
1249. matrix mat_res_XX[`=l_XX'+ 1 + `i',6]=N_switchers_placebo_`i'_XX
1250. 
. // Modif Felix weight
. if "`weight'"!=""{
1251.         matrix mat_res_XX[`=l_XX'+ 1 + `i',6]=N1_`i'_pl_XX_weight+N0_`i'_pl_XX_weight
1252.         ereturn scalar N_switchers_placebo_`i'_w=N1_`i'_pl_XX_weight+N0_`i'_pl_XX_weight
1253.         
.         capture drop count`i'_pl_global_XX_w
1254.         capture drop N_placebo_`i'_XX_w
1255.         
.         gen count`i'_pl_global_XX_w=count`i'_pl_global_XX/weight_XX
1256.         gegen N_placebo_`i'_XX_w = total(count`i'_pl_global_XX_w) 
1257.         scalar N_placebo_`i'_XX_w = N_placebo_`i'_XX_w
1258.         ereturn scalar N_placebo_`i'_w = N_placebo_`i'_XX_w
1259.         matrix mat_res_XX[`=l_XX' + 1 + `i',5]=N_placebo_`i'_XX_w
1260. }
1261. 
. }
1262. 
. // Generate string local for sotable
. local str_placebo "Placebo_1"
1263. if l_placebo_XX > 1 {
1264.         forv j = 2/`=l_placebo_XX' {
1265.                 local str_placebo "`str_placebo' Placebo_`j'"
1266.         }
1267. }
1268. 
. }
1269. 
. //// Extract estimates vector (without avg_effect) for honestdid
> matrix didmgt_results_no_avg1_XX=J(`=l_XX',1,.)
1270. matrix didmgt_results_no_avg1_XX=mat_res_XX[1 .. `=l_XX',1]
1271. matrix didmgt_results_no_avg_XX = didmgt_results_no_avg1_XX
1272. 
. if `=l_placebo_XX'>0{
1273. matrix didmgt_results_no_avg2_XX=J(`=l_placebo_XX',1,.)
1274. matrix didmgt_results_no_avg2_XX=mat_res_XX[`=l_XX'+2 .. `=l_XX'+`=l_placebo_XX'+1,1]
1275. matrix didmgt_results_no_avg_XX = didmgt_results_no_avg1_XX \ didmgt_results_no_avg2_XX
1276. }
1277. 
. matrix didmgt_results_no_avg_XX=didmgt_results_no_avg_XX'
1278. 
. capture matrix drop didmgt_results_no_avg1_XX didmgt_results_no_avg2_XX
1279. 
. //// Add bootstrap 
> if `bootstrap_XX'!=0{
1280.         
.         // Save "pre-bootstraped" results matrix so it does not get overwritten 
.         matrix mat_res_bs_XX=mat_res_XX
1281.         
.         // Save "pre-bootstrap" data 
.         qui tempfile data_pre_bootstrap_XX
1282.         qui save "`data_pre_bootstrap_XX'.dta", replace
1283.         
.         // Load original data 
.         use "`data_bootstrap_XX'.dta", clear
1284.         
.         // gen numlists
.         numlist "1/`=l_XX'"
1285.         local num_eff_XX "`r(numlist)'"
1286.         // Adjust for missings
.         local num_eff_XX: list num_eff_XX- missing_eff_XX
1287.         
.         if `=l_placebo_XX'>0{
1288.         numlist "1/`=l_placebo_XX'"
1289.         local num_pl_XX "`r(numlist)'"
1290.         // Adjust for missings
.         local num_pl_XX: list num_pl_XX- missing_pl_XX
1291.         }
1292.         
.         //Store the coefficients to bootstrap
.         local coefs ""
1293.         foreach i of numlist `num_eff_XX'{
1294.                 local coefs = "`coefs' e(Effect_`i')"
1295.         }
1296.         
.         if `=l_placebo_XX'>0{
1297.         foreach i of numlist `num_pl_XX'{
1298.                 local coefs = "`coefs' e(Placebo_`i')"
1299.         }
1300.         }
1301.         
.         if "`trends_lin'"==""{
1302.         local coefs "`coefs' e(Av_tot_effect)"
1303.         }
1304.         
.         xtset, clear // need this to ensure bootstrap is running correctly
1305.         
.         // Save pre-bootstraped coefficients matrix for residualization (controls) and matrix for the actual coefficient matrix to be used
>  in the ereturn post
.         if "`hdfe_controls'" == "" {
1306.         foreach u of local levels_d_sq_XX {
1307.                 matrix coefs_sq_bs_`u'_XX = coefs_sq_`u'_XX
1308.         }
1309.         }
1310.         matrix didmgt_bs_results_no_avg_XX=didmgt_results_no_avg_XX // Modif Felix
1311.         
.         // Modif Felix: Ensure that we do not add missings in this process
.         gen existing_pre_XX=1
1312.         
.         // Save pre-bootstraped scalars 
.         mata: scalars_XX = st_dir("global", "numscalar", "*_XX")        
1313.         getmata (scalars_XX*) = scalars_XX, force                                       
1314.         // Fix this by counting the number of observations before and after we add all the scalars in and then delete the additional c
> ells we might add!!!                              
.         
.         levelsof(scalars_XX), local(scalars_save)
1315.         foreach w of local scalars_save {
1316.                 local k = subinstr("`w'","_XX","_XY",.)
1317.                 scalar `k' = `w'
1318.         }
1319.         capture drop scalars_XX* 
1320.         
.                 
.         // Modif Felix: Ensure that we do not add missings in this process
.         drop if existing_pre_XX==.
1321.         drop existing_pre_XX
1322.         
.         global bootstrap_on_XX "yes"
1323. 
.         * On the hdfe path, add idcluster so each cluster appearance in a
.         * resample gets a fresh ID. The recursive call combines _bs_id_XX
.         * with the user's group var to produce distinct unit IDs per clone,
.         * which keeps xtset / reghdfe well-defined inside reps. OLD path
.         * keeps no idcluster (bit-exact preservation of validated behavior).
.         local idcl_opt_XX ""
1324.         if "`hdfe_controls'" != "" {
1325.                 local idcl_opt_XX "idcluster(_bs_id_XX)"
1326.         }
1327. 
.         // Temporary diagnostic: noisily surfaces per-rep messages so we can see
.         // why reps are failing on the hdfe path. Remove `noisily` once the issue
.         // is identified.
.         // bootstrap the whole command
.         if "`cluster'"==""{
1328.                 noisily bootstrap "`coefs'", reps(`bootstrap_XX') cluster(`2') `seed_XX' `idcl_opt_XX': did_multiplegt_dyn `1' `2' `3'
>  `4', effects(`=l_XY') placebo(`=l_placebo_XY') `same_switchers' switchers(`switchers') `only_never_switchers' controls(`controls_bs_orig_
> XX') trends_nonparam(`trends_nonparam') weight(`weight') `dont_drop_larger_lower' `drop_if_d_miss_before_first_switch' `normalized' `same_
> switchers_pl' `trends_lin' continuous(`continuous') hdfe_controls(`hdfe_controls') graph_off
1329.         }
1330.         else if "`cluster'"!=""{
1331.                 noisily bootstrap "`coefs'", reps(`bootstrap_XX') cluster(`cluster') `seed_XX' `idcl_opt_XX': did_multiplegt_dyn `1' `
> 2' `3' `4', effects(`=l_XY') placebo(`=l_placebo_XY') `same_switchers' switchers(`switchers') `only_never_switchers' controls(`controls_bs
> _orig_XX') trends_nonparam(`trends_nonparam') weight(`weight') `dont_drop_larger_lower' `normalized' `same_switchers_pl' `drop_if_d_miss_b
> efore_first_switch' `trends_lin' continuous(`continuous') hdfe_controls(`hdfe_controls') graph_off
1332.         }
1333.         
.         //global bootstrap_on_XX ""
.         
.         // store bootstrap results matrix
.         matrix bs_out_XX=r(table)
1334.         matrix bs_var_cov_XX=e(V) // Modif Felix: also fetch var/cov Matrix
1335.         
.         
.         // Restore residualization matrix
.         if "`hdfe_controls'" == "" {
1336.         foreach u of local levels_d_sq_XX {
1337.                 matrix coefs_sq_`u'_XX = coefs_sq_bs_`u'_XX
1338.         }
1339.         }
1340.         matrix didmgt_results_no_avg_XX=didmgt_bs_results_no_avg_XX // Modif Felix
1341.         
.         // Restore scalars
.         mata: scalars_XY = st_dir("global", "numscalar", "*_XY")
1342.         getmata (scalars_XY*) = scalars_XY, force
1343.         levelsof(scalars_XY), local(scalars_save)
1344.         foreach w of local scalars_save {
1345.                 local k = subinstr("`w'","_XY","_XX",.)
1346.                 scalar `k' = `w'
1347.         }
1348.         capture drop scalars_XY*
1349.         
.         // row 1 to l_XX are the effects 
.         mat se_eff_bs_XX=J(`=l_XX',1,.)
1350.         local j=1 // local to find the correct row in the bootstrap output matrix
1351.         foreach k of numlist `num_eff_XX'{
1352.                 mat se_eff_bs_XX[`k',1]=bs_out_XX[2,`j']
1353.                 local j=`j'+1
1354.         }
1355.         
.         // row l_XX+1 to l_XX+l_placebo_XX are the placebos
.         if l_placebo_XX!=0{
1356.                 mat se_pl_bs_XX=J(`=l_placebo_XX',1,.)
1357.                 local for_count_2_XX=`=l_XX'+`=l_placebo_XX' // Felix: obsolete
1358.                 local for_count_3_XX=`=l_XX'+1 // Felix: obsolete
1359.                 foreach k of numlist `num_pl_XX'{
1360.                         mat se_pl_bs_XX[`k',1]=bs_out_XX[2,`j']
1361.                         local j=`j'+1
1362.                 }
1363.         }
1364.         
.         if "`trends_lin'"==""{
1365.         // row l_XX+l_placebo_XX+1 isvaverage cummulative (total) effect
.         mat se_avg_eff_bs_XX=bs_out_XX[2,`j']
1366.         }
1367.         
.         // Reload results matrix 
.         matrix mat_res_XX=mat_res_bs_XX
1368.         
.         // Reload the "pre-bootstrap" data 
.         use "`data_pre_bootstrap_XX'.dta", clear
1369. }
1370. global bootstrap_on_XX "" // Modif Felix
1371. 
. /////  Computing the variance of DID_\ell
> 
. // Loop over the number of effects to be estimated
. 
. forvalue i=1/`=l_XX'{
1372. 
. // Check that the effect can be estimated       
. 
. if ("`switchers'"==""&(N1_`i'_XX_new!=0|N0_`i'_XX_new!=0))|("`switchers'"=="out"&N0_`i'_XX_new!=0)|("`switchers'"=="in"&N1_`i'_XX_new!=0){
1373. 
. // Aggregating the U_Gg_var_\ell for switchers in and out
. 
. gen U_Gg_var_glob_`i'_XX = U_Gg_var_`i'_in_XX * (scalar(N1_`i'_XX_new)/(scalar(N1_`i'_XX_new)+scalar(N0_`i'_XX_new))) + U_Gg_var_`i'_out_X
> X* (scalar(N0_`i'_XX_new)/(scalar(N1_`i'_XX_new)+scalar(N0_`i'_XX_new)))
1374. 
. // Compute sigma_hat_2_l without clustering
. 
. if "`cluster'"==""{
1375.         gen U_Gg_var_glob_eff`i'_sqrd_XX = U_Gg_var_glob_`i'_XX^2*first_obs_by_gp_XX
1376. 
.         sum U_Gg_var_glob_eff`i'_sqrd_XX
1377.         scalar sum_for_var_`i'_XX=r(sum)/G_XX^2
1378. }
1379. 
. // Compute sigma_hat_2_l with clustering: sum U_Gg_var_l within a cluster, and then take average of square. 
. 
. if "`cluster'"!=""{
1380.         
.         capture drop clust_U_Gg_var_glob_`i'_XX
1381.         capture drop clust_U_Gg_var_glob_`i'_2_XX
1382.         
.         replace U_Gg_var_glob_`i'_XX = U_Gg_var_glob_`i'_XX*first_obs_by_gp_XX
1383.         
.         * Sum within cluster
.         bys `cluster' : gegen clust_U_Gg_var_glob_`i'_XX = total(U_Gg_var_glob_`i'_XX)
1384.         
.         * Compute average of square
.         gen clust_U_Gg_var_glob_`i'_2_XX=clust_U_Gg_var_glob_`i'_XX^2*first_obs_by_clust_XX
1385.         
.         sum clust_U_Gg_var_glob_`i'_2_XX
1386.         scalar sum_for_var_`i'_XX=r(sum)/G_XX^2
1387.         
.         replace U_Gg_var_glob_`i'_XX = clust_U_Gg_var_glob_`i'_XX
1388.         
. }
1389. 
. // Compute SE
. scalar se_`i'_XX = sqrt(sum_for_var_`i'_XX)
1390. 
. // Normalize SE if normalized option was specified
. if "`normalized'"!=""{
1391.         scalar se_`i'_XX = scalar(se_`i'_XX)/scalar(delta_D_`i'_global_XX)
1392. }
1393. 
. // Adapting the se scalars with the bootstrap
. if `bootstrap_XX'!=0{
1394.         scalar se_`i'_XX=se_eff_bs_XX[`i',1]
1395. }
1396. 
. // Storing the results
. 
. * SE
. matrix mat_res_XX[`i',2]=scalar(se_`i'_XX)
1397. ereturn scalar se_effect_`i'=scalar(se_`i'_XX)
1398. 
. * ci_level
. scalar ci_level = `ci_level'/100
1399. scalar z_level = invnormal(scalar(ci_level) + (1-scalar(ci_level))/2)
1400.         
. * Lower bound of the confidence interval
. scalar LB_CI_`i'_XX = scalar(DID_`i'_XX) - scalar(z_level)*scalar(se_`i'_XX)
1401. matrix mat_res_XX[`i',3]= scalar(LB_CI_`i'_XX)
1402. 
. * Upper bound of the confidence interval
. scalar UB_CI_`i'_XX = scalar(DID_`i'_XX) + scalar(z_level)*scalar(se_`i'_XX)
1403. matrix mat_res_XX[`i',4]=scalar(UB_CI_`i'_XX)
1404. 
. }
1405. }
1406. 
. 
. /////  Computing the variances of the placebo estimators (same steps as for the DID_\ell, not commented)
> 
. if l_placebo_XX!=0{
1407. 
. forvalue i=1/`=l_placebo_XX'{
1408. if ("`switchers'"==""&(N1_placebo_`i'_XX_new!=0|N0_placebo_`i'_XX_new!=0))|("`switchers'"=="out"&N0_placebo_`i'_XX_new!=0)|("`switcher
> s'"=="in"&N1_placebo_`i'_XX_new!=0){ 
1409. 
