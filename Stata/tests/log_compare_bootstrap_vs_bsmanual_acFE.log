207. bys group_XX: gegen m`=increase_XX'_`l'_`count_controls'_`i'_XX=total(m`=increase_XX'_g_`count_controls'_`
> l'_`i'_XX)
208. bys group_XX: replace m`=increase_XX'_`l'_`count_controls'_`i'_XX = . if _n != 1
209. 
