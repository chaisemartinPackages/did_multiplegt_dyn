. if ("`switchers'"=="in"&(L_u_XX==.|L_u_XX==0))|("`switchers'"=="out"&(L_a_XX==.|L_a_XX==0))|("`switchers'"==""&(L_u_XX==.|L_u_XX==0)&(L_a_
> XX==.|L_a_XX==0)){
679.         di as error ""
680.         di as error "No treatment effect can be estimated. This is because Design Restriction 1 in de Chaisemartin & D'Haultfoeuille (2
> 024) is not satisfied in the data, given the options requested. This may be due to the fact that groups' period-one treatment is continuou
> s, or takes a large number of values, and you have not specified the continuous option. If so, you can try to specify this option. If the 
> issue persists even with this option, this means that all groups experience their first treatment change at the same date, a situation whe
> re the estimators of de Chaisemartin & D'Haultfoeuille (2024) cannot be used."
681.         di as input _continue ""
682.                 
.         exit
683. }
684. 
. // Checking that the number of dynamic and placebo effects requested by user
. // are feasible, and correcting them if they are not. 
. 
. if "`switchers'"==""{
685. scalar l_XX=max(L_a_XX, L_u_XX)
686. scalar l_XX=min(l_XX, `effects')
687. 
. if `placebo'!=0{
688. scalar l_placebo_XX=max(L_placebo_a_XX, L_placebo_u_XX)
689. scalar l_placebo_XX=min(l_placebo_XX, `placebo')
690. // The number of placebos computed cannot be greater than the number of effects computed:
. scalar l_placebo_XX=min(l_placebo_XX, `effects')
691. }
692. else{
693. scalar l_placebo_XX=0
694. }
695. }
696. 
. if "`switchers'"=="in"{
