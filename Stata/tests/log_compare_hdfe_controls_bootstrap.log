331. bys group_XX: gegen min_time_y_nonmiss_XX=min(time_y_nonmiss_XX)
332. 
. // G's first date when D missing after Y has been not missing
. 
. capture drop time_d_miss_XX
333. capture drop min_time_d_miss_aft_ynm_XX
334. gen time_d_miss_XX=time_XX if treatment_XX==.&time_XX>=min_time_y_nonmiss_XX
335. bys group_XX: gegen min_time_d_miss_aft_ynm_XX=min(time_d_miss_XX)
336. drop time_d_nonmiss_XX time_y_nonmiss_XX time_d_miss_XX 
337. 
. ///// Creating baseline treatment
> ///// D_{g,1} in paper, redefined to account for imbalanced panels: 
> ///// g's treatment at first period where g's treatment non missing
> 
. gen d_sq_XX_temp=treatment_XX if time_XX==min_time_d_nonmiss_XX
338. bys group_XX: gegen d_sq_XX=mean(d_sq_XX_temp)
339. drop d_sq_XX_temp 
340. 
. ///// Enforcing Design Restriction 2 in the paper.
> ///// If the option dont_drop_larger_lower was not specified, 
> ///// drop (g,t) cells such that at t, g has experienced both a strictly lower 
> ///// and a strictly higher treatment than its baseline treatment.
> 
. gen diff_from_sq_XX=(treatment_XX-d_sq_XX)
341. 
. if "`dont_drop_larger_lower'"==""{              
342.         sort group_XX time_XX
343.         gen ever_strict_increase_XX=(diff_from_sq_XX>0&treatment_XX!=.) 
344.         replace ever_strict_increase_XX=1 if ever_strict_increase_XX[_n-1]==1&group_XX==group_XX[_n-1]
345. 
.         gen ever_strict_decrease_XX=(diff_from_sq_XX<0&treatment_XX!=.) 
346.         replace ever_strict_decrease_XX=1 if ever_strict_decrease_XX[_n-1]==1&group_XX==group_XX[_n-1]
347. 
.         drop if ever_strict_increase_XX==1 & ever_strict_decrease_XX==1
348.         
.         drop ever_strict_increase_XX ever_strict_decrease_XX
349.                 
. }
350. 
. ///// Sort data
> sort group_XX time_XX
351. 
. ///// Counting number of groups
> //sum group_XX
. //scalar G_XX=r(max)
. 
. ///// Ever changed treatment
> gen ever_change_d_XX=(abs(diff_from_sq_XX)>0&treatment_XX!=.)
352. replace ever_change_d_XX=1 if ever_change_d_XX[_n-1]==1&group_XX==group_XX[_n-1]
353. 
. ///// Creating date of first treatment change
> sort group_XX time_XX
354. gen temp_F_g_XX=time_XX if ever_change_d_XX==1&ever_change_d_XX[_n-1]==0 
355. replace temp_F_g_XX=0 if temp_F_g_XX==.
