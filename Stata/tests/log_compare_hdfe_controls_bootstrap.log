1196.         scalar N_placebo_`i'_XX_w = N_placebo_`i'_XX_w
1197.         ereturn scalar N_placebo_`i'_w = N_placebo_`i'_XX_w
1198.         matrix mat_res_XX[`=l_XX' + 1 + `i',5]=N_placebo_`i'_XX_w
1199. }
1200. 
. }
1201. 
. // Generate string local for sotable
. local str_placebo "Placebo_1"
