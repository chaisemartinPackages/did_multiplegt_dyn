1298.         }
1299. }
1300. 
. }
1301. 
. //// Extract estimates vector (without avg_effect) for honestdid
> matrix didmgt_results_no_avg1_XX=J(`=l_XX',1,.)
1302. matrix didmgt_results_no_avg1_XX=mat_res_XX[1 .. `=l_XX',1]
1303. matrix didmgt_results_no_avg_XX = didmgt_results_no_avg1_XX
