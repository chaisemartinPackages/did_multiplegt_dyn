1230.         }
1231.         
.         //Store the coefficients to bootstrap
.         local coefs ""
1232.         foreach i of numlist `num_eff_XX'{
1233.                 local coefs = "`coefs' e(Effect_`i')"
1234.         }
1235.         
.         if `=l_placebo_XX'>0{
1236.         foreach i of numlist `num_pl_XX'{
1237.                 local coefs = "`coefs' e(Placebo_`i')"
1238.         }
1239.         }
1240.         
.         if "`trends_lin'"==""{
1241.         local coefs "`coefs' e(Av_tot_effect)"
1242.         }
1243.         
.         xtset, clear // need this to ensure bootstrap is running correctly
1244.         
.         // Save pre-bootstraped coefficients matrix for residualization (controls) and matrix for the actual coefficient matrix to be used
>  in the ereturn post 
.         foreach u of local levels_d_sq_XX {
1245.                 matrix coefs_sq_bs_`u'_XX = coefs_sq_`u'_XX
1246.         }
1247.         matrix didmgt_bs_results_no_avg_XX=didmgt_results_no_avg_XX // Modif Felix
1248.         
.         // Modif Felix: Ensure that we do not add missings in this process
.         gen existing_pre_XX=1
1249.         
.         // Save pre-bootstraped scalars 
.         mata: scalars_XX = st_dir("global", "numscalar", "*_XX")        
1250.         getmata (scalars_XX*) = scalars_XX, force                                       
1251.         // Fix this by counting the number of observations before and after we add all the scalars in and then delete the additional c
> ells we might add!!!                              
.         
.         levelsof(scalars_XX), local(scalars_save)
1252.         foreach w of local scalars_save {
1253.                 local k = subinstr("`w'","_XX","_XY",.)
1254.                 scalar `k' = `w'
1255.         }
1256.         capture drop scalars_XX* 
1257.         
.                 
.         // Modif Felix: Ensure that we do not add missings in this process
.         drop if existing_pre_XX==.
1258.         drop existing_pre_XX
1259.         
.         global bootstrap_on_XX "yes"
1260.         
.         // bootstrap the whole command
.         if "`cluster'"==""{
1261.                 bootstrap "`coefs'", reps(`bootstrap_XX') cluster(`2') `seed_XX': did_multiplegt_dyn `1' `2' `3' `4', effects(`=l_XY')
>  placebo(`=l_placebo_XY') `same_switchers' switchers(`switchers') `only_never_switchers' controls(`controls_bs_orig_XX') trends_nonparam(`
> trends_nonparam') weight(`weight') `dont_drop_larger_lower' `drop_if_d_miss_before_first_switch' `normalized' `same_switchers_pl' `trends_
> lin' continuous(`continuous') graph_off
1262.         }
1263.         else if "`cluster'"!=""{
1264.                 bootstrap "`coefs'", reps(`bootstrap_XX') cluster(`cluster') `seed_XX': did_multiplegt_dyn `1' `2' `3' `4', effects(`=
> l_XY') placebo(`=l_placebo_XY') `same_switchers' switchers(`switchers') `only_never_switchers' controls(`controls_bs_orig_XX') trends_nonp
> aram(`trends_nonparam') weight(`weight') `dont_drop_larger_lower' `normalized' `same_switchers_pl' `drop_if_d_miss_before_first_switch' `t
> rends_lin' continuous(`continuous') graph_off
1265.         }
1266.         
.         //global bootstrap_on_XX ""
.         
.         // store bootstrap results matrix
.         matrix bs_out_XX=r(table)
1267.         matrix bs_var_cov_XX=e(V) // Modif Felix: also fetch var/cov Matrix
1268.         
.         
.         // Restore residualization matrix 
.         foreach u of local levels_d_sq_XX {
1269.                 matrix coefs_sq_`u'_XX = coefs_sq_bs_`u'_XX
1270.         }
1271.         matrix didmgt_results_no_avg_XX=didmgt_bs_results_no_avg_XX // Modif Felix
1272.         
.         // Restore scalars
.         mata: scalars_XY = st_dir("global", "numscalar", "*_XY")
1273.         getmata (scalars_XY*) = scalars_XY, force
1274.         levelsof(scalars_XY), local(scalars_save)
1275.         foreach w of local scalars_save {
1276.                 local k = subinstr("`w'","_XY","_XX",.)
1277.                 scalar `k' = `w'
1278.         }
1279.         capture drop scalars_XY*
1280.         
.         // row 1 to l_XX are the effects 
.         mat se_eff_bs_XX=J(`=l_XX',1,.)
1281.         local j=1 // local to find the correct row in the bootstrap output matrix
1282.         foreach k of numlist `num_eff_XX'{
1283.                 mat se_eff_bs_XX[`k',1]=bs_out_XX[2,`j']
1284.                 local j=`j'+1
1285.         }
1286.         
.         // row l_XX+1 to l_XX+l_placebo_XX are the placebos
.         if l_placebo_XX!=0{
1287.                 mat se_pl_bs_XX=J(`=l_placebo_XX',1,.)
1288.                 local for_count_2_XX=`=l_XX'+`=l_placebo_XX' // Felix: obsolete
1289.                 local for_count_3_XX=`=l_XX'+1 // Felix: obsolete
1290.                 foreach k of numlist `num_pl_XX'{
1291.                         mat se_pl_bs_XX[`k',1]=bs_out_XX[2,`j']
1292.                         local j=`j'+1
1293.                 }
1294.         }
1295.         
.         if "`trends_lin'"==""{
1296.         // row l_XX+l_placebo_XX+1 isvaverage cummulative (total) effect
.         mat se_avg_eff_bs_XX=bs_out_XX[2,`j']
1297.         }
1298.         
.         // Reload results matrix 
.         matrix mat_res_XX=mat_res_bs_XX
1299.         
.         // Reload the "pre-bootstrap" data 
