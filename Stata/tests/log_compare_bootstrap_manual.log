1017. scalar L_a_XX_tag = min(L_a_XX, `effects')
1018. 
. // For switchers in
. if ("`switchers'"==""|"`switchers'"=="in"){
1019. if L_u_XX!=.&L_u_XX!=0{
1020. 
. ***** MODIF FELIX: Replaced all the weights by weight(weight_XX) instead of weight(`weight') due to the fact that `weights' does not exist
>  anymore after collapsing
. 
. * Perform the estimation of effects and placebos outside of the loop on 
. * number of effects if trends_lin not specified
. if "`trends_lin'"==""{
1021.         did_multiplegt_dyn_core_new outcome_XX group_XX time_XX treatment_XX, effects(`=l_XX') placebo(`=l_placebo_XX') switchers_core
> (in) `only_never_switchers' controls(`controls') trends_nonparam(`trends_nonparam') `normalized' `same_switchers' `same_switchers_pl' cont
> inuous(`continuous') `less_conservative_se' weight(weight_XX) cluster(`cluster') hdfe_controls(`hdfe_controls')
1022. 
.         // Store the number of the event-study effect for switchers-in
.                 forv k = 1/`=L_u_XX_tag' {
1023.                         replace switcher_tag_XX = `k' if distance_to_switch_`k'_XX == 1
1024.                 }
1025. }       
1026.         
. forvalue i=1/`=l_XX'{
1027. 
. * Perform the estimation of effects inside of the loop on number of effects 
. * if trends_lin is specified
. * Note that if the option trends_lin was specified, same_switchers must also be specified.
. if "`trends_lin'"!=""{
1028.         did_multiplegt_dyn_core_new outcome_XX group_XX time_XX treatment_XX, effects(`i') switchers_core(in) `only_never_switchers' c
> ontrols(`controls') trends_nonparam(`trends_nonparam') `normalized' same_switchers  trends_lin continuous(`continuous') `less_conservative
> _se' weight(weight_XX) cluster(`cluster') hdfe_controls(`hdfe_controls')
1029. 
.         // Store the number of the event-study effect for switchers-in
.         replace switcher_tag_XX = `i' if distance_to_switch_`i'_XX == 1
1030.         }
1031. * Store variables necessary for computation of effects.
. * N.B.: in the case of unbalanced panels, it can happen that the U_Gg`i'_XX are not computed by program 2 (for example when y is missing).
>  Consequently, for the command not to display an error message and continue running, we need to verify the variable is created, which is c
> onditional on  N1_`i'_XX!=0.
. if N1_`i'_XX!=0{
1032.                 replace U_Gg`i'_plus_XX = U_Gg`i'_XX
1033.                 replace count`i'_plus_XX= count`i'_core_XX
1034.                 replace U_Gg_var_`i'_in_XX=U_Gg`i'_var_XX
1035.                 scalar N1_`i'_XX_new=N1_`i'_XX
1036. 
.                 if "`normalized'"!=""{
1037.                         scalar delta_D_`i'_in_XX = delta_norm_`i'_XX
1038.                 }
1039.                 
.                 if "`trends_lin'"==""{
1040.                         replace delta_D_g_`i'_plus_XX = delta_D_g_`i'_XX
1041.                 }
1042.         }
1043. }
1044. 
. *Same as above, for placebos.
. if l_placebo_XX!=0{
1045. 
.         forvalue i=1/`=l_placebo_XX'{
1046.                 
.                 if "`trends_lin'"!=""{
1047.         did_multiplegt_dyn_core_new outcome_XX group_XX time_XX treatment_XX, effects(`i') placebo(`i') switchers_core(in) `only_never
> _switchers' controls(`controls') trends_nonparam(`trends_nonparam') `normalized' same_switchers same_switchers_pl trends_lin continuous(`c
> ontinuous') `less_conservative_se' weight(weight_XX) cluster(`cluster') hdfe_controls(`hdfe_controls')
1048. }
1049.                                 
.                 if N1_placebo_`i'_XX!=0{
1050.                                 replace U_Gg_pl_`i'_plus_XX  = U_Gg_placebo_`i'_XX
1051.                                 replace count`i'_pl_plus_XX= count`i'_pl_core_XX
1052.                                 replace U_Gg_var_pl_`i'_in_XX=U_Gg_pl_`i'_var_XX
1053.                                 scalar N1_placebo_`i'_XX_new=N1_placebo_`i'_XX
1054.                                 
.                                 if "`normalized'"!=""{
1055.                                         scalar delta_D_pl_`i'_in_XX = delta_norm_pl_`i'_XX
1056.                                 }
1057. 
.                 }
1058.                 
.         }       
1059. }
1060. 
. * Store variables necessary for computation of average effect.
.         if "`trends_lin'"==""{
1061.         if sum_N1_l_XX!=0{
1062.         replace U_Gg_plus_XX = U_Gg_XX
1063.         scalar U_Gg_den_plus_XX=U_Gg_den_XX
1064.         replace U_Gg_var_plus_XX = U_Gg_var_XX
1065.         }
1066.         }
1067. 
. }
1068.         
. } // end of the condition for switchers in
1069. 
. // Same thing as above, for switchers out
. 
. if ("`switchers'"==""|"`switchers'"=="out"){
1070. if L_a_XX!=.&L_a_XX!=0{
1071.         
. if "`trends_lin'"==""{  
1072. did_multiplegt_dyn_core_new outcome_XX group_XX time_XX treatment_XX, effects(`=l_XX') placebo(`=l_placebo_XX') switchers_core(out) `o
> nly_never_switchers' controls(`controls')  trends_nonparam(`trends_nonparam') `normalized' `same_switchers' `same_switchers_pl' continuous
> (`continuous') `less_conservative_se' weight(weight_XX) cluster(`cluster') hdfe_controls(`hdfe_controls')
1073. 
.         // Store the number of the event-study effect for switchers-out
.                 forv k = 1/`=L_a_XX_tag' {
1074.                         replace switcher_tag_XX = `k' if distance_to_switch_`k'_XX == 1
1075.                 }
1076. 
. }
1077.         
. forvalue i=1/`=l_XX'{
1078.         
. if "`trends_lin'"!=""{  
1079.         did_multiplegt_dyn_core_new outcome_XX group_XX time_XX treatment_XX, effects(`i') switchers_core(out) `only_never_switchers' 
> controls(`controls') trends_nonparam(`trends_nonparam') `normalized' same_switchers trends_lin continuous(`continuous') `less_conservative
> _se' weight(weight_XX) cluster(`cluster') hdfe_controls(`hdfe_controls')
1080. 
.         // Store the number of the event-study effect for switchers-out
.         replace switcher_tag_XX = `i' if distance_to_switch_`i'_XX == 1
1081. }
1082.         
. if N0_`i'_XX!=0{
1083.                 replace U_Gg`i'_minus_XX = - U_Gg`i'_XX
1084.                 replace count`i'_minus_XX= count`i'_core_XX
1085.                 //// CHANGE BELOW - tks (add minus sign)
>                 replace U_Gg_var_`i'_out_XX= - U_Gg`i'_var_XX
1086.                 scalar N0_`i'_XX_new=N0_`i'_XX
1087.                 
.                 if "`normalized'"!=""{
1088.                         scalar delta_D_`i'_out_XX = delta_norm_`i'_XX
1089.                 }
1090.                 
.                 if "`trends_lin'"==""{
1091.                 replace delta_D_g_`i'_minus_XX = delta_D_g_`i'_XX
1092.                 }
1093.         }
1094.         
. }
1095. 
. 
. if l_placebo_XX!=0{
1096. 
.         forvalue i=1/`=l_placebo_XX'{
1097.                 
. if "`trends_lin'"!=""{  
1098.         did_multiplegt_dyn_core_new outcome_XX group_XX time_XX treatment_XX, effects(`i') placebo(`i') switchers_core(out) `only_neve
> r_switchers' controls(`controls') trends_nonparam(`trends_nonparam') `normalized' same_switchers same_switchers_pl trends_lin continuous(`
> continuous') `less_conservative_se' weight(weight_XX) cluster(`cluster') hdfe_controls(`hdfe_controls')
1099. }
1100.                 
.         if N0_placebo_`i'_XX!=0{
1101.                         replace U_Gg_pl_`i'_minus_XX  = -U_Gg_placebo_`i'_XX
1102.                         replace count`i'_pl_minus_XX= count`i'_pl_core_XX
1103.                         //// CHANGE BELOW - tks (add minus sign)
>                         replace U_Gg_var_pl_`i'_out_XX= - U_Gg_pl_`i'_var_XX 
1104.                         scalar N0_placebo_`i'_XX_new=N0_placebo_`i'_XX
1105.                         
.                         if "`normalized'"!=""{
1106.                                         scalar delta_D_pl_`i'_out_XX = delta_norm_pl_`i'_XX
1107.         }
1108. 
.         }
1109.         }               
1110. }
1111. 
.         if "`trends_lin'"==""{
1112.         if sum_N0_l_XX!=0{
1113.         replace U_Gg_minus_XX = - U_Gg_XX
1114.         scalar U_Gg_den_minus_XX=U_Gg_den_XX
1115.         replace U_Gg_var_minus_XX = - U_Gg_var_XX
1116.         }
1117.         }
1118. 
. }
1119.         
. } // end of the loop for switchers out 
1120. 
. scalar drop L_u_XX_tag L_a_XX_tag
1121. 
. ////////// 5. Computing the estimators and their variances
> 
. /////  Computing DID_\ell
> 
. // Creation of the matrix which stores all the estimators (DID_l, DID_pl, delta, etc.), their sd and the CIs
. 
. matrix mat_res_XX = J(l_XX+l_placebo_XX+1,7,.) 
1122. 
. // Loop over the number of effects to be estimated
. 
.         // Create a local to store effects we cant estimate 
.         local missing_eff_XX "" 
1123. 
. forvalue i=1/`=l_XX'{
1124. 
. // Aggregating the U_(g,l) for switchers in and out
.         
. gen U_Gg`i'_global_XX = (N1_`i'_XX_new/(N1_`i'_XX_new+N0_`i'_XX_new))*U_Gg`i'_plus_XX +(N0_`i'_XX_new/(N1_`i'_XX_new+N0_`i'_XX_new))*U_Gg`
> i'_minus_XX
1125. replace U_Gg`i'_global_XX=. if first_obs_by_gp_XX==0
1126. 
. gen count`i'_global_XX = max(count`i'_plus_XX, count`i'_minus_XX)
1127. 
. // Computing aggregated delta_D (difference between treatments received wrt status quo, from F_g-1 to F_g-1+\ell), only needed for the nor
> malized estimator 
.         if "`normalized'"!=""{
1128.         scalar delta_D_`i'_global_XX = (N1_`i'_XX_new/(N1_`i'_XX_new+N0_`i'_XX_new))*delta_D_`i'_in_XX+(N0_`i'_XX_new/(N1_`i'_XX_new+N
> 0_`i'_XX_new))*delta_D_`i'_out_XX
1129.         }
1130. 
. // Storing the results and the number of switchers into the matrix mat_res_XX
. local rownames "`rownames' Effect_`i'"
1131. 
. // Counting number of switchers DID_\ell applies to
. 
. scalar N_switchers_effect_`i'_XX=N1_`i'_XX_new+N0_`i'_XX_new
1132. matrix mat_res_XX[`i',6]=N_switchers_effect_`i'_XX
1133. matrix mat_res_XX[`i',7]=`i'
1134. ereturn scalar N_switchers_effect_`i' = N_switchers_effect_`i'_XX
1135. 
. // Counting number of observations used in the computation of DID_\ell
. 
. gegen N_effect_`i'_XX = total(count`i'_global_XX) 
1136. scalar N_effect_`i'_XX = N_effect_`i'_XX
1137. ereturn scalar N_effect_`i' = N_effect_`i'_XX
1138. matrix mat_res_XX[`i',5]=N_effect_`i'_XX
1139. 
. // Modif Felix weight -> Display correct N with weights
. if "`weight'"!=""{
1140.         matrix mat_res_XX[`i',6]=N1_`i'_XX_weight+N0_`i'_XX_weight
1141.         ereturn scalar N_switchers_effect_`i'_w= N1_`i'_XX_weight+N0_`i'_XX_weight
1142. 
.         capture drop count`i'_global_XX_w
1143.         capture drop N_effect_`i'_XX_w
1144.         
.         gen count`i'_global_XX_w=count`i'_global_XX/weight_XX
1145.         gegen N_effect_`i'_XX_w = total(count`i'_global_XX_w) 
1146.         scalar N_effect_`i'_XX_w = N_effect_`i'_XX_w
1147.         ereturn scalar N_effect_`i'_w = N_effect_`i'_XX_w
1148.         matrix mat_res_XX[`i',5]=N_effect_`i'_XX_w
1149. }
1150. 
. // Error message if DID_\ell cannot be estimated
. 
. if N_switchers_effect_`i'_XX==0|N_effect_`i'_XX==0{
1151.         di as error ""
1152.         di as error "Effect_"`i' " cannot be estimated."
1153.         di as error "There is no switcher or no control"
1154.         di as error "for this effect."
1155.         di as input _continue ""
1156.         
.         local missing_eff_XX `missing_eff_XX' `i'
1157. }
1158. 
. // Averaging the U_Gg\ell to compute DID_\ell
.  
. gegen DID_`i'_XX = total(U_Gg`i'_global_XX) 
1159. replace  DID_`i'_XX = DID_`i'_XX/G_XX
1160. scalar DID_`i'_XX = DID_`i'_XX
1161. 
. // Computing DID_n_l"  if the option was specified
. 
. if "`normalized'"!=""{
1162.         scalar DID_`i'_XX = scalar(DID_`i'_XX)/scalar(delta_D_`i'_global_XX)
1163. }
1164. 
. // Set DID_\ell missing when there is no switcher or no control
. 
. if ("`switchers'"==""&N1_`i'_XX_new==0&N0_`i'_XX_new==0)|("`switchers'"=="out"&N0_`i'_XX_new==0)|("`switchers'"=="in"&N1_`i'_XX_new==0){
1165.         scalar DID_`i'_XX=.
1166. }
1167. 
. // Store DID_\ell estimates in the ereturn and in the results matrix which will be printed out
. 
. ereturn scalar Effect_`i' = scalar(DID_`i'_XX)
1168. matrix mat_res_XX[`i',1]= scalar(DID_`i'_XX) 
1169. 
. }
1170. 
. ///// Computing the average total effect
> 
. // The average effect cannot be estimated when the trends_lin option is specified so the whole part will be skipped in that case
. 
. if "`trends_lin'"==""{
1171. 
. // Computing the weight w_+.
. 
. if "`switchers'"==""{
1172.         scalar w_plus_XX = U_Gg_den_plus_XX*sum_N1_l_XX/(U_Gg_den_plus_XX*sum_N1_l_XX+U_Gg_den_minus_XX*sum_N0_l_XX)
1173. }
1174. 
. * When the "switchers" option is used, full weight is put to either switchers out or in
. if "`switchers'"=="out"{
1175.         scalar w_plus_XX=0
1176. }
1177. 
. if "`switchers'"=="in"{
1178.         scalar w_plus_XX=1
1179. }
1180. 
. // Aggregating the U_{G,g} for switchers in and out
. 
. gen U_Gg_global_XX = w_plus_XX*U_Gg_plus_XX +(1-w_plus_XX)*U_Gg_minus_XX
1181. replace U_Gg_global_XX=. if first_obs_by_gp_XX==0
1182. 
. // Averaging the U_Gg to compute average total effect
. 
. gegen delta_XX = total(U_Gg_global_XX)
1183. replace delta_XX = delta_XX/G_XX
1184. scalar delta_XX = delta_XX
1185. ereturn scalar Av_tot_effect = scalar(delta_XX)
1186. 
. // Completing the results matrix
. 
. * Storing the results
. matrix mat_res_XX[l_XX+1,1]= scalar(delta_XX)
1187. local rownames "`rownames' Av_tot_eff" 
1188. * Number of switchers
. scalar N_switchers_effect_XX=0
1189. forvalue i=1/`=l_XX'{
1190.         scalar N_switchers_effect_XX = N_switchers_effect_XX + N_switchers_effect_`i'_XX
1191. }
1192. matrix mat_res_XX[l_XX+1,6]=N_switchers_effect_XX
1193. matrix mat_res_XX[l_XX+1,7]=0
1194. ereturn scalar N_switchers_effect_average = N_switchers_effect_XX
1195.  
. * Number of observations used in the estimation
. capture drop count_global_XX
1196. capture drop N_effect_XX
1197. gen count_global_XX=0
1198. forvalue i=1/`=l_XX'{
1199.         replace count_global_XX= max(count_global_XX, count`i'_global_XX)
1200. }
1201. sum count_global_XX
1202. scalar N_effect_XX=r(sum)
1203. matrix mat_res_XX[l_XX+1,5]=scalar(N_effect_XX)
1204. ereturn scalar N_avg_total_effect = scalar(N_effect_XX)
1205. 
. }
1206. 
. // Modif Felix weight
. if "`weight'"!=""{
1207.         scalar N_switchers_effect_XX_w=0
1208.         forvalue i=1/`=l_XX'{
1209.                 scalar N_switchers_effect_XX_w = N_switchers_effect_XX_w + N1_`i'_XX_weight+N0_`i'_XX_weight
1210.         }
1211.         
.         matrix mat_res_XX[l_XX+1,6]=N_switchers_effect_XX_w
1212.         ereturn scalar N_switchers_effect_average_w=N_switchers_effect_XX_w
1213.         
.         capture drop count_global_XX_w
1214.         capture drop N_effect_XX_w
1215.         gen count_global_XX_w=0
1216.         forvalue i=1/`=l_XX'{
1217.                 replace count_global_XX_w= max(count_global_XX_w, count`i'_global_XX_w)
1218.         }
1219.         
.         sum count_global_XX_w
1220.         scalar N_effect_XX_w=r(sum)
1221.         matrix mat_res_XX[l_XX+1,5]=scalar(N_effect_XX_w)
1222.         ereturn scalar N_avg_total_effect_w = scalar(N_effect_XX_w)
1223. }
1224. 
. // Add time_to_treat to the results matrix even when computation of average total effect skipped with trends_lin, important fot the graph 
> later.
. if "`trends_lin'"!=""{
1225.         local rownames "`rownames' Av_tot_eff" 
1226.         matrix mat_res_XX[l_XX+1,7]=0
1227. }
1228. 
. // Generate string local for sotable
. local str_effects "Effect_1"
1229. if l_XX > 1 {
1230.         forv j = 2/`=l_XX' {
1231.                 local str_effects "`str_effects' Effect_`j'"
1232.         }
1233. }
1234.         
. ///// Computing the placebo estimators (same steps as for the DID_\ell, not commented)
> 
. if l_placebo_XX!=0{
1235.         
.         // Create a local to store effects we cant estimate 
.         local missing_pl_XX ""
1236. 
. forvalue i=1/`=l_placebo_XX'{   
1237. 
. gen U_Gg_pl_`i'_global_XX = (N1_placebo_`i'_XX_new/(N1_placebo_`i'_XX_new+N0_placebo_`i'_XX_new))*U_Gg_pl_`i'_plus_XX  +(N0_placebo_`i'_XX
> _new/(N1_placebo_`i'_XX_new+N0_placebo_`i'_XX_new))*U_Gg_pl_`i'_minus_XX 
1238. replace U_Gg_pl_`i'_global_XX=. if first_obs_by_gp_XX==0
1239. 
. gen count`i'_pl_global_XX=max(count`i'_pl_plus_XX, count`i'_pl_minus_XX)
1240. 
. if "`normalized'"!=""{
1241.         scalar delta_D_pl_`i'_global_XX = (N1_placebo_`i'_XX_new/(N1_placebo_`i'_XX_new+N0_placebo_`i'_XX_new))*delta_D_pl_`i'_in_XX+(
> N0_placebo_`i'_XX_new/(N1_placebo_`i'_XX_new+N0_placebo_`i'_XX_new))*delta_D_pl_`i'_out_XX
1242. }
1243. 
. gegen DID_placebo_`i'_XX = total(U_Gg_pl_`i'_global_XX) 
1244. replace  DID_placebo_`i'_XX= DID_placebo_`i'_XX/G_XX
1245. scalar DID_placebo_`i'_XX = DID_placebo_`i'_XX
1246. 
. if "`normalized'"!=""{
1247.         scalar DID_placebo_`i'_XX = scalar(DID_placebo_`i'_XX)/scalar(delta_D_pl_`i'_global_XX)
1248. }
1249. 
. if ("`switchers'"==""&N1_placebo_`i'_XX_new==0&N0_placebo_`i'_XX_new==0)|("`switchers'"=="out"&N0_placebo_`i'_XX_new==0)|("`switchers'"=="
> in"&N1_placebo_`i'_XX_new==0){
1250.         scalar DID_placebo_`i'_XX=.
1251. }
1252. 
. ereturn scalar Placebo_`i' = scalar(DID_placebo_`i'_XX)
1253. 
. matrix mat_res_XX[`=l_XX'+ 1 + `i',1]=scalar(DID_placebo_`i'_XX)
