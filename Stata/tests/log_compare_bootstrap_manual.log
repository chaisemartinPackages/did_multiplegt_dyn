. local hdfe_absorb_XX "group_XX `hdfe_controls'"
683. if "`trends_nonparam'" != "" {
684.     capture drop trends_nonparam_temp_XX
685.     gegen trends_nonparam_temp_XX = group(`trends_nonparam')
686.     local hdfe_absorb_XX "`hdfe_absorb_XX' i.time_XX#i.trends_nonparam_temp_XX"
687. }
688. else {
689.     local hdfe_absorb_XX "`hdfe_absorb_XX' time_XX"
690. }
691. 
. foreach l of local levels_d_sq_XX {
692. 
.     capture drop yhat_lvl_`l'_XX
693.     capture drop E_y_hat_gt_int_`l'_XX
694.     scalar store_singular_`l'_XX = 0
695. 
.     tab F_g_XX if d_sq_int_XX==`l'
696.     scalar useful_res_`l'_XX = `r(r)'
697. 
.     if (scalar(useful_res_`l'_XX)>1) {
698.         * fit on the not-yet-switched same-D_g,1 sample (mirrors line 1030 keep)
.         cap reghdfe Y_level_XX `controls' [aw=N_gt_XX] ///
>             if ever_change_d_XX==0 & fd_X_all_non_missing_XX==1 ///
>                & d_sq_int_XX==`l' & time_XX < F_g_XX, ///
>             absorb(`hdfe_absorb_XX')
699.         if _rc != 0 {
700.             scalar store_singular_`l'_XX = 1
701.             local store_noresidualization_XX "`store_noresidualization_XX' `l'"
702.             scalar useful_res_`l'_XX = 1
703.         }
704.         else {
705.             * default predict: includes absorbed FE contribution. Predict on every
.             * obs so that long-diffs `yhat_lvl - L`i'.yhat_lvl` are defined past F_g.
.             predict yhat_lvl_`l'_XX
706.             local levels_d_sq_XX_final "`levels_d_sq_XX_final' `l'"
707.             * Placeholder so downstream `gen E_y_hat_gt_`l'_XX = E_y_hat_gt_int_`l'_XX * ...`
.             * doesn't error. Only fed into in_sum_temp (analytical SE), which is gated.
.             gen double E_y_hat_gt_int_`l'_XX = 0 if d_sq_int_XX==`l' & time_XX < F_g_XX
708.         }
709.     }
710.     else {
711.         capture drop trends_nonparam_temp_XX
712.         drop if d_sq_int_XX == `l'
713.         noi di "Baseline Treatment Level `l' dropped because of insufficient observations."
714.     }
715. }
716. capture drop trends_nonparam_temp_XX
717. 
. }
718. 
. //Fill up store_singular_XX, with correct values of statu quo and not the levels -> Modif Felix
. levelsof d_sq_XX, local(levels_d_sq_bis_XX)
719. scalar index_sing_XX = 0
720. foreach l of local levels_d_sq_bis_XX {
721.         scalar index_sing_XX = scalar(index_sing_XX)+1
722.         capture confirm scalar store_singular_`=index_sing_XX'_XX
723.         if _rc==0{
724.                 if(scalar(store_singular_`=index_sing_XX'_XX) == 1){
725.                 local store_singular_XX = "`store_singular_XX' `l'"
726.                 }
727.         }
728. }
729. 
. ///// Display errors if one of the Den_d^{-1} is not defined
> if ("`store_singular_XX'"!=""){
