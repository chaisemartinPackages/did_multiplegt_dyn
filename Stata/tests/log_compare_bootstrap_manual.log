1474.         getmata (scalars_XY*) = scalars_XY, force
1475.         levelsof(scalars_XY), local(scalars_save)
1476.         foreach w of local scalars_save {
1477.                 local k = subinstr("`w'","_XY","_XX",.)
1478.                 scalar `k' = `w'
1479.         }
1480.         capture drop scalars_XY*
1481.         
.         // row 1 to l_XX are the effects 
.         mat se_eff_bs_XX=J(`=l_XX',1,.)
1482.         local j=1 // local to find the correct row in the bootstrap output matrix
1483.         foreach k of numlist `num_eff_XX'{
1484.                 mat se_eff_bs_XX[`k',1]=bs_out_XX[2,`j']
1485.                 local j=`j'+1
1486.         }
1487.         
.         // row l_XX+1 to l_XX+l_placebo_XX are the placebos
.         if l_placebo_XX!=0{
1488.                 mat se_pl_bs_XX=J(`=l_placebo_XX',1,.)
1489.                 local for_count_2_XX=`=l_XX'+`=l_placebo_XX' // Felix: obsolete
1490.                 local for_count_3_XX=`=l_XX'+1 // Felix: obsolete
1491.                 foreach k of numlist `num_pl_XX'{
1492.                         mat se_pl_bs_XX[`k',1]=bs_out_XX[2,`j']
1493.                         local j=`j'+1
1494.                 }
1495.         }
1496.         
.         if "`trends_lin'"==""{
1497.         // row l_XX+l_placebo_XX+1 isvaverage cummulative (total) effect
.         mat se_avg_eff_bs_XX=bs_out_XX[2,`j']
1498.         }
1499.         
.         // Reload results matrix 
.         matrix mat_res_XX=mat_res_bs_XX
1500.         
.         // Reload the "pre-bootstrap" data 
.         use "`data_pre_bootstrap_XX'.dta", clear
1501. }
1502. global bootstrap_on_XX "" // Modif Felix
1503. 
. /////  Computing the variance of DID_\ell
> 
. // Loop over the number of effects to be estimated
. 
. forvalue i=1/`=l_XX'{
1504. 
. // Check that the effect can be estimated       
. 
. if ("`switchers'"==""&(N1_`i'_XX_new!=0|N0_`i'_XX_new!=0))|("`switchers'"=="out"&N0_`i'_XX_new!=0)|("`switchers'"=="in"&N1_`i'_XX_new!=0){
1505. 
. // Aggregating the U_Gg_var_\ell for switchers in and out
. 
. gen U_Gg_var_glob_`i'_XX = U_Gg_var_`i'_in_XX * (scalar(N1_`i'_XX_new)/(scalar(N1_`i'_XX_new)+scalar(N0_`i'_XX_new))) + U_Gg_var_`i'_out_X
> X* (scalar(N0_`i'_XX_new)/(scalar(N1_`i'_XX_new)+scalar(N0_`i'_XX_new)))
1506. 
. // Compute sigma_hat_2_l without clustering
. 
. if "`cluster'"==""{
1507.         gen U_Gg_var_glob_eff`i'_sqrd_XX = U_Gg_var_glob_`i'_XX^2*first_obs_by_gp_XX
1508. 
.         sum U_Gg_var_glob_eff`i'_sqrd_XX
1509.         scalar sum_for_var_`i'_XX=r(sum)/G_XX^2
1510. }
1511. 
. // Compute sigma_hat_2_l with clustering: sum U_Gg_var_l within a cluster, and then take average of square. 
. 
. if "`cluster'"!=""{
1512.         
.         capture drop clust_U_Gg_var_glob_`i'_XX
1513.         capture drop clust_U_Gg_var_glob_`i'_2_XX
1514.         
.         replace U_Gg_var_glob_`i'_XX = U_Gg_var_glob_`i'_XX*first_obs_by_gp_XX
1515.         
.         * Sum within cluster
.         bys `cluster' : gegen clust_U_Gg_var_glob_`i'_XX = total(U_Gg_var_glob_`i'_XX)
1516.         
.         * Compute average of square
.         gen clust_U_Gg_var_glob_`i'_2_XX=clust_U_Gg_var_glob_`i'_XX^2*first_obs_by_clust_XX
1517.         
.         sum clust_U_Gg_var_glob_`i'_2_XX
1518.         scalar sum_for_var_`i'_XX=r(sum)/G_XX^2
1519.         
.         replace U_Gg_var_glob_`i'_XX = clust_U_Gg_var_glob_`i'_XX
1520.         
. }
1521. 
. // Compute SE
. scalar se_`i'_XX = sqrt(sum_for_var_`i'_XX)
1522. 
. // Normalize SE if normalized option was specified
. if "`normalized'"!=""{
1523.         scalar se_`i'_XX = scalar(se_`i'_XX)/scalar(delta_D_`i'_global_XX)
1524. }
1525. 
. // Adapting the se scalars with the bootstrap
. if `bootstrap_XX'!=0{
1526.         scalar se_`i'_XX=se_eff_bs_XX[`i',1]
1527. }
1528. 
. // Storing the results
. 
. * SE
. matrix mat_res_XX[`i',2]=scalar(se_`i'_XX)
1529. ereturn scalar se_effect_`i'=scalar(se_`i'_XX)
1530. 
. * ci_level
. scalar ci_level = `ci_level'/100
