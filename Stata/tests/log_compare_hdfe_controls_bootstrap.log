1059.         di as error "Effect_"`i' " cannot be estimated."
1060.         di as error "There is no switcher or no control"
1061.         di as error "for this effect."
1062.         di as input _continue ""
1063.         
.         local missing_eff_XX `missing_eff_XX' `i'
1064. }
1065. 
. // Averaging the U_Gg\ell to compute DID_\ell
.  
. gegen DID_`i'_XX = total(U_Gg`i'_global_XX) 
1066. replace  DID_`i'_XX = DID_`i'_XX/G_XX
1067. scalar DID_`i'_XX = DID_`i'_XX
1068. 
. // Computing DID_n_l"  if the option was specified
. 
. if "`normalized'"!=""{
1069.         scalar DID_`i'_XX = scalar(DID_`i'_XX)/scalar(delta_D_`i'_global_XX)
1070. }
1071. 
. // Set DID_\ell missing when there is no switcher or no control
. 
. if ("`switchers'"==""&N1_`i'_XX_new==0&N0_`i'_XX_new==0)|("`switchers'"=="out"&N0_`i'_XX_new==0)|("`switchers'"=="in"&N1_`i'_XX_new==0){
1072.         scalar DID_`i'_XX=.
1073. }
1074. 
