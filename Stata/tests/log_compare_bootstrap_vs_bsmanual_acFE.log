768.         di ""
769.         di as error "You specified a number that exceeds the number of treatment paths in the by_path() option! The number of paths is 
> automatically set to the number of treatment paths in the sample."
770.         di as input _continue ""
771.         
.         local by_path=`num_paths_XX'
772. }
773. 
. // count number of groups within each path and sort the numbers accordingly in ascending order (1 -> most, 2 -> second most etc...)
. if `by_path'<`num_paths_XX'{
774. gen count_path_XX=. 
775. forvalues k=1/`num_paths_XX'{
776.         count if different_paths_XX==`k'&first_obs_by_gp_XX==1 // important to count each group just once in case of unbalanced panel!
777.         replace count_path_XX=r(N) if different_paths_XX==`k' 
778. }
779. 
. gegen rank_paths_XX=group(-count_path_XX different_paths_XX) if count_path_XX!=.
780. replace different_paths_XX=rank_paths_XX
781. }
782. 
. 
. // prevent \ell to be overwritten, should be checked each repetition again 
.         scalar l_XX_orig=scalar(l_XX)
783.         scalar l_placebo_XX_orig=scalar(l_placebo_XX)
784. 
. // create dummies which state for which path you can act as control depending on the same F_g-1 and not having switched (yet) at F_g_XX-1+
> l_XX
. global graph_by_path ""
785. forvalues k=1/`by_path'{
786.         sum d_sq_XX if different_paths_XX==`k'
787.         local path_d_sq_XX=r(mean)
788.         sum F_g_XX if different_paths_XX==`k'
789.         local path_min_Fg_XX=r(min)
