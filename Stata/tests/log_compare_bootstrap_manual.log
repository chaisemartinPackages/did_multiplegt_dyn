1256. matrix mat_res_XX[`=l_XX'+ 1 + `i',7]= `=-`i''
1257. ereturn scalar N_switchers_placebo_`i' = N_switchers_placebo_`i'_XX
1258. 
. gegen N_placebo_`i'_XX = total(count`i'_pl_global_XX)
1259. scalar N_placebo_`i'_XX = N_placebo_`i'_XX
1260. 
. if N_switchers_placebo_`i'_XX==0|N_placebo_`i'_XX==0{
1261.         di as error ""
1262.         di as error "Placebo_"`i' " cannot be estimated."
1263.         di as error "There is no switcher or no control"
1264.         di as error "for this placebo."
