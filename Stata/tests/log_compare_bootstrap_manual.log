994.         
.         
.         scalar N0_placebo_`i'_XX_new=0
995.         scalar N1_placebo_`i'_XX_new=0
996.         
.         if "`weight'"!=""{
997.                 scalar N0_`i'_pl_XX_weight=0
998.                 scalar N1_`i'_pl_XX_weight=0
999.         }
1000.         
.         if "`normalized'"!=""{
1001.                 scalar delta_D_pl_`i'_in_XX = 0
1002.                 scalar delta_D_pl_`i'_out_XX = 0
1003.         }
1004.         
. }
1005. }
