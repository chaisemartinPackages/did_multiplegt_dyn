. ///// Performing a test that all DID_\ell effects are equal (similar structure as test on placebos, not commented, except for the small di
> fferences with placebos)
> // scalar all_Ns_not_zero=. // Modif Felix: this scalar is already initalized above and would now be overwritten when it should not be  
. //      effects_equal(string)
. 
. local ee_called = 0
1610. 
. // Check and Extract Lower and Upper Bound from the Option
. if ("`effects_equal'")!="" & l_XX>1{
1611.         
.         * when all is not specified 
.         if "`effects_equal'" != "all"{ 
1612.                 
.                 * Exit when option wrongly called without separator
.                 if strpos("`effects_equal'", ",") == 0 {
1613.                         di as error "Syntax error in effects_equal option"
1614.                         di as error "Comma required"
1615.                         di as input _continue ""
1616.                         exit
1617.                 }
1618.                 
.                 * Extract lower and upper bounds of interest 
.                 local ee_lb = strtrim(substr("`effects_equal'", 1, strpos("`effects_equal'", ",") - 1))
1619.                 local ee_ub = strtrim(substr("`effects_equal'", strpos("`effects_equal'", ",") + 1, .))
1620.                 
.                                 * Exit when option wrongly call with non-integer inputs
.                 capture confirm integer number `ee_lb'
1621.                 if _rc{
1622.                 di ""   
1623.                 di as error "The input of the effects_equal() option has to be a positive integer in the range of estimated effects."
1624.                 di as input _continue ""
1625.                 exit
1626.                 }
1627.                 capture confirm integer number `ee_ub'
1628.                 if _rc{
1629.                 di ""   
1630.                 di as error "The input of the effects_equal() option has to be a positive integer in the range of estimated effects."
1631.                 di as input _continue ""
1632.                 exit
1633.                 }
1634.         
.                 * Exit if lower and upper bounds do not make sense
.                 if `ee_ub' <= `ee_lb' | `ee_lb' < 1 | `ee_ub' > l_XX{
1635.                         di as error "Syntax error in effect_equal option: The bounds specifed are out of range."
1636.                         exit
1637.                 }
1638.         }
1639.         
.         * when all is specified: default range
.         else{
1640.                 local ee_lb = 1
1641.                 local ee_ub = l_XX
1642.         }
1643.         
.         
.         * when effects_equal effectively called
.         local ee_called = 1
1644. }
1645. 
. // When option correctly called 
. if `ee_called' == 1 & l_XX>1 {  
1646. 
.         scalar all_Ns_not_zero_equal_test=0
1647.         
.         // Check how many periods of effects have sufficient observations for the test to proceed.      
.         forvalue i=`ee_lb'/`ee_ub'{
1648.                 if ("`switchers'"==""&(N1_`i'_XX_new!=0|N0_`i'_XX_new!=0))|("`switchers'"=="out"&N0_`i'_XX_new!=0)|("`switchers'"=="in
> "&N1_`i'_XX_new!=0){
1649.                         scalar all_Ns_not_zero_equal_test=all_Ns_not_zero_equal_test+1 
1650.                         }
1651.         }
1652.         
. 
.         * track num of periods of interest
.         local length=`ee_ub'-`ee_lb'+1
1653.         
.         * when all periods of interest have sufficient obs 
.         
.         
.         if all_Ns_not_zero_equal_test==`length'{
1654.                 
.                 
.                 * Extract the first column of rows up to l_xx, hold DID_\ell to be tested for equality. 
.                 matrix didmgt_Effects = mat_res_XX[`ee_lb'..`ee_ub', 1]
1655.                 * Initialize the variance-covariance matrix for the effects of l_XX size. 
.                 matrix didmgt_Var_Effects=J(`length', `length', 0)
1656.                 * Create a partial identity matrix. 
.                 matrix didmgt_identity = J(`=`length'-1', `length',0 )  
1657.                 
.                 * loop over each dyn effects of interest
.                 
.                 forvalue i=`ee_lb'/`ee_ub'{
1658.                 
.                         * condition on sufficient obs for this dyn effect
.                         if ("`switchers'"==""&(N1_`i'_XX_new!=0|N0_`i'_XX_new!=0))|("`switchers'"=="out"&N0_`i'_XX_new!=0)|("`switchers'"=
> ="in"&N1_`i'_XX_new!=0){
1659.                                 
.                                 * Location tracking in the sub matrices j:submatrix, i:full matrix. 
.                                 local j=`i'-`ee_lb'+1
1660.                                 
.                                 * Update diagonal elements of didmgt_Var Effects
.                                 matrix didmgt_Var_Effects[`j',`j']=scalar(se_`i'_XX)^2
1661.                                 * Update diagonal element of the identity matrix for matrix of demeaned effects
.                                 if `i' < `ee_ub'{
1662.                                         matrix didmgt_identity[`j',`j']=1
1663.                                 }
1664.                                 
.                                 * Update the variance-covariance matrix of selected effects
.                                 if `i' < `ee_ub'{
1665. 
.                                         /* Nested loop iterate over rest periods to be paired with i from i+1 to upper bound */
.                                         forvalue k=`=`i'+1'/`=`ee_ub''{ 
1666.                                                 
.                                                 * Location tracking in the sub matrices s:submatrix, k:full matrix. 
.                                                 local s=`k'-`ee_lb'+1
1667.                                                 
.                                                 capture drop U_Gg_var_`i'_`k'_XX
1668.                                                 capture drop U_Gg_var_`i'_`k'_2_XX      
1669.                                                 
.                                                 if ("`normalized'"==""){
1670.                                                         gen U_Gg_var_`i'_`k'_XX = U_Gg_var_glob_`i'_XX+ U_Gg_var_glob_`k'_XX
1671.                                                 }
1672.                                                 if "`normalized'"!=""{
1673.                                                         gen U_Gg_var_`i'_`k'_XX = U_Gg_var_glob_`i'_XX/scalar(delta_D_`i'_global_XX) +
>  U_Gg_var_glob_`k'_XX/scalar(delta_D_`k'_global_XX)
1674.                                                 }
1675.                                                 
.                                                 gen U_Gg_var_`i'_`k'_2_XX = U_Gg_var_`i'_`k'_XX^2*first_obs_by_gp_XX
1676. 
.                                                 sum U_Gg_var_`i'_`k'_2_XX
1677.                                                 scalar var_sum_`i'_`k'_XX=r(sum)/G_XX^2
1678.                                                 scalar cov_`i'_`k'_XX = (scalar(var_sum_`i'_`k'_XX) - scalar(se_`i'_XX)^2 - scalar(se_
> `k'_XX)^2)/2
1679.                                                         
.                                                 * Update covariance of i,k pair in submatrix
.                                                 matrix didmgt_Var_Effects[`j',`s']= scalar(cov_`i'_`k'_XX)
1680.                                                 matrix didmgt_Var_Effects[`s',`j']= scalar(cov_`i'_`k'_XX)
1681.                                                 
.                                         }
1682.                                 /* End nested loop */ 
.                                 }
1683.                                 }
1684.                                 }
1685.                                 
.                                 
.                 if `bootstrap_XX'!=0{
1686.                         matrix didmgt_Var_Effects=bs_var_cov_XX["_bs_1".."_bs_`=l_XX'","_bs_1".."_bs_`=l_XX'"]
1687.                         matrix didmgt_Var_Effects = didmgt_Var_Effects[`ee_lb'..`ee_ub', `ee_lb'..`ee_ub']
1688.                         }       
1689. 
. 
.                         /* Just subsetting everything */                        
.                         //matrix didmgt_D = (1+1/(`=`length'-1')) * didmgt_identity - J(`=`length'-1', `=`length'', 1/(`=`length'-1'))
.                         matrix didmgt_D = didmgt_identity - J(`=`length'-1', `=`length'', 1/(`=`length''))
1690.                         * Demeaned effect matrix vector
.                         matrix didmgt_test_effects = didmgt_D * didmgt_Effects
1691.                         * Variance Covariance matrix of demeaned effects
.                         matrix didmgt_test_var = didmgt_D * didmgt_Var_Effects * didmgt_D'
1692.                         * Enforcing symmetry
.                         matrix didmgt_test_var = (didmgt_test_var + didmgt_test_var') / 2 
1693.                         matrix didmgt_test_var_inv = invsym(didmgt_test_var)
1694.                         matrix didmgt_test_effects_t = didmgt_test_effects'
1695.                         
.                         * chi-squared statistics : effectstranspose * (Variance)^(-1)* effects
.                         matrix didmgt_chi2_equal_ef = didmgt_test_effects_t * didmgt_test_var_inv * didmgt_test_effects
1696.                         
.                         
.         *Modif David 05_02_2026: check that matrix has full rank before performing the test:
.         * Check rank of didmgt_Var_effects, since they are the estimators used for the equality of effects test
.         if (warning_eff != .) {
1697.                         scalar p_equality_effects = 1 - chi2(`=`length'-1', didmgt_chi2_equal_ef[1, 1])  
1698.                         ereturn scalar p_equality_effects = 1 - chi2(`=`length'-1', didmgt_chi2_equal_ef[1, 1]) 
1699.                 }
1700.         if (warning_eff == .){
1701.                 scalar p_equality_effects=.
1702.                 ereturn scalar p_equality_effects=.
1703.                 }       
1704.                 
.                 }
1705.                 else{
1706.                 di as error ""
1707.                 di as error "Some effects could not be estimated. Therefore, the test of equality of the effects could not be computed
> ."
1708.                 di as input _continue ""
1709.         }
1710. }
1711.         }
