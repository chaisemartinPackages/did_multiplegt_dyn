> n! The number of paths is automatically set to the number of treatment paths in the sample."
.         di as input _continue ""
.         
.         local by_path=`num_paths_XX'
. }
. 
. // count number of groups within each path and sort the numbers accordingly in ascending order (1 -> most, 2 
> -> second most etc...)
. if `by_path'<`num_paths_XX'{
. gen count_path_XX=. 
. forvalues k=1/`num_paths_XX'{
  2.         count if different_paths_XX==`k'&first_obs_by_gp_XX==1 // important to count each group just once 
> in case of unbalanced panel!
  3.         replace count_path_XX=r(N) if different_paths_XX==`k' 
  4. }
. 
. gegen rank_paths_XX=group(-count_path_XX different_paths_XX) if count_path_XX!=.
. replace different_paths_XX=rank_paths_XX
. }
. 
