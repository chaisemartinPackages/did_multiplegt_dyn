. ///// Option that shows a table with weights attached to each normalized effect
> if "`normalized_weights'" != "" {
2217.         qui {
2218.                 // Error as normalized_weights only works in combination with normalized
.                 if "`normalized'" == "" {
2219.                         noi di as err "normalized option required to compute normalized_weights"
2220.                         di as input _continue ""
2221.                         exit
2222.                 }
2223. 
.         // Set up the matrix for the output table
.         mat define weight_mat = J(`=l_XX + 1', `=l_XX', .)
2224.         local cols ""
2225. 
.         forv i = 1/`=l_XX'{     
2226.                 local m = "ℓ=`i'"
2227.                 local cols `cols' `m'
2228.                 gen N_gt_`i'_temp_XX = N_gt_XX if time_XX == F_g_XX - 1 + `i' & `i' <= L_g_XX & N_gt_control_`i'_XX > 0 & N_gt_control
> _`i'_XX != . & diff_y_`i'_XX != .
2229.                 gegen N_gt_`i'_XX = mean(N_gt_`i'_temp_XX), by(group_XX)
2230.                 drop N_gt_`i'_temp_XX
2231.                 forv k = 0/`=`i' - 1' {
2232.                         // Visualization by k
.                         local row = `k' + 1
2233.                         
.                         // Compute the delta_ℓ_k, if the continuous option is specified the original treatment values are used
.                         if `continuous'==0{
2234.                         gen delta_`i'_`k' = abs(treatment_XX - d_sq_XX) if time_XX == F_g_XX - 1 + `i' - `k' & F_g_XX - 1 + `i' <= T_g
> _XX
2235.                         }
2236.                         else if `continuous'>0{
2237.                         gen delta_`i'_`k' = abs(treatment_XX_orig - d_sq_XX_orig) if time_XX == F_g_XX - 1 + `i' - `k' & F_g_XX - 1 + 
> `i' <= T_g_XX
2238.                         }
2239.                         replace delta_`i'_`k' = delta_`i'_`k' * N_gt_`i'_XX
2240.                         // Filling the weight matrix 
.                         sum delta_`i'_`k'
2241.                         mat weight_mat[`row', `i'] = (`r(sum)' / scalar(delta_D_`i'_global_XX)) / scalar(N_switchers_effect_`i'_XX)
2242.                         //mat weight_mat[`row', `i'] = (`r(sum)' / `denom_`i'_norm_XX')
.                 }               
2243.                 drop N_gt_`i'_XX
2244.         }
2245.         
.         // Generating the row names 
.         // Visualization by k 
.         local rows ""
2246.         forv j = 1/`=l_XX' {
2247.                         local r = "k=`=`j'-1'"
2248.                         local rows `rows' `r'
2249.         }       
2250. 
.         local rows `rows' "Total"
2251.         
.         // Fill the values for the displayed table
.         matrix define mat_temp = J(`=l_XX', `=l_XX', 0) 
2252.         forv i = 1/`=l_XX' {
2253.                 forv j = 1/`=l_XX' {
2254.                         if weight_mat[`i', `j'] != . {
2255.                                 mat mat_temp[`i', `j'] = weight_mat[`i', `j']
2256.                         }
2257.                 }
2258.         }       
2259.         
.         // Getting the correct order
.         matrix define mat_total = mat_temp' * J(`=l_XX', 1, 1)
2260.         forv i = 1/`=l_XX' {
2261.                 mat weight_mat[`=l_XX+1', `i'] = mat_total[`i', 1]
2262.         }
2263.         
.         // Add row and column names
.         mat rown weight_mat = `rows'
2264.         mat coln weight_mat = `cols'    
2265.         }
2266. 
.         // Output the table
.         display _newline
2267.         di "{hline 70}"
2268.         di _skip(15) "{bf:Weights on treatment lags}"
2269.         if "`by'" !=""{ 
2270.         * Add description with the by variable level if by is specified 
.         di _skip(25) "{bf:By: `by' = `val_lab_int_XX'}"
2271.         }       
2272.         di "{hline 70}"
2273.         matlist weight_mat, format(%9.4fc) lines(rowtotal)
2274.         display _newline                
2275. }
