266.                 bys d_sq_XX `trends_nonparam' time_XX: gegen dof_cohort_`i'_ns_t_XX = nunique(cluster_dof_`i'_ns_XX) if !missing(cluste
> r_dof_`i'_ns_XX)
267.         }
268. }
